186   4198 32 0A C1             ld (table), a           ; 14
187   419B 0F                   rrca                    ;  5
188   419C 0F                   rrca                    ;  5  $06 or $07, R#2's
189   419D D3 99                out (VDP_CTRL), a       ; 12
190   419F 3E 82                ld a, $80 | 2           ;  8
191   41A1 D3 99                out (VDP_CTRL), a       ; 12
192   41A3 C9                   ret                     ; 11
193   41A4
194   41A4              ; run: the frame's work: the demo's keys, the ship steered, the scroll.
195   41A4              ;      Uses every register
196   41A4 CD 43 41     run:    call pad                ; 18  A: the keys
197   41A7 CD AD 41             call steer              ; 18
198   41AA C3 E1 41             jp step                 ; 11  whose RET is run's
199   41AD
200   41AD              ; steer: A = the keys -> the ship two pixels up, down, left or right for each
201   41AD              ;        key held, kept in the sky. Uses A, B, HL
202   41AD 47           steer:  ld b, a                 ;  5
203   41AE 21 20 C1             ld hl, copy             ; 11  the ship's Y
204   41B1 CB 40                bit 0, b                ; 10  UP?
205   41B3 20 08                jr nz, .down            ; 13, or 8
206   41B5 7E                   ld a, (hl)              ;  8
207   41B6 FE 28                cp Y_MIN + 1            ;  8
208   41B8 38 03                jr c, .down             ; 13, or 8  at the top
209   41BA D6 02                sub 2                   ;  8
210   41BC 77                   ld (hl), a              ;  8
211   41BD CB 48        .down:  bit 1, b                ; 10  DOWN?
212   41BF 20 08                jr nz, .left            ; 13, or 8
213   41C1 7E                   ld a, (hl)              ;  8
214   41C2 FE 77                cp Y_MAX                ;  8
215   41C4 30 03                jr nc, .left            ; 13, or 8  at the bottom
216   41C6 C6 02                add a, 2                ;  8
217   41C8 77                   ld (hl), a              ;  8
218   41C9 23           .left:  inc hl                  ;  7  its X
219   41CA CB 50                bit 2, b                ; 10  LEFT?
220   41CC 20 08                jr nz, .right           ; 13, or 8
221   41CE 7E                   ld a, (hl)              ;  8
222   41CF FE 11                cp X_MIN + 1            ;  8
223   41D1 38 03                jr c, .right            ; 13, or 8  at the left
224   41D3 D6 02                sub 2                   ;  8
225   41D5 77                   ld (hl), a              ;  8
226   41D6 CB 58        .right: bit 3, b                ; 10  RIGHT?
227   41D8 C0                   ret nz                  ; 12, or 6
228   41D9 7E                   ld a, (hl)              ;  8
229   41DA FE A0                cp X_MAX                ;  8
230   41DC D0                   ret nc                  ; 12, or 6  at the right
231   41DD C6 02                add a, 2                ;  8
232   41DF 77                   ld (hl), a              ;  8
233   41E0 C9                   ret                     ; 11
234   41E1
235   41E1              ; step: after a new table is shown, the next window's names written into the
236   41E1              ;       other one; then a pixel on: shift, and at 8 the next column. Uses
237   41E1              ;       every register
238   41E1 3A 09 C1     step:   ld a, (shift)           ; 14
239   41E4 B7                   or a                    ;  5
240   41E5 20 09                jr nz, .on              ; 13, or 8
241   41E7 3A 08 C1             ld a, (col)             ; 14
242   41EA 3C                   inc a                   ;  5
243   41EB E6 3F                and W - 1               ;  8  the next window's column, round
244   41ED CD 02 42             call window             ; 18
245   41F0 21 09 C1     .on:    ld hl, shift            ; 11
246   41F3 7E                   ld a, (hl)              ;  8
247   41F4 3C                   inc a                   ;  5
248   41F5 E6 07                and 7                   ;  8
249   41F7 77                   ld (hl), a              ;  8
250   41F8 C0                   ret nz                  ; 12, or 6
251   41F9 21 08 C1             ld hl, col              ; 11  eight pixels: a column on
252   41FC 7E                   ld a, (hl)              ;  8
253   41FD 3C                   inc a                   ;  5
254   41FE E6 3F                and W - 1               ;  8
255   4200 77                   ld (hl), a              ;  8
256   4201 C9                   ret                     ; 11
257   4202
258   4202              ; window: A = a column -> the scrolling rows of the window at that column
259   4202              ;         into the name table not shown: rows 1 to 4, then 17 to 23, each
260   4202              ;         row's pairs in a page of pmap. Uses A, BC, DE, HL
261   4202 5F           window: ld e, a                 ;  5  E: the column
262   4203 6F                   ld l, a                 ;  5
263   4204 26 49                ld h, high pmap         ;  8  HL: row 1's pair there
264   4206 3A 0A C1             ld a, (table)           ; 14
265   4209 EE 04                xor $18 ^ $1C           ;  8  the table not shown
266   420B 57                   ld d, a                 ;  5  D: its high byte
267   420C 3E 20                ld a, 32                ;  8
268   420E D3 99                out (VDP_CTRL), a       ; 12
269   4210 7A                   ld a, d                 ;  5
270   4211 F6 40                or $40                  ;  8
271   4213 D3 99                out (VDP_CTRL), a       ; 12  its row 1, for writing
272   4215 0E 04                ld c, 4                 ;  8  four rows
273   4217 CD 25 42             call names              ; 18
274   421A 3E 20                ld a, low (32 * 17)     ;  8
275   421C D3 99                out (VDP_CTRL), a       ; 12
276   421E 7A                   ld a, d                 ;  5
277   421F F6 42                or high (32 * 17) | $40 ;  8
278   4221 D3 99                out (VDP_CTRL), a       ; 12  its row 17
279   4223 0E 07                ld c, 7                 ;  8  seven rows: on into names
280   4225
281   4225              ; names: HL = a row's pair at the column E, C = rows -> C rows of 32 names,
282   4225              ;        one after another in the VRAM, 39 T-states a name. Uses A, BC, HL
283   4225 06 20        names:  ld b, 32                ;  8
284   4227 7E           .name:  ld a, (hl)              ;  8
285   4228 D3 98                out (VDP_DATA), a       ; 12
286   422A 2C                   inc l                   ;  5
287   422B 10 FA                djnz .name              ; 14, or 9
288   422D 24                   inc h                   ;  5  the next row's page
289   422E 6B                   ld l, e                 ;  5
290   422F 0D                   dec c                   ;  5
291   4230 20 F3                jr nz, names            ; 13, or 8
292   4232 C9                   ret                     ; 11
