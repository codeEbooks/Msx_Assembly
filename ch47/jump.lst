224   41BA 21 80 FC             ld hl, -JUMP            ; 11  a jump
225   41BD 11 28 00     .grav:  ld de, GRAVITY          ; 11
226   41C0 19                   add hl, de              ; 12  gravity
227   41C1 CB 7C                bit 7, h                ; 10
228   41C3 20 08                jr nz, .fast            ; 13, or 8  going up
229   41C5 7C                   ld a, h                 ;  5
230   41C6 FE 04                cp high MAXFALL         ;  8
231   41C8 38 03                jr c, .fast             ; 13, or 8
232   41CA 21 00 04             ld hl, MAXFALL          ; 11  no faster
233   41CD 22 0B C1     .fast:  ld (vy), hl             ; 17
234   41D0 EB                   ex de, hl               ;  5  DE: the speed
235   41D1 3A 09 C1             ld a, (ry)              ; 14  y's whole lines
236   41D4 67                   ld h, a                 ;  5
237   41D5 3A 0A C1             ld a, (yfrac)           ; 14  and its 256ths
238   41D8 6F                   ld l, a                 ;  5
239   41D9 19                   add hl, de              ; 12  HL: the new y
240   41DA CB 7A                bit 7, d                ; 10
241   41DC 20 29                jr nz, .air             ; 13, or 8  going up: in the air
242   41DE 7C                   ld a, h                 ;  5
243   41DF C6 10                add a, 16               ;  8  the line under the new feet
244   41E1 E6 F8                and $F8                 ;  8  the top line of its cell
245   41E3 4F                   ld c, a                 ;  5  C
246   41E4 3A 09 C1             ld a, (ry)              ; 14
247   41E7 C6 10                add a, 16               ;  8  the line under the feet before
