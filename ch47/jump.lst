249   41EA 28 02                jr z, .look             ; 13, or 8  on that top already
250   41EC 30 19                jr nc, .air             ; 13, or 8  below it: not reached
251   41EE CD 14 42     .look:  call under              ; 18  a ledge in that row?
252   41F1 28 14                jr z, .air              ; 13, or 8  none: on in the air
253   41F3 79                   ld a, c                 ;  5
254   41F4 D6 10                sub 16                  ;  8
255   41F6 32 09 C1             ld (ry), a              ; 14  the feet on the ledge's top
256   41F9 AF                   xor a                   ;  5
257   41FA 32 0A C1             ld (yfrac), a           ; 14
258   41FD 67                   ld h, a                 ;  5
259   41FE 6F                   ld l, a                 ;  5
260   41FF 22 0B C1             ld (vy), hl             ; 17  still
261   4202 3C                   inc a                   ;  5
262   4203 32 0D C1             ld (landed), a          ; 14  on a ledge
263   4206 C9                   ret                     ; 11
264   4207 7C           .air:   ld a, h                 ;  5
265   4208 32 09 C1             ld (ry), a              ; 14  the new y
