 21+  4010              ; system variables
 22+  4010              LINLEN   EQU $F3B0      ; the width of a line of text
 23+  4010              CSRY     EQU $F3DC      ; the cursor's line, from 1
 24+  4010              CSRX     EQU $F3DD      ; and its column, from 1
 25+  4010              RG0SAV   EQU $F3DF      ; the copy of VDP register n is at RG0SAV + n
 26+  4010              STATFL   EQU $F3E7      ; the last status the BIOS read
 27+  4010              FORCLR   EQU $F3E9      ; ink, paper and border, for CHGMOD
 28+  4010              BAKCLR   EQU $F3EA
 29+  4010              BDRCLR   EQU $F3EB
 30+  4010              PUTPNT   EQU $F3F8      ; where the next key goes into the key buffer
 31+  4010              GETPNT   EQU $F3FA      ; where CHGET takes the next one from
 32+  4010              JIFFY    EQU $FC9E      ; one more every frame interrupt
 33+  4010              SCRMOD   EQU $FCAF      ; the screen mode
