 91   6CE4 AA          >        xor d                   ;  5: the other colour
 92   6CE5 00          >        nop                     ;  5: 38 a change, 6 a line
 89   6CE6 ED 79       >        out (c), a              ; 14: the colour
 90   6CE8 ED 59       >        out (c), e              ; 14: into register 7
