 93   6CEC                      EDUP
 94   6CEC ED 79                out (c), a
 95   6CEE ED 59                out (c), e
 96   6CF0 AA                   xor d
 97   6CF1 E9                   jp (hl)                 ;  5, where the last NOP was
 98   6CF2
 99   6CF2              ; isr: the frame's interrupt, taken once, to start in step with the picture
100   6CF2 F5           isr:    push af
101   6CF3 DB 99                in a, (VDP_CTRL)        ; the status: the VDP takes its signal down
102   6CF5 F1                   pop af
103   6CF6 FB                   ei
104   6CF7 C9                   ret
105   6CF8
106   6CF8              ; at: B = row (0-23), C = column (0-31) -> the VDP's write address is that
107   6CF8              ;     cell of the name table. Keeps BC, DE. Uses A, HL.
108   6CF8 D5           at:     push de
109   6CF9 68                   ld l, b
110   6CFA 26 00                ld h, 0
111   6CFC 29                   add hl, hl
112   6CFD 29                   add hl, hl
113   6CFE 29                   add hl, hl
114   6CFF 29                   add hl, hl
115   6D00 29                   add hl, hl              ; row x 32
116   6D01 59                   ld e, c
117   6D02 16 18                ld d, $18
118   6D04 19                   add hl, de              ; + $1800 + column
119   6D05 7D                   ld a, l
120   6D06 D3 99                out (VDP_CTRL), a
121   6D08 7C                   ld a, h
122   6D09 F6 40                or $40
123   6D0B D3 99                out (VDP_CTRL), a
124   6D0D D1                   pop de
125   6D0E C9                   ret
126   6D0F
127   6D0F              ; putc: A = character, B = row, C = column. Keeps BC, DE, HL.
128   6D0F E5           putc:   push hl
129   6D10 F5                   push af
130   6D11 CD F8 6C             call at
131   6D14 F1                   pop af
132   6D15 D3 98                out (VDP_DATA), a
133   6D17 E1                   pop hl
134   6D18 C9                   ret
135   6D19
136   6D19              ; puts: HL = text ending in 0, B = row, C = column; C moves on.
137   6D19 7E           puts:   ld a, (hl)
138   6D1A B7                   or a
139   6D1B C8                   ret z
140   6D1C CD 0F 6D             call putc
141   6D1F 23                   inc hl
142   6D20 0C                   inc c
143   6D21 18 F6                jr puts
144   6D23
145   6D23              ; puthex: A = a byte, as two hexadecimal digits; C moves on by 2.
146   6D23 F5           puthex: push af
147   6D24 0F                   rrca
148   6D25 0F                   rrca
149   6D26 0F                   rrca
150   6D27 0F                   rrca                    ; the high four bits first
151   6D28 CD 2C 6D             call hexdig
152   6D2B F1                   pop af
153   6D2C E6 0F        hexdig: and %00001111
154   6D2E C6 30                add a, '0'
155   6D30 FE 3A                cp '9' + 1
156   6D32 38 02                jr c, .digit
157   6D34 C6 07                add a, 'A' - '9' - 1    ; 10-15 become A-F
158   6D36 CD 0F 6D     .digit: call putc
159   6D39 0C                   inc c
160   6D3A C9                   ret
161   6D3B              boxes:                          ; characters 1 (empty box) and 2 (filled)
162   6D3B FE 82 82 82          db %11111110, %10000010, %10000010, %10000010, %10000010, %10000010, %11111110, %00000000
162   6D3F 82 82 FE 00
163   6D43 FE FE FE FE          db %11111110, %11111110, %11111110, %11111110, %11111110, %11111110, %11111110, %00000000
163   6D47 FE FE FE 00
164   6D4B                      ASSERT $ <= $8000, the program is longer than the cartridge
165   6D4B FF FF FF...          ds $8000 - $, $FF       ; pad the cartridge to 16 KB
166   8000
# file closed: ruler.asm
