   9  4010              ; Every documented instruction but HALT and RST, run from a table: each
  10  4010              ; with the eight Fs of fvals, from every state of its group. A state is
  11  4010              ; the registers, popped from it, SP, the word at STK, AF', the byte in the
  12  4010              ; PSG's register 0, which port $A2 reads back, and the 8 bytes at WIN.
  13  4010              ; measA.py stops at after and reads everything.
  14  4010              WIN     equ $E1FC               ; the bytes read and written: (HL) is WIN+4
  15  4010              STK     equ $E210               ; SP for the runs
  16  4010              TOP     equ $F37E               ; SP between them
  17  4010              S_BC    equ $B1C1               ; BC', DE' and HL' before each run
  18  4010              S_DE    equ $D1E1
  19  4010              S_HL    equ $4161
  20  4010              FVN     equ 8                   ; how many Fs
  21  4010              go      equ VARS                ; JP and the instruction's code
  22  4010              ip      equ VARS + 3            ; the instruction table, where it has got to
  23  4010              gp      equ VARS + 5            ; the group's list of states
  24  4010              gn      equ VARS + 7            ; states left
  25  4010              sv      equ VARS + 8            ; the state
  26  4010              fi      equ VARS + 10           ; which F
  27  4010              spv     equ VARS + 11           ; SP
  28  4010              cur     equ VARS + 16           ; the state, copied: F goes into it
  29  4010              STATE   equ 27                  ; a state's bytes
