 36+  0000              ; cartridge header: "AB", INIT, STATEMENT, DEVICE, TEXT, 6 reserved bytes
 37+  0000                  MACRO CART_HEADER init_addr
 38+  0000 ~                    db "AB"
 39+  0000 ~                    dw init_addr
 40+  0000 ~                    dw 0, 0, 0
 41+  0000 ~                    ds 6, 0
 42+  0000                  ENDM
 43+  0000
 44+  0000              ; write value to VDP register reg (2 OUTs; interrupts must be off)
 45+  0000                  MACRO VDP_REG reg, value
 46+  0000 ~                    ld a, value
 47+  0000 ~                    out (VDP_CTRL), a
 48+  0000 ~                    ld a, $80 | (reg)
 49+  0000 ~                    out (VDP_CTRL), a
 50+  0000                  ENDM
 51+  0000
 52+  0000              ; set the VRAM write address (2 OUTs; interrupts must be off)
 53+  0000                  MACRO VRAM_WRITE addr
 54+  0000 ~                    ld a, low (addr)
 55+  0000 ~                    out (VDP_CTRL), a
 56+  0000 ~                    ld a, high (addr) | $40
 57+  0000 ~                    out (VDP_CTRL), a
 58+  0000                  ENDM
 59+  0000
