5717  B700                      ASSERT $ == BSHOW, the segments must end where bshow starts
5718  B700
5719  B700              ; bshow, bank 5's: its pairs at the shift, 22 patterns from 1, with OTIR;
5720  B700              ; and when fresh says the bank is new, their colours. Uses A, BC, HL
5721  B700              bshow5: VRAM_WRITE $0008        ; 40  pair 1's pattern, the first
5721  B700 3E 08       >        ld a, low ($0008)
5721  B702 D3 99       >        out (VDP_CTRL), a
5721  B704 3E 40       >        ld a, high ($0008) | $40
5721  B706 D3 99       >        out (VDP_CTRL), a
5722  B708 3A 09 C1             ld a, (shift)           ; 14
5723  B70B 87                   add a, a                ;  5  two bytes a shift
5724  B70C C6 40                add a, low stab5        ;  8
5725  B70E 6F                   ld l, a                 ;  5
5726  B70F 26 B7                ld h, high stab5        ;  8  HL: the shift's place in stab
5727  B711 7E                   ld a, (hl)              ;  8
5728  B712 2C                   inc l                   ;  5
5729  B713 66                   ld h, (hl)              ;  8
5730  B714 6F                   ld l, a                 ;  5  HL: the pairs at this shift
5731  B715 01 98 B0             ld bc, 176 << 8 | VDP_DATA ; 11
5732  B718 ED B3                otir                    ; 23 a byte, 18 the last
5733  B71A 3A 10 C1             ld a, (fresh)           ; 14
5734  B71D B7                   or a                    ;  5
5735  B71E C8                   ret z                   ; 12, or 6  the same bank as before
5736  B71F AF                   xor a                   ;  5
5737  B720 32 10 C1             ld (fresh), a           ; 14  sent once
5738  B723                      VRAM_WRITE $2008        ; 40  pair 1's colours
5738  B723 3E 08       >        ld a, low ($2008)
5738  B725 D3 99       >        out (VDP_CTRL), a
5738  B727 3E 60       >        ld a, high ($2008) | $40
5738  B729 D3 99       >        out (VDP_CTRL), a
5739  B72B 21 50 B7             ld hl, pcols5           ; 11
5740  B72E 06 B0                ld b, 176               ;  8
5741  B730 ED B3                otir                    ; 23 a byte, 18 the last
5742  B732 C9                   ret                     ; 11
5743  B733 00 00 00...          ALIGN 16
5744  B740              stab5:                          ; where each shift's patterns start
5745  B740 00 B8                dw shifts5 + 0
5746  B742 B0 B8                dw shifts5 + 176
5747  B744 60 B9                dw shifts5 + 352
5748  B746 10 BA                dw shifts5 + 528
5749  B748 C0 BA                dw shifts5 + 704
