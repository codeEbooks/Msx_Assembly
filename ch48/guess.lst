6803  B70C C6 40                add a, low stab6        ;  8
6804  B70E 6F                   ld l, a                 ;  5
6805  B70F 26 B7                ld h, high stab6        ;  8  HL: the shift's place in stab
6806  B711 7E                   ld a, (hl)              ;  8
6807  B712 2C                   inc l                   ;  5
6808  B713 66                   ld h, (hl)              ;  8
6809  B714 6F                   ld l, a                 ;  5  HL: the pairs at this shift
