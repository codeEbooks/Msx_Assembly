3575  B71A 3A 10 C1             ld a, (fresh)           ; 14
3576  B71D B7                   or a                    ;  5
3577  B71E C8                   ret z                   ; 12, or 6  the same bank as before
3578  B71F AF                   xor a                   ;  5
3579  B720 32 10 C1             ld (fresh), a           ; 14  sent once
