5715  B700                      ASSERT $ == BSHOW, the segments must end where bshow starts
5716  B700
5717  B700              ; bshow, bank 5's: its pairs at the shift, 22 patterns from 1, with OTIR;
5718  B700              ; and when fresh says the bank is new, their colours. Uses A, BC, HL
5719  B700              bshow5: VRAM_WRITE $0008        ; 40  pair 1's pattern, the first
5719  B700 3E 08       >        ld a, low ($0008)
5719  B702 D3 99       >        out (VDP_CTRL), a
5719  B704 3E 40       >        ld a, high ($0008) | $40
5719  B706 D3 99       >        out (VDP_CTRL), a
5720  B708 3A 09 C1             ld a, (shift)           ; 14
5721  B70B 87                   add a, a                ;  5  two bytes a shift
5722  B70C C6 40                add a, low stab5        ;  8
5723  B70E 6F                   ld l, a                 ;  5
5724  B70F 26 B7                ld h, high stab5        ;  8  HL: the shift's place in stab
5725  B711 7E                   ld a, (hl)              ;  8
5726  B712 2C                   inc l                   ;  5
5727  B713 66                   ld h, (hl)              ;  8
5728  B714 6F                   ld l, a                 ;  5  HL: the pairs at this shift
5729  B715 01 98 B0             ld bc, 176 << 8 | VDP_DATA ; 11
5730  B718 ED B3                otir                    ; 23 a byte, 18 the last
5731  B71A 3A 10 C1             ld a, (fresh)           ; 14
5732  B71D B7                   or a                    ;  5
5733  B71E C8                   ret z                   ; 12, or 6  the same bank as before
5734  B71F AF                   xor a                   ;  5
5735  B720 32 10 C1             ld (fresh), a           ; 14  sent once
5736  B723                      VRAM_WRITE $2008        ; 40  pair 1's colours
5736  B723 3E 08       >        ld a, low ($2008)
5736  B725 D3 99       >        out (VDP_CTRL), a
5736  B727 3E 60       >        ld a, high ($2008) | $40
5736  B729 D3 99       >        out (VDP_CTRL), a
5737  B72B 21 50 B7             ld hl, pcols5           ; 11
5738  B72E 06 B0                ld b, 176               ;  8
5739  B730 ED B3                otir                    ; 23 a byte, 18 the last
5740  B732 C9                   ret                     ; 11
5741  B733 00 00 00...          ALIGN 16
5742  B740              stab5:                          ; where each shift's patterns start
5743  B740 00 B8                dw shifts5 + 0
5744  B742 B0 B8                dw shifts5 + 176
5745  B744 60 B9                dw shifts5 + 352
5746  B746 10 BA                dw shifts5 + 528
5747  B748 C0 BA                dw shifts5 + 704
