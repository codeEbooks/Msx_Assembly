6800  B70B 87                   add a, a                ;  5  two bytes a shift
6801  B70C C6 40                add a, low stab6        ;  8
6802  B70E 6F                   ld l, a                 ;  5
6803  B70F 26 B7                ld h, high stab6        ;  8  HL: the shift's place in stab
6804  B711 7E                   ld a, (hl)              ;  8
6805  B712 2C                   inc l                   ;  5
6806  B713 66                   ld h, (hl)              ;  8
6807  B714 6F                   ld l, a                 ;  5  HL: the pairs at this shift
6808  B715 01 98 B0             ld bc, 176 << 8 | VDP_DATA ; 11
6809  B718 ED B3                otir                    ; 23 a byte, 18 the last
6810  B71A 3A 10 C1             ld a, (fresh)           ; 14
6811  B71D B7                   or a                    ;  5
6812  B71E C8                   ret z                   ; 12, or 6  the same bank as before
6813  B71F AF                   xor a                   ;  5
6814  B720 32 10 C1             ld (fresh), a           ; 14  sent once
