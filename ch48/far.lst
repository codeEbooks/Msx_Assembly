4638  B700              ; bshow, bank 4's: its pairs at the shift, 22 patterns from 1, with OTIR;
4639  B700              ; and when fresh says the bank is new, their colours. Uses A, BC, HL
4640  B700              bshow4: VRAM_WRITE $0008        ; 40  pair 1's pattern, the first
4640  B700 3E 08       >        ld a, low ($0008)
4640  B702 D3 99       >        out (VDP_CTRL), a
4640  B704 3E 40       >        ld a, high ($0008) | $40
4640  B706 D3 99       >        out (VDP_CTRL), a
4641  B708 3A 09 C1             ld a, (shift)           ; 14
4642  B70B 87                   add a, a                ;  5  two bytes a shift
4643  B70C C6 40                add a, low stab4        ;  8
4644  B70E 6F                   ld l, a                 ;  5
4645  B70F 26 B7                ld h, high stab4        ;  8  HL: the shift's place in stab
4646  B711 7E                   ld a, (hl)              ;  8
4647  B712 2C                   inc l                   ;  5
4648  B713 66                   ld h, (hl)              ;  8
4649  B714 6F                   ld l, a                 ;  5  HL: the pairs at this shift
4650  B715 01 98 B0             ld bc, 176 << 8 | VDP_DATA ; 11
4651  B718 ED B3                otir                    ; 23 a byte, 18 the last
4652  B71A 3A 10 C1             ld a, (fresh)           ; 14
4653  B71D B7                   or a                    ;  5
4654  B71E C8                   ret z                   ; 12, or 6  the same bank as before
4655  B71F AF                   xor a                   ;  5
4656  B720 32 10 C1             ld (fresh), a           ; 14  sent once
4657  B723                      VRAM_WRITE $2008        ; 40  pair 1's colours
4657  B723 3E 08       >        ld a, low ($2008)
4657  B725 D3 99       >        out (VDP_CTRL), a
4657  B727 3E 60       >        ld a, high ($2008) | $40
4657  B729 D3 99       >        out (VDP_CTRL), a
4658  B72B 21 50 B7             ld hl, pcols4           ; 11
4659  B72E 06 B0                ld b, 176               ;  8
4660  B730 ED B3                otir                    ; 23 a byte, 18 the last
4661  B732 C9                   ret                     ; 11
4662  B733 00 00 00...          ALIGN 16
