1410  B70C C6 40                add a, low stab1        ;  8
1411  B70E 6F                   ld l, a                 ;  5
1412  B70F 26 B7                ld h, high stab1        ;  8  HL: the shift's place in stab
1413  B711 7E                   ld a, (hl)              ;  8
1414  B712 2C                   inc l                   ;  5
1415  B713 66                   ld h, (hl)              ;  8
1416  B714 6F                   ld l, a                 ;  5  HL: the pairs at this shift
