 7    4010                      INCLUDE "bios.inc"
# file opened: bios.inc
 1+   4010              ; bios.inc -- the BIOS entry points and system variables this book calls by
 2+   4010              ; name (chapter 16). The MSX standard fixes every address: behind each entry
 3+   4010              ; point every MSX BIOS, C-BIOS included, has a JP to a routine of its own.
 4+   4010              ; Call them with page 0 showing the BIOS, as it does when INIT is called.
 5+   4010
 6+   4010              ; entry points
 7+   4010              RDSLT    EQU $000C      ; A = the byte at HL in slot A, a slot ID (chapter 38)
 8+   4010              WRSLT    EQU $0014      ; E to the address HL in slot A
 9+   4010              CALSLT   EQU $001C      ; call the address IX in the slot in IY's high byte
10+   4010              ENASLT   EQU $0024      ; HL's page shows slot A; the interrupts left off
11+   4010              DISSCR   EQU $0041      ; the display off
12+   4010              ENASCR   EQU $0044      ; the display on
13+   4010              WRTVDP   EQU $0047      ; B to VDP register C
14+   4010              RDVRM    EQU $004A      ; A = the byte of the VRAM at HL (chapter 19)
15+   4010              WRTVRM   EQU $004D      ; A to the VRAM at HL
16+   4010              SETRD    EQU $0050      ; the VDP's address set to HL, to read
17+   4010              SETWRT   EQU $0053      ; the VDP's address set to HL, to write
18+   4010              FILVRM   EQU $0056      ; BC bytes of A to the VRAM from HL
19+   4010              LDIRVM   EQU $005C      ; BC bytes from HL to the VRAM at DE
20+   4010              CHGMOD   EQU $005F      ; the screen mode in A
21+   4010              INITXT   EQU $006C      ; text mode, 40 x 24, with the BIOS's tables (chapter 21)
22+   4010              INIT32   EQU $006F      ; Graphic I, 32 x 24
23+   4010              INIGRP   EQU $0072      ; Graphic II
24+   4010              INIMLT   EQU $0075      ; multicolour
25+   4010              CHSNS    EQU $009C      ; Z if no key waits in the buffer (chapter 34)
26+   4010              CHGET    EQU $009F      ; wait for a key; A = its code
27+   4010              CHPUT    EQU $00A2      ; print the character in A
28+   4010              BEEP     EQU $00C0      ; a beep (C-BIOS: none)
29+   4010              GTSTCK   EQU $00D5      ; A = 0: the cursor keys; A = their direction, 0-8
30+   4010              GTTRIG   EQU $00D8      ; A = 0 SPACE, 1-4 a joystick's button: A = $FF if held
31+   4010              RSLREG   EQU $0138      ; A = port $A8, the primary slots (chapter 38)
32+   4010              WSLREG   EQU $013B      ; port $A8 = A
33+   4010              SNSMAT   EQU $0141      ; A = the keys of keyboard row A, 0 = held (chapter 34)
34+   4010
35+   4010              ; two bytes of data: the VDP's ports, for programs that ask
36+   4010              VDP_DR   EQU $0006      ; the port the VRAM is read from
37+   4010              VDP_DW   EQU $0007      ; the port it is written to
38+   4010
39+   4010              ; system variables
40+   4010              LINLEN   EQU $F3B0      ; the width of a line of text
41+   4010              TXTNAM   EQU $F3B3      ; where INITXT puts the tables: names, colours,
42+   4010              TXTCOL   EQU $F3B5      ; patterns, sprite attributes, sprite patterns
43+   4010              TXTCGP   EQU $F3B7      ; (chapter 21); two bytes each
44+   4010              TXTATR   EQU $F3B9
45+   4010              TXTPAT   EQU $F3BB
46+   4010              T32NAM   EQU $F3BD      ; the same for INIT32
47+   4010              T32COL   EQU $F3BF
48+   4010              T32CGP   EQU $F3C1
49+   4010              T32ATR   EQU $F3C3
50+   4010              T32PAT   EQU $F3C5
51+   4010              GRPNAM   EQU $F3C7      ; for INIGRP
52+   4010              GRPCOL   EQU $F3C9
53+   4010              GRPCGP   EQU $F3CB
54+   4010              GRPATR   EQU $F3CD
55+   4010              GRPPAT   EQU $F3CF
56+   4010              MLTNAM   EQU $F3D1      ; for INIMLT
57+   4010              MLTCOL   EQU $F3D3
58+   4010              MLTCGP   EQU $F3D5
59+   4010              MLTATR   EQU $F3D7
60+   4010              MLTPAT   EQU $F3D9
61+   4010              CSRY     EQU $F3DC      ; the cursor's line, from 1
62+   4010              CSRX     EQU $F3DD      ; and its column, from 1
63+   4010              RG0SAV   EQU $F3DF      ; the copy of VDP register n is at RG0SAV + n
64+   4010              STATFL   EQU $F3E7      ; the last status the BIOS read
65+   4010              FORCLR   EQU $F3E9      ; ink, paper and border, for CHGMOD
66+   4010              BAKCLR   EQU $F3EA
67+   4010              BDRCLR   EQU $F3EB
68+   4010              SCNCNT   EQU $F3F6      ; interrupts left before the BIOS reads the keyboard
69+   4010              PUTPNT   EQU $F3F8      ; where the next key goes into the key buffer
70+   4010              GETPNT   EQU $F3FA      ; where CHGET takes the next one from
71+   4010              NEWKEY   EQU $FBE5      ; the eleven rows, as the BIOS last read them
72+   4010              JIFFY    EQU $FC9E      ; one more every frame interrupt
73+   4010              SCRMOD   EQU $FCAF      ; the screen mode
74+   4010              EXPTBL   EQU $FCC1      ; which slots are expanded: bit 7, one byte a slot
75+   4010              SLTTBL   EQU $FCC5      ; the secondary registers, as the BIOS last wrote them
76+   4010
77+   4010              ; hooks: five bytes each, RET until a program puts a jump there
78+   4010              H_KEYI   EQU $FD9A      ; H.KEYI, every interrupt
79+   4010              H_TIMI   EQU $FD9F      ; H.TIMI, every frame interrupt
80+   4010              H_CHPU   EQU $FDA4      ; H.CHPU, every character CHPUT prints
81+   4010              H_CHGE   EQU $FDC2      ; H.CHGE, every call of CHGET
82+   4010
# file closed: bios.inc
 8    4010
 9    4010              ; The BIOS's interrupt reads the keyboard; measC.py presses every key of rows
10    4010              ; 0 to 10, one at a time, and reads each character CHGET gives, at got.
11    4010
12    4010 F3           init:   di
13    4011 ED 56                im 1
14    4013                      VDP_REG 1, $E0          ; the frame's interrupt on
14    4013 3E E0       >        ld a, $E0
14    4015 D3 99       >        out (VDP_CTRL), a
14    4017 3E 81       >        ld a, $80 | (1)
14    4019 D3 99       >        out (VDP_CTRL), a
15    401B FB           main:   ei
16    401C 76                   halt
17    401D CD 9C 00             call CHSNS              ; a character waiting?
18    4020 28 F9                jr z,main
19    4022 CD 9F 00             call CHGET
20    4025 00           got:    nop                     ; measC.py reads A here
21    4026 18 F3                jr main
22    4028
23    4028                      ASSERT $ <= $8000, the program is longer than the cartridge
24    4028 FF FF FF...          ds $8000 - $, $FF       ; pad the cartridge to 16 KB
25    8000
# file closed: keys.asm
