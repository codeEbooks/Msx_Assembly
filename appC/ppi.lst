400   4347 00           ictrl:  nop                     ; measC.py reads the PPI
401   4348              ; phase0
402   4348 0E 00                ld c,$00
403   434A 3E 00                ld a,$00
404   434C D3 AA                out (PPI_C),a           ; lamp, motor on; 5, 7 turn
405   434E 16 0A                ld d,10
406   4350 DB 99                in a,(VDP_CTRL)
407   4352 00           phphase0_1: nop
408   4353 1E 28                ld e,40
409   4355 1D           tgphase0_1: dec e
410   4356 20 FD                jr nz,tgphase0_1
411   4358 79                   ld a,c
412   4359 EE A0                xor $A0
413   435B 4F                   ld c,a
414   435C D3 AA                out (PPI_C),a           ; bits 5 and 7 turned over
415   435E DB 99                in a,(VDP_CTRL)
416   4360 07                   rlca
417   4361 30 EF                jr nc,phphase0_1
418   4363 15                   dec d
419   4364 20 EC                jr nz,phphase0_1
420   4366 00           iphase0: nop                    ; measC.py reads the PPI
421   4367              ; phase1
422   4367 3E D0                ld a,$D0
423   4369 D3 AA                out (PPI_C),a           ; lamp, motor off; click 1
424   436B 16 0A                ld d,10
425   436D DB 99                in a,(VDP_CTRL)
426   436F 00           phphase1_1: nop
427   4370 DB 99                in a,(VDP_CTRL)
428   4372 07                   rlca
429   4373 30 FA                jr nc,phphase1_1
430   4375 15                   dec d
431   4376 20 F7                jr nz,phphase1_1
432   4378 00           iphase1: nop                    ; measC.py reads the PPI
433   4379              ; cend
434   4379 3E 50                ld a,$50
435   437B D3 AA                out (PPI_C),a
436   437D 00           icend:  nop                     ; measC.py reads the PPI
437   437E 18 FE        done:   jr done
438   4380
439   4380              ; slotrt: B into port A, the word at DE into HL, port A back; copied to
440   4380              ; $E100, in the RAM, which the slots it sets do not move
441   4380 3A 7F C0     slotrt: ld a,(slots)
442   4383 4F                   ld c,a
443   4384 78                   ld a,b
444   4385 D3 A8                out (PPI_A),a
445   4387 EB                   ex de,hl
446   4388 5E                   ld e,(hl)
447   4389 23                   inc hl
448   438A 56                   ld d,(hl)
449   438B 79                   ld a,c
450   438C D3 A8                out (PPI_A),a           ; back
451   438E EB                   ex de,hl
452   438F C9                   ret
453   4390              slotrt_end:
454   4390
455   4390                      ASSERT $ <= $8000, the program is longer than the cartridge
456   4390 FF FF FF...          ds $8000 - $, $FF       ; pad the cartridge to 16 KB
457   8000
# file closed: ppi.asm
