211   4200
212   4200              ; pulse: E = the input as last read -> waits for bit 7 of R14 to change.
213   4200              ;        C = the turns it waited, 44 T-states each; 0 if the edge came
214   4200              ;        before it looked, or if it waited more than 255 turns: a
215   4200              ;        silence ended. E = the input now. Uses A
216   4200 0E 00        pulse:  ld c, 0                 ;  8
217   4202 DB A2        .wait:  in a, (PSG_READ)        ; 12  bit 7: the tape
218   4204 AB                   xor e                   ;  5
219   4205 FA 12 42             jp m, .edge             ; 11  bit 7 changed: an edge
220   4208 0C                   inc c                   ;  5
221   4209 C2 02 42             jp nz, .wait            ; 11  44 T-states a turn
222   420C DB A2        .quiet: in a, (PSG_READ)        ; 12  no edge in 256 turns: C = 0, and
223   420E AB                   xor e                   ;  5  wait on for the one that ends
224   420F F2 0C 42             jp p, .quiet            ; 11  the silence
225   4212 AB           .edge:  xor e                   ;  5  the input again
226   4213 5F                   ld e, a                 ;  5
227   4214 C9                   ret                     ; 11
228   4215
229   4215              ; getbyte: D = the threshold -> A = the next byte on tape. A pulse longer
230   4215              ;          than D turns is half a 0, a shorter one a quarter of a 1. Waits
231   4215              ;          for a start bit, then reads eight bits, the lowest first. Uses
232   4215              ;          BC, L
233   4215              getbyte:
234   4215 CD 00 42     .start: call pulse              ; 18  the tone, or stop bits: short
235   4218 7A                   ld a, d                 ;  5
236   4219 B9                   cp c                    ;  5
237   421A 30 F9                jr nc, .start           ; 13, or 8  until a long one: a start bit
238   421C CD 00 42             call pulse              ; 18  its other half
239   421F 06 08                ld b, 8                 ;  8
240   4221 CD 00 42     .bit:   call pulse              ; 18  a bit's first half
241   4224 7A                   ld a, d                 ;  5
242   4225 B9                   cp c                    ;  5  carry: C > D, long: a 0
243   4226 38 0C                jr c, .zero             ; 13, or 8
244   4228 CD 00 42             call pulse              ; 18  a 1: three more short ones
245   422B CD 00 42             call pulse              ; 18
246   422E CD 00 42             call pulse              ; 18
247   4231 37                   scf                     ;  5  the bit is 1
248   4232 18 04                jr .next                ; 13
249   4234 CD 00 42     .zero:  call pulse              ; 18  a 0: its other long half
250   4237 B7                   or a                    ;  5  the bit is 0
251   4238 CB 1D        .next:  rr l                    ; 10  into L from the top: the lowest comes first
252   423A 10 E5                djnz .bit               ; 14, or 9
253   423C 7D                   ld a, l                 ;  5
254   423D C9                   ret                     ; 11
255   423E
256   423E              ; header: waits for the tone before a block and measures it: D = twice
257   423E              ;         its mean pulse, in turns. A long pulse is twice a short one, and
258   423E              ;         every pulse is counted low: the work between two pulses eats
259   423E              ;         into them. Uses A, BC, HL
260   423E CD 00 42     header: call pulse
261   4241 79                   ld a, c
262   4242 B7                   or a
263   4243 28 F9                jr z, header            ; a silence ended: the tone starts
264   4245 21 00 00             ld hl, 0                ; the sum of 256 pulses
265   4248 45                   ld b, l
266   4249 CD 00 42     .sum:   call pulse              ; 18
267   424C 79                   ld a, c                 ;  5
268   424D B7                   or a                    ;  5
269   424E 28 EE                jr z, header            ; 13, or 8  a silence: again
270   4250 85                   add a, l                ;  5
271   4251 6F                   ld l, a                 ;  5
272   4252 30 01                jr nc, .nc              ; 13, or 8
273   4254 24                   inc h                   ;  5
274   4255 10 F2        .nc:    djnz .sum               ; 14, or 9
275   4257 29                   add hl, hl              ; twice the sum
276   4258 54                   ld d, h                 ; / 256: twice the mean
277   4259 C9                   ret
278   425A
