323   4289 0F                   rrca                    ; the high four bits first
324   428A CD 8E 42             call hexdig
325   428D F1                   pop af
326   428E E6 0F        hexdig: and %00001111
327   4290 C6 30                add a, '0'
328   4292 FE 3A                cp '9' + 1
329   4294 38 02                jr c, .digit
330   4296 C6 07                add a, 'A' - '9' - 1    ; 10-15 become A-F
331   4298 CD 71 42     .digit: call putc
332   429B 0C                   inc c
333   429C C9                   ret
334   429D
335   429D              ; putdec: A = a byte taken as unsigned (0-255): three characters, right-aligned
336   429D              ; putsgn: A = a byte taken as signed (-128 to 127): four characters
337   429D              ;         C moves on by 3 or 4. Uses A, DE, HL.
338   429D C5           putdec: push bc
339   429E 16 20                ld d, ' '
340   42A0 CD C9 42             call digits
341   42A3 C1                   pop bc
342   42A4 21 01 C1             ld hl, numbuf + 1
343   42A7 1E 03                ld e, 3
344   42A9 18 14                jr pnout
345   42AB C5           putsgn: push bc
346   42AC 16 20                ld d, ' '
347   42AE CB 7F                bit 7, a                ; the top bit is the sign
348   42B0 28 04                jr z, .pos
349   42B2 ED 44                neg                     ; two's complement: the size of the number
350   42B4 16 2D                ld d, '-'
351   42B6 CD C9 42     .pos:   call digits
352   42B9 C1                   pop bc
353   42BA 21 00 C1             ld hl, numbuf
354   42BD 1E 04                ld e, 4
355   42BF 7E           pnout:  ld a, (hl)
356   42C0 CD 71 42             call putc
357   42C3 0C                   inc c
358   42C4 23                   inc hl
359   42C5 1D                   dec e
360   42C6 20 F7                jr nz, pnout
361   42C8 C9                   ret
362   42C9
363   42C9              ; digits: A (0-255) into numbuf in decimal, right-aligned, D just left of
364   42C9              ;         the first digit. Uses A, C, HL.
365   42C9 21 00 C1     digits: ld hl, numbuf
366   42CC 36 20                ld (hl), ' '
367   42CE 23                   inc hl
368   42CF 36 20                ld (hl), ' '
369   42D1 23                   inc hl
370   42D2 36 20                ld (hl), ' '
371   42D4 23                   inc hl
372   42D5 36 20                ld (hl), ' '            ; HL: the last character
373   42D7 0E 00        .next:  ld c, 0                 ; C: A divided by 10
374   42D9 FE 0A        .ten:   cp 10
375   42DB 38 05                jr c, .rest
376   42DD D6 0A                sub 10
377   42DF 0C                   inc c
378   42E0 18 F7                jr .ten
379   42E2 C6 30        .rest:  add a, '0'
380   42E4 77                   ld (hl), a              ; the remainder is this digit
381   42E5 2B                   dec hl
382   42E6 79                   ld a, c
383   42E7 B7                   or a
384   42E8 20 ED                jr nz, .next            ; and the quotient is what is left
385   42EA 72                   ld (hl), d              ; the sign, or a space
386   42EB C9                   ret
387   42EC              numbuf  EQU VARS                ; 4 bytes of RAM
388   42EC              boxes:  ; characters 1 (empty box) and 2 (filled)
389   42EC FE 82 82 82          db %11111110, %10000010, %10000010, %10000010, %10000010, %10000010, %11111110, %00000000
389   42F0 82 82 FE 00
390   42F4 FE FE FE FE          db %11111110, %11111110, %11111110, %11111110, %11111110, %11111110, %11111110, %00000000
390   42F8 FE FE FE 00
391   42FC
392   42FC 4D 4F 54 4F  t_look: db "MOTOR ON: LOOKING FOR A FILE", 0
392   4300 52 20 4F 4E
392   4304 3A 20 4C 4F
392   4308 4F 4B 49 4E
392   430C 47 20 46 4F
392   4310 52 20 41 20
392   4314 46 49 4C 45
392   4318 00
393   4319 54 4F 4E 45  t_thr:  db "TONE: THRESHOLD", 0
393   431D 3A 20 54 48
393   4321 52 45 53 48
393   4325 4F 4C 44 00
394   4329 46 4F 55 4E  t_name: db "FOUND", 0
394   432D 44 00
395   432F 46 52 4F 4D  t_from: db "FROM $      TO $", 0
395   4333 20 24 20 20
395   4337 20 20 20 20
395   433B 54 4F 20 24
395   433F 00
396   4340 4C 4F 41 44  t_done: db "LOADED", 0
396   4344 45 44 00
397   4347                      ASSERT $ <= $8000, the program is longer than the cartridge
398   4347 FF FF FF...          ds $8000 - $, $FF       ; pad the cartridge to 16 KB
