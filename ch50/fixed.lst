211   4200              ; pulse: E = the input as last read -> waits for bit 7 of R14 to change.
212   4200              ;        C = the turns it waited, 44 T-states each; 0 if the edge came
213   4200              ;        before it looked, or if it waited more than 255 turns: a
214   4200              ;        silence ended. E = the input now. Uses A
215   4200 0E 00        pulse:  ld c, 0                 ;  8
216   4202 DB A2        .wait:  in a, (PSG_READ)        ; 12  bit 7: the tape
217   4204 AB                   xor e                   ;  5
218   4205 FA 12 42             jp m, .edge             ; 11  bit 7 changed: an edge
219   4208 0C                   inc c                   ;  5
220   4209 C2 02 42             jp nz, .wait            ; 11  44 T-states a turn
221   420C DB A2        .quiet: in a, (PSG_READ)        ; 12  no edge in 256 turns: C = 0, and
222   420E AB                   xor e                   ;  5  wait on for the one that ends
223   420F F2 0C 42             jp p, .quiet            ; 11  the silence
224   4212 AB           .edge:  xor e                   ;  5  the input again
225   4213 5F                   ld e, a                 ;  5
226   4214 C9                   ret                     ; 11
227   4215
228   4215              ; getbyte: D = the threshold -> A = the next byte on tape. A pulse longer
229   4215              ;          than D turns is half a 0, a shorter one a quarter of a 1. Waits
230   4215              ;          for a start bit, then reads eight bits, the lowest first. Uses
231   4215              ;          BC, L
232   4215              getbyte:
233   4215 CD 00 42     .start: call pulse              ; 18  the tone, or stop bits: short
234   4218 7A                   ld a, d                 ;  5
235   4219 B9                   cp c                    ;  5
236   421A 30 F9                jr nc, .start           ; 13, or 8  until a long one: a start bit
237   421C CD 00 42             call pulse              ; 18  its other half
238   421F 06 08                ld b, 8                 ;  8
239   4221 CD 00 42     .bit:   call pulse              ; 18  a bit's first half
240   4224 7A                   ld a, d                 ;  5
241   4225 B9                   cp c                    ;  5  carry: C > D, long: a 0
242   4226 38 0C                jr c, .zero             ; 13, or 8
243   4228 CD 00 42             call pulse              ; 18  a 1: three more short ones
244   422B CD 00 42             call pulse              ; 18
245   422E CD 00 42             call pulse              ; 18
246   4231 37                   scf                     ;  5  the bit is 1
247   4232 18 04                jr .next                ; 13
248   4234 CD 00 42     .zero:  call pulse              ; 18  a 0: its other long half
249   4237 B7                   or a                    ;  5  the bit is 0
250   4238 CB 1D        .next:  rr l                    ; 10  into L from the top: the lowest comes first
251   423A 10 E5                djnz .bit               ; 14, or 9
252   423C 7D                   ld a, l                 ;  5
253   423D C9                   ret                     ; 11
254   423E
255   423E              ; header: waits for the tone before a block and measures it: D = twice
256   423E              ;         its mean pulse, in turns. A long pulse is twice a short one, and
257   423E              ;         every pulse is counted low: the work between two pulses eats
258   423E              ;         into them. Uses A, BC, HL
