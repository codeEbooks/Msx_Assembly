325   428F E6 0F        hexdig: and %00001111
326   4291 C6 30                add a, '0'
327   4293 FE 3A                cp '9' + 1
328   4295 38 02                jr c, .digit
329   4297 C6 07                add a, 'A' - '9' - 1    ; 10-15 become A-F
330   4299 CD 72 42     .digit: call putc
331   429C 0C                   inc c
332   429D C9                   ret
333   429E
334   429E              ; putdec: A = a byte taken as unsigned (0-255): three characters, right-aligned
335   429E              ; putsgn: A = a byte taken as signed (-128 to 127): four characters
336   429E              ;         C moves on by 3 or 4. Uses A, DE, HL.
337   429E C5           putdec: push bc
338   429F 16 20                ld d, ' '
339   42A1 CD CA 42             call digits
340   42A4 C1                   pop bc
341   42A5 21 01 C1             ld hl, numbuf + 1
342   42A8 1E 03                ld e, 3
343   42AA 18 14                jr pnout
344   42AC C5           putsgn: push bc
345   42AD 16 20                ld d, ' '
346   42AF CB 7F                bit 7, a                ; the top bit is the sign
347   42B1 28 04                jr z, .pos
348   42B3 ED 44                neg                     ; two's complement: the size of the number
349   42B5 16 2D                ld d, '-'
350   42B7 CD CA 42     .pos:   call digits
351   42BA C1                   pop bc
352   42BB 21 00 C1             ld hl, numbuf
353   42BE 1E 04                ld e, 4
354   42C0 7E           pnout:  ld a, (hl)
355   42C1 CD 72 42             call putc
356   42C4 0C                   inc c
357   42C5 23                   inc hl
358   42C6 1D                   dec e
359   42C7 20 F7                jr nz, pnout
360   42C9 C9                   ret
361   42CA
362   42CA              ; digits: A (0-255) into numbuf in decimal, right-aligned, D just left of
363   42CA              ;         the first digit. Uses A, C, HL.
364   42CA 21 00 C1     digits: ld hl, numbuf
365   42CD 36 20                ld (hl), ' '
366   42CF 23                   inc hl
367   42D0 36 20                ld (hl), ' '
368   42D2 23                   inc hl
369   42D3 36 20                ld (hl), ' '
370   42D5 23                   inc hl
371   42D6 36 20                ld (hl), ' '            ; HL: the last character
372   42D8 0E 00        .next:  ld c, 0                 ; C: A divided by 10
373   42DA FE 0A        .ten:   cp 10
374   42DC 38 05                jr c, .rest
375   42DE D6 0A                sub 10
376   42E0 0C                   inc c
377   42E1 18 F7                jr .ten
378   42E3 C6 30        .rest:  add a, '0'
379   42E5 77                   ld (hl), a              ; the remainder is this digit
380   42E6 2B                   dec hl
381   42E7 79                   ld a, c
382   42E8 B7                   or a
383   42E9 20 ED                jr nz, .next            ; and the quotient is what is left
384   42EB 72                   ld (hl), d              ; the sign, or a space
385   42EC C9                   ret
386   42ED              numbuf  EQU VARS                ; 4 bytes of RAM
387   42ED              boxes:  ; characters 1 (empty box) and 2 (filled)
388   42ED FE 82 82 82          db %11111110, %10000010, %10000010, %10000010, %10000010, %10000010, %11111110, %00000000
388   42F1 82 82 FE 00
389   42F5 FE FE FE FE          db %11111110, %11111110, %11111110, %11111110, %11111110, %11111110, %11111110, %00000000
389   42F9 FE FE FE 00
