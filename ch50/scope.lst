 98   40F6 0C                   inc c                   ;  5
 99   40F7 C2 F0 40             jp nz, .wait            ; 11  44 T-states a turn
100   40FA DB A2        .quiet: in a, (PSG_READ)        ; 12  no edge in 256 turns: C = 0, and
101   40FC AB                   xor e                   ;  5  wait on for the one that ends
102   40FD F2 FA 40             jp p, .quiet            ; 11  the silence
103   4100 AB           .edge:  xor e                   ;  5  the input again
104   4101 5F                   ld e, a                 ;  5
105   4102 C9                   ret                     ; 11
106   4103
107   4103              ; header: waits for the tone before a block and measures it: D = twice
108   4103              ;         its mean pulse, in turns. A long pulse is twice a short one, and
109   4103              ;         every pulse is counted low: the work between two pulses eats
110   4103              ;         into them. Uses A, BC, HL
