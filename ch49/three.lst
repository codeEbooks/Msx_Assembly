  7   4010              VARS    EQU RAM_START + $100    ; the program's variables: the code is in ROM
  8   4010              SAMPLES EQU 9820             ; the samples of the sounds
  9   4010              ; The same sounds on three channels: each sample a row of vols, three volumes
 10   4010              ; whose levels add up to one of 256 steps, 7,919 samples a second.
 11   4010 F3           init:   di                      ; the interrupts off, the whole time
 12   4011 31 80 F3             ld sp, SYS_AREA
 13   4014 3E 07                ld a, 7
 14   4016 1E BF                ld e, $BF
 15   4018 CD 65 40             call psg                ; tones and noise shut: a channel is its volume
 16   401B 1E 00                ld e, 0
 17   401D 3E 08                ld a, 8
 18   401F CD 65 40             call psg
 19   4022 3E 09                ld a, 9
 20   4024 CD 65 40             call psg
 21   4027 3E 0A                ld a, 10
 22   4029 CD 65 40             call psg                ; the three silent
 23   402C 01 00 44             ld bc, sound
 24   402F 11 5C 26             ld de, SAMPLES
 25   4032 CD 37 40             call play3
 26   4035 18 FE        done:   jr done                 ; played: nothing more
 27   4037
 28   4037              ; play3: BC = the sound, a byte a sample; DE = its samples -> each byte's
 29   4037              ;        three volumes, from vols' three runs of 256, into R8, R9 and R10, a
 30   4037              ;        sample every 452 T-states. The interrupts must be off.
 31   4037              ;        Uses A, BC, DE, HL
 32   4037 21 00 41     play3:  ld hl, vols             ; 11  L = 0: the row the setup wrote
 33   403A 0A           .next:  ld a, (bc)              ;  8  the sample: a row of vols
 34   403B 6F                   ld l, a                 ;  5
 35   403C 3E 08                ld a, 8                 ;  8
 36   403E D3 A0                out (PSG_ADDR), a       ; 12
 37   4040 7E                   ld a, (hl)              ;  8
 38   4041 D3 A1                out (PSG_WRITE), a      ; 12  channel A's volume
 39   4043 24                   inc h                   ;  5
 40   4044 3E 09                ld a, 9                 ;  8
 41   4046 D3 A0                out (PSG_ADDR), a       ; 12
 42   4048 7E                   ld a, (hl)              ;  8
 43   4049 D3 A1                out (PSG_WRITE), a      ; 12  B's
 44   404B 24                   inc h                   ;  5
 45   404C 3E 0A                ld a, 10                ;  8
 46   404E D3 A0                out (PSG_ADDR), a       ; 12
 47   4050 7E                   ld a, (hl)              ;  8
 48   4051 D3 A1                out (PSG_WRITE), a      ; 12  C's
 49   4053 25                   dec h                   ;  5
 50   4054 25                   dec h                   ;  5
 51   4055 03                   inc bc                  ;  7
 52   4056 1B                   dec de                  ;  7
 53   4057 7A                   ld a, d                 ;  5
 54   4058 B3                   or e                    ;  5
 55   4059 C8                   ret z                   ; 12, or 6
 56   405A 00                   nop                     ;  5
 57   405B 00                   nop                     ;  5
 58   405C 3E 0F                ld a, 15                ;  8
 59   405E 3D           .wait:  dec a                   ;  5
 60   405F C2 5E 40             jp nz, .wait            ; 11  16 T-states a turn
 61   4062 C3 3A 40             jp .next                ; 11
 62   4065
 63   4065              ; psg: A = a register, E = a byte -> the byte in that register. Uses A
 64   4065 D3 A0        psg:    out (PSG_ADDR), a       ; 12  the register
