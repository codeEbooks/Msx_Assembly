  7   4010              VARS    EQU RAM_START + $100    ; the program's variables: the code is in ROM
  8   4010              SAMPLES EQU 9820             ; the samples of the sounds
  9   4010              ; The sounds on one channel: kick, hi-hat, snare, hi-hat, the vowel a,
 10   4010              ; 9,820 samples, 7,919 a second, each a volume of channel A, two to a byte.
 11   4010 F3           init:   di                      ; the interrupts off, the whole time
 12   4011 31 80 F3             ld sp, SYS_AREA
 13   4014 3E 07                ld a, 7
 14   4016 1E BF                ld e, $BF
 15   4018 CD 5A 40             call psg                ; tones and noise shut: a channel is its volume
 16   401B 1E 00                ld e, 0
 17   401D 3E 08                ld a, 8
 18   401F CD 5A 40             call psg
 19   4022 3E 09                ld a, 9
 20   4024 CD 5A 40             call psg
 21   4027 3E 0A                ld a, 10
 22   4029 CD 5A 40             call psg                ; the three silent
 23   402C 21 60 40             ld hl, sound
 24   402F 11 5C 26             ld de, SAMPLES
 25   4032 CD 37 40             call play1
 26   4035 18 FE        done:   jr done                 ; played: nothing more
 27   4037
 28   4037              ; play1: HL = the sound, two volumes a byte, the first in the high four bits;
 29   4037              ;        DE = its samples, an even number -> each volume into R8, channel
 30   4037              ;        A's, one every 452 T-states. The interrupts must be off.
 31   4037              ;        Uses A, B, DE, HL
 32   4037 3E 08        play1:  ld a, 8                 ;  8
 33   4039 D3 A0                out (PSG_ADDR), a       ; 12  R8 chosen, and left chosen
 34   403B CB 43        .next:  bit 0, e                ; 10  an odd count left: the low four bits
 35   403D 28 07                jr z, .high             ; 13, or 8
 36   403F 7E                   ld a, (hl)              ;  8
 37   4040 E6 0F                and 15                  ;  8  the low volume
 38   4042 23                   inc hl                  ;  7  and the next byte after it
 39   4043 00                   nop                     ;  5  this way as long as the other
 40   4044 18 07                jr .out                 ; 13
 41   4046 7E           .high:  ld a, (hl)              ;  8
 42   4047 0F                   rrca                    ;  5
 43   4048 0F                   rrca                    ;  5
 44   4049 0F                   rrca                    ;  5
 45   404A 0F                   rrca                    ;  5
 46   404B E6 0F                and 15                  ;  8  the high volume
 47   404D D3 A1        .out:   out (PSG_WRITE), a      ; 12  heard from here
 48   404F 1B                   dec de                  ;  7
 49   4050 7A                   ld a, d                 ;  5
 50   4051 B3                   or e                    ;  5
 51   4052 06 19                ld b, 25                ;  8
 52   4054 10 FE        .wait:  djnz .wait              ; 14, or 9
 53   4056 C2 3B 40             jp nz, .next            ; 11  DJNZ leaves the flags OR E set
 54   4059 C9                   ret                     ; 11
 55   405A
 56   405A              ; psg: A = a register, E = a byte -> the byte in that register. Uses A
 57   405A D3 A0        psg:    out (PSG_ADDR), a       ; 12  the register
 58   405C 7B                   ld a, e                 ;  5
 59   405D D3 A1                out (PSG_WRITE), a      ; 12  the byte
 60   405F C9                   ret                     ; 11
