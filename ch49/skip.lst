  9   4010              ; WHERE IT BREAKS. three.asm with a short way through the loop: a sample the
 10   4010              ; same as the one before writes nothing, and comes sooner.
 11   4010 F3           init:   di                      ; the interrupts off, the whole time
 12   4011 31 80 F3             ld sp, SYS_AREA
 13   4014 3E 07                ld a, 7
 14   4016 1E BF                ld e, $BF
 15   4018 CD 68 40             call psg                ; tones and noise shut: a channel is its volume
 16   401B 1E 00                ld e, 0
 17   401D 3E 08                ld a, 8
 18   401F CD 68 40             call psg
 19   4022 3E 09                ld a, 9
 20   4024 CD 68 40             call psg
 21   4027 3E 0A                ld a, 10
 22   4029 CD 68 40             call psg                ; the three silent
 23   402C 01 00 44             ld bc, sound
 24   402F 11 5C 26             ld de, SAMPLES
 25   4032 CD 37 40             call play3
 26   4035 18 FE        done:   jr done                 ; played: nothing more
 27   4037
 28   4037              ; play3: BC = the sound, a byte a sample; DE = its samples -> each byte's
 29   4037              ;        three volumes, from vols' three runs of 256, into R8, R9 and R10: a
 30   4037              ;        new sample in 465 T-states, one the same as the one before
 31   4037              ;        in 325. The interrupts must be off.
 32   4037              ;        Uses A, BC, DE, HL
 33   4037 21 00 41     play3:  ld hl, vols             ; 11  L = 0: the row the setup wrote
 34   403A 0A           .next:  ld a, (bc)              ;  8  the sample: a row of vols
 35   403B BD                   cp l                    ;  5  the same as the sample before?
 36   403C 28 1A                jr z, .same             ; 13, or 8  then nothing to write
 37   403E 6F                   ld l, a                 ;  5
 38   403F 3E 08                ld a, 8                 ;  8
 39   4041 D3 A0                out (PSG_ADDR), a       ; 12
 40   4043 7E                   ld a, (hl)              ;  8
 41   4044 D3 A1                out (PSG_WRITE), a      ; 12  channel A's volume
 42   4046 24                   inc h                   ;  5
 43   4047 3E 09                ld a, 9                 ;  8
 44   4049 D3 A0                out (PSG_ADDR), a       ; 12
 45   404B 7E                   ld a, (hl)              ;  8
 46   404C D3 A1                out (PSG_WRITE), a      ; 12  B's
 47   404E 24                   inc h                   ;  5
 48   404F 3E 0A                ld a, 10                ;  8
 49   4051 D3 A0                out (PSG_ADDR), a       ; 12
 50   4053 7E                   ld a, (hl)              ;  8
 51   4054 D3 A1                out (PSG_WRITE), a      ; 12  C's
 52   4056 25                   dec h                   ;  5
 53   4057 25                   dec h                   ;  5
 54   4058 03           .same:  inc bc                  ;  7
 55   4059 1B                   dec de                  ;  7
 56   405A 7A                   ld a, d                 ;  5
 57   405B B3                   or e                    ;  5
 58   405C C8                   ret z                   ; 12, or 6
 59   405D 00                   nop                     ;  5
 60   405E 00                   nop                     ;  5
 61   405F 3E 0F                ld a, 15                ;  8
 62   4061 3D           .wait:  dec a                   ;  5
 63   4062 C2 61 40             jp nz, .wait            ; 11  16 T-states a turn
 64   4065 C3 3A 40             jp .next                ; 11
