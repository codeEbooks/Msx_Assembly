 13+  4010              SETWRT   EQU $0053      ; the VDP's address set to HL, to write
 14+  4010              FILVRM   EQU $0056      ; BC bytes of A to the VRAM from HL
 15+  4010              LDIRVM   EQU $005C      ; BC bytes from HL to the VRAM at DE
 16+  4010              CHGMOD   EQU $005F      ; the screen mode in A
 17+  4010              INITXT   EQU $006C      ; text mode, 40 x 24, with the BIOS's tables (chapter 21)
 18+  4010              INIT32   EQU $006F      ; Graphic I, 32 x 24
 19+  4010              INIGRP   EQU $0072      ; Graphic II
 20+  4010              INIMLT   EQU $0075      ; multicolour
 21+  4010              CHSNS    EQU $009C      ; Z if no key waits in the buffer (chapter 34)
 22+  4010              CHGET    EQU $009F      ; wait for a key; A = its code
 23+  4010              CHPUT    EQU $00A2      ; print the character in A
 24+  4010              BEEP     EQU $00C0      ; a beep (C-BIOS: none)
 25+  4010              GTSTCK   EQU $00D5      ; A = 0: the cursor keys; A = their direction, 0-8
 26+  4010              GTTRIG   EQU $00D8      ; A = 0 SPACE, 1-4 a joystick's button: A = $FF if held
 27+  4010              SNSMAT   EQU $0141      ; A = the keys of keyboard row A, 0 = held (chapter 34)
 28+  4010
 29+  4010              ; two bytes of data: the VDP's ports, for programs that ask
