216   41B0 F5           isr:    push af
217   41B1 DB 99                in a, (VDP_CTRL)        ; the status: the signal down
218   41B3 3A 00 C1             ld a, (ticks)
219   41B6 3C                   inc a
220   41B7 32 00 C1             ld (ticks), a
221   41BA F1                   pop af
222   41BB FB                   ei
223   41BC C9                   ret
224   41BD
225   41BD              ; at: the next characters go to row D, column E (chapter 30)
226   41BD 7A           at:     ld a, d
227   41BE 0F                   rrca
228   41BF 0F                   rrca
229   41C0 0F                   rrca
230   41C1 4F                   ld c, a
231   41C2 E6 E0                and $E0
232   41C4 B3                   or e
233   41C5 D3 99                out (VDP_CTRL), a
234   41C7 79                   ld a, c
235   41C8 E6 03                and $03
236   41CA F6 58                or $18 | $40
237   41CC D3 99                out (VDP_CTRL), a
238   41CE C9                   ret
239   41CF
240   41CF              ; cells: A as eight boxes from bit 7, a filled box for a 0 (a key held) and
241   41CF              ; an empty one for a 1, from the address set. Uses A, B, L
242   41CF 6F           cells:  ld l, a
243   41D0 06 08                ld b, 8
244   41D2 3E 02        .cell:  ld a, 2
245   41D4 CB 05                rlc l                   ; the next bit, into the carry
246   41D6 30 02                jr nc, .put             ; 0: held
247   41D8 3E 01                ld a, 1
248   41DA D3 98        .put:   out (VDP_DATA), a
249   41DC 10 F4                djnz .cell
250   41DE C9                   ret
251   41DF
252   41DF              ; hex: A as two hexadecimal digits, from the address set. Uses A, C
253   41DF 4F           hex:    ld c, a
254   41E0 0F                   rrca
255   41E1 0F                   rrca
256   41E2 0F                   rrca
257   41E3 0F                   rrca
258   41E4 CD E8 41             call .digit
259   41E7 79                   ld a, c
260   41E8 E6 0F        .digit: and $0F
261   41EA C6 30                add a, '0'
262   41EC FE 3A                cp '9' + 1
263   41EE 38 02                jr c, .out
264   41F0 C6 07                add a, 'A' - '9' - 1
265   41F2 D3 98        .out:   out (VDP_DATA), a
266   41F4 C9                   ret
267   41F5
268   41F5              ; send: E blocks of 256 bytes from HL to the VDP
269   41F5 0E 98        send:   ld c, VDP_DATA
270   41F7 06 00                ld b, 0
271   41F9 ED B3        .otir:  otir
272   41FB 1D                   dec e
273   41FC 20 FB                jr nz, .otir
274   41FE C9                   ret
