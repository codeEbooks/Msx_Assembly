189   41DB C9                   ret                     ; 11
190   41DC
191   41DC              ; putbcd: A = a BCD byte, the VRAM address set -> its two digits sent: in the
192   41DC              ; status third a digit is its own name. Uses A, C
193   41DC 4F           putbcd: ld c, a                 ;  5  kept for the second digit
194   41DD 0F                   rrca                    ;  5
195   41DE 0F                   rrca                    ;  5
196   41DF 0F                   rrca                    ;  5
197   41E0 0F                   rrca                    ;  5  the first digit to bits 3 to 0
198   41E1 E6 0F                and $0F                 ;  8  and nothing else: its own name
199   41E3 D3 98                out (VDP_DATA), a       ; 12
200   41E5 79                   ld a, c                 ;  5
201   41E6 E6 0F                and $0F                 ;  8  the second digit
202   41E8 00                   nop                     ;  5  30 T-states after the first OUT
203   41E9 D3 98                out (VDP_DATA), a       ; 12
204   41EB C9                   ret                     ; 11
205   41EC
206   41EC              ; best: score against hi, the first digits first -> hi is score when score
207   41EC              ; is higher. Uses A, BC, DE, HL
208   41EC 21 00 C4     best:   ld hl, score            ; 11
209   41EF 11 03 C4             ld de, hi               ; 11
210   41F2 06 03                ld b, 3                 ;  8  three bytes
211   41F4 1A           .byte:  ld a, (de)              ;  8  a byte of hi
212   41F5 BE                   cp (hl)                 ;  8  less the same byte of score
213   41F6 38 06                jr c, .new              ; 13, or 8  score's is higher: a new best
214   41F8 C0                   ret nz                  ; 12, or 6  hi's is higher
215   41F9 2C                   inc l                   ;  5
216   41FA 1C                   inc e                   ;  5  the same: the next byte decides
217   41FB 10 F7                djnz .byte              ; 14, or 9
218   41FD C9                   ret                     ; 11  the same number
219   41FE 48           .new:   ld c, b                 ;  5  the bytes from here on, this one too;
220   41FF 06 00                ld b, 0                 ;  8  the ones before are the same
221   4201 ED B0                ldir                    ; 23, and 18 the last time
222   4203 C9                   ret                     ; 11
223   4204
224   4204              ; addsc: A = points, two BCD digits -> added to score, the carry taken into
225   4204              ; the digits before with ADC and DAA (chapter 9). Uses A, HL
226   4204 21 02 C4     addsc:  ld hl, score + 2        ; 11  the last two digits
227   4207 86                   add a, (hl)             ;  8
228   4208 27                   daa                     ;  5
229   4209 77                   ld (hl), a              ;  8
230   420A 2D                   dec l                   ;  5  DEC L leaves the carry alone
231   420B 7E                   ld a, (hl)              ;  8
232   420C CE 00                adc a, 0                ;  8
233   420E 27                   daa                     ;  5
234   420F 77                   ld (hl), a              ;  8
235   4210 2D                   dec l                   ;  5
236   4211 7E                   ld a, (hl)              ;  8
237   4212 CE 00                adc a, 0                ;  8
238   4214 27                   daa                     ;  5
239   4215 77                   ld (hl), a              ;  8
240   4216 C9                   ret                     ; 11
241   4217
242   4217              ; say: HL = a text ending in a 0 byte, DE = the VRAM address of its first
243   4217              ; character, bit 6 set -> the text sent, HL on its 0. Uses A, HL
244   4217 7B           say:    ld a, e                 ;  5
245   4218 D3 99                out (VDP_CTRL), a       ; 12
246   421A 7A                   ld a, d                 ;  5
247   421B D3 99                out (VDP_CTRL), a       ; 12  the address of the first character
248   421D 7E           .char:  ld a, (hl)              ;  8  the next character
249   421E B7                   or a                    ;  5
250   421F C8                   ret z                   ; 12, or 6  the 0: the end
251   4220 D3 98                out (VDP_DATA), a       ; 12
252   4222 23                   inc hl                  ;  7
253   4223 18 F8                jr .char                ; 13
254   4225
255   4225              ; isr: every frame. The status read, which lets the signal down; the frame
256   4225              ; counted. Keeps AF, HL
257   4225 F5           isr:    push af
258   4226 DB 99                in a, (VDP_CTRL)        ; the status: the signal down
259   4228 E5                   push hl
260   4229 2A 00 C1             ld hl, (ticks)
261   422C 23                   inc hl
262   422D 22 00 C1             ld (ticks), hl
263   4230 E1                   pop hl
264   4231 F1                   pop af
265   4232 FB                   ei
266   4233 C9                   ret
267   4234
268   4234              ; send: B bytes (256 for 0) from HL to the VDP, the address set; HL after
269   4234              ; them. The display is off
270   4234 7E           send:   ld a, (hl)
271   4235 D3 98                out (VDP_DATA), a
