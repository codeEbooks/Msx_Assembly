186   41E1 10 F9                djnz .byte              ; 14, or 9
187   41E3 C9                   ret                     ; 11
188   41E4
189   41E4              ; putbcd: A = a BCD byte, the VRAM address set -> its two digits sent: in the
190   41E4              ; status third a digit is its own name. Uses A, C
191   41E4 4F           putbcd: ld c, a                 ;  5  kept for the second digit
192   41E5 0F                   rrca                    ;  5
193   41E6 0F                   rrca                    ;  5
194   41E7 0F                   rrca                    ;  5
195   41E8 0F                   rrca                    ;  5  the first digit to bits 3 to 0
196   41E9 E6 0F                and $0F                 ;  8  and nothing else: its own name
197   41EB D3 98                out (VDP_DATA), a       ; 12
198   41ED 79                   ld a, c                 ;  5
199   41EE E6 0F                and $0F                 ;  8  the second digit
200   41F0 00                   nop                     ;  5  30 T-states after the first OUT
201   41F1 D3 98                out (VDP_DATA), a       ; 12
202   41F3 C9                   ret                     ; 11
203   41F4
204   41F4              ; best: score against hi, the first digits first -> hi is score when score
205   41F4              ; is higher. Uses A, BC, DE, HL
206   41F4 21 00 C4     best:   ld hl, score            ; 11
207   41F7 11 03 C4             ld de, hi               ; 11
208   41FA 06 03                ld b, 3                 ;  8  three bytes
209   41FC 1A           .byte:  ld a, (de)              ;  8  a byte of hi
210   41FD BE                   cp (hl)                 ;  8  less the same byte of score
211   41FE 38 06                jr c, .new              ; 13, or 8  score's is higher: a new best
212   4200 C0                   ret nz                  ; 12, or 6  hi's is higher
213   4201 2C                   inc l                   ;  5
214   4202 1C                   inc e                   ;  5  the same: the next byte decides
215   4203 10 F7                djnz .byte              ; 14, or 9
216   4205 C9                   ret                     ; 11  the same number
217   4206 48           .new:   ld c, b                 ;  5  the bytes from here on, this one too;
218   4207 06 00                ld b, 0                 ;  8  the ones before are the same
219   4209 ED B0                ldir                    ; 23, and 18 the last time
220   420B C9                   ret                     ; 11
221   420C
222   420C              ; addsc: A = points, two BCD digits -> added to score, the carry taken into
223   420C              ; the digits before with ADC and DAA (chapter 9). Uses A, HL
224   420C 21 02 C4     addsc:  ld hl, score + 2        ; 11  the last two digits
225   420F 86                   add a, (hl)             ;  8
226   4210 27                   daa                     ;  5
227   4211 77                   ld (hl), a              ;  8
228   4212 2D                   dec l                   ;  5  DEC L leaves the carry alone
229   4213 7E                   ld a, (hl)              ;  8
230   4214 CE 00                adc a, 0                ;  8
231   4216 27                   daa                     ;  5
232   4217 77                   ld (hl), a              ;  8
233   4218 2D                   dec l                   ;  5
234   4219 7E                   ld a, (hl)              ;  8
235   421A CE 00                adc a, 0                ;  8
236   421C 27                   daa                     ;  5
237   421D 77                   ld (hl), a              ;  8
238   421E C9                   ret                     ; 11
239   421F
240   421F              ; say: HL = a text ending in a 0 byte, DE = the VRAM address of its first
241   421F              ; character, bit 6 set -> the text sent, HL on its 0. Uses A, HL
242   421F 7B           say:    ld a, e                 ;  5
243   4220 D3 99                out (VDP_CTRL), a       ; 12
244   4222 7A                   ld a, d                 ;  5
245   4223 D3 99                out (VDP_CTRL), a       ; 12  the address of the first character
246   4225 7E           .char:  ld a, (hl)              ;  8  the next character
247   4226 B7                   or a                    ;  5
248   4227 C8                   ret z                   ; 12, or 6  the 0: the end
249   4228 D3 98                out (VDP_DATA), a       ; 12
250   422A 23                   inc hl                  ;  7
251   422B 18 F8                jr .char                ; 13
252   422D
253   422D              ; isr: every frame. The status read, which lets the signal down; the frame
254   422D              ; counted. Keeps AF, HL
255   422D F5           isr:    push af
256   422E DB 99                in a, (VDP_CTRL)        ; the status: the signal down
257   4230 E5                   push hl
258   4231 2A 00 C1             ld hl, (ticks)
259   4234 23                   inc hl
260   4235 22 00 C1             ld (ticks), hl
261   4238 E1                   pop hl
262   4239 F1                   pop af
263   423A FB                   ei
264   423B C9                   ret
265   423C
266   423C              ; send: B bytes (256 for 0) from HL to the VDP, the address set; HL after
267   423C              ; them. The display is off
268   423C 7E           send:   ld a, (hl)
269   423D D3 98                out (VDP_DATA), a
270   423F 23                   inc hl
271   4240 10 FA                djnz send
272   4242 C9                   ret
273   4243
274   4243              ; fill: BC bytes of A to the VDP, the address set. The display is off
275   4243 5F           fill:   ld e, a
276   4244 7B           .byte:  ld a, e
