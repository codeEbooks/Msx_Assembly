  9   4010              ; status.asm: the score and HI on a status line in a third of the screen of
 10   4010              ; its own, where a BCD digit is its own name. In each of 128 frames, after
 11   4010              ; HALT, the pairs of digits that changed are sent at once, then the points
 12   4010              ; and the frame's other work; GAME OVER after the last.
 13   4010              ticks   EQU VARS                ; frames counted by isr, two bytes
 14   4010              count   EQU VARS + 2            ; the frames of the game
 15   4010              worktab EQU VARS + 3            ; the work table for 50 or 60 Hz
 16   4010              score   EQU $C400               ; six BCD digits, the first two first
 17   4010              hi      EQU $C403               ; the best score
 18   4010              shown   EQU $C500               ; the copies of score and hi on the screen
 19   4010              SCORE_AT EQU $1A07            ; the score's first digit: row 16, column 7
 20   4010              HI_AT   EQU $1A18               ; hi's: column 24
 21   4010              OVER_AT EQU $1A8B               ; GAME OVER: row 20, column 11
 22   4010              FRAMES  EQU 128
 23   4010              IM2_TABLE EQU $C200             ; 257 bytes of $C3: every vector is $C3C3
 24   4010              IM2_JUMP  EQU $C3C3             ; and there, a JP to the routine
