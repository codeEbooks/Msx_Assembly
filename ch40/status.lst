188   41D9 1C                   inc e                   ;  5  past its two names
189   41DA 25                   dec h                   ;  5  back to the number
190   41DB 2C                   inc l                   ;  5  and its next byte
191   41DC 10 E9                djnz .byte              ; 14, or 9
192   41DE C9                   ret                     ; 11
193   41DF
194   41DF              ; putbcd: A = a BCD byte, the VRAM address set -> its two digits sent: in the
195   41DF              ; status third a digit is its own name. Uses A, C
196   41DF 4F           putbcd: ld c, a                 ;  5  kept for the second digit
197   41E0 0F                   rrca                    ;  5
198   41E1 0F                   rrca                    ;  5
199   41E2 0F                   rrca                    ;  5
200   41E3 0F                   rrca                    ;  5  the first digit to bits 3 to 0
201   41E4 E6 0F                and $0F                 ;  8  and nothing else: its own name
202   41E6 D3 98                out (VDP_DATA), a       ; 12
203   41E8 79                   ld a, c                 ;  5
204   41E9 E6 0F                and $0F                 ;  8  the second digit
205   41EB 00                   nop                     ;  5  30 T-states after the first OUT
206   41EC D3 98                out (VDP_DATA), a       ; 12
207   41EE C9                   ret                     ; 11
208   41EF
209   41EF              ; best: score against hi, the first digits first -> hi is score when score
210   41EF              ; is higher. Uses A, BC, DE, HL
211   41EF 21 00 C4     best:   ld hl, score            ; 11
212   41F2 11 03 C4             ld de, hi               ; 11
213   41F5 06 03                ld b, 3                 ;  8  three bytes
214   41F7 1A           .byte:  ld a, (de)              ;  8  a byte of hi
215   41F8 BE                   cp (hl)                 ;  8  less the same byte of score
216   41F9 38 06                jr c, .new              ; 13, or 8  score's is higher: a new best
217   41FB C0                   ret nz                  ; 12, or 6  hi's is higher
218   41FC 2C                   inc l                   ;  5
219   41FD 1C                   inc e                   ;  5  the same: the next byte decides
220   41FE 10 F7                djnz .byte              ; 14, or 9
221   4200 C9                   ret                     ; 11  the same number
222   4201 48           .new:   ld c, b                 ;  5  the bytes from here on, this one too;
223   4202 06 00                ld b, 0                 ;  8  the ones before are the same
224   4204 ED B0                ldir                    ; 23, and 18 the last time
225   4206 C9                   ret                     ; 11
226   4207
227   4207              ; addsc: A = points, two BCD digits -> added to score, the carry taken into
228   4207              ; the digits before with ADC and DAA (chapter 9). Uses A, HL
229   4207 21 02 C4     addsc:  ld hl, score + 2        ; 11  the last two digits
230   420A 86                   add a, (hl)             ;  8
231   420B 27                   daa                     ;  5
232   420C 77                   ld (hl), a              ;  8
233   420D 2D                   dec l                   ;  5  DEC L leaves the carry alone
234   420E 7E                   ld a, (hl)              ;  8
235   420F CE 00                adc a, 0                ;  8
236   4211 27                   daa                     ;  5
237   4212 77                   ld (hl), a              ;  8
238   4213 2D                   dec l                   ;  5
239   4214 7E                   ld a, (hl)              ;  8
240   4215 CE 00                adc a, 0                ;  8
241   4217 27                   daa                     ;  5
242   4218 77                   ld (hl), a              ;  8
243   4219 C9                   ret                     ; 11
244   421A
245   421A              ; say: HL = a text ending in a 0 byte, DE = the VRAM address of its first
246   421A              ; character, bit 6 set -> the text sent, HL on its 0. Uses A, HL
247   421A 7B           say:    ld a, e                 ;  5
248   421B D3 99                out (VDP_CTRL), a       ; 12
249   421D 7A                   ld a, d                 ;  5
250   421E D3 99                out (VDP_CTRL), a       ; 12  the address of the first character
251   4220 7E           .char:  ld a, (hl)              ;  8  the next character
252   4221 B7                   or a                    ;  5
253   4222 C8                   ret z                   ; 12, or 6  the 0: the end
254   4223 D3 98                out (VDP_DATA), a       ; 12
255   4225 23                   inc hl                  ;  7
256   4226 18 F8                jr .char                ; 13
257   4228
258   4228              ; isr: every frame. The status read, which lets the signal down; the frame
259   4228              ; counted. Keeps AF, HL
260   4228 F5           isr:    push af
261   4229 DB 99                in a, (VDP_CTRL)        ; the status: the signal down
262   422B E5                   push hl
263   422C 2A 00 C1             ld hl, (ticks)
264   422F 23                   inc hl
265   4230 22 00 C1             ld (ticks), hl
266   4233 E1                   pop hl
267   4234 F1                   pop af
268   4235 FB                   ei
269   4236 C9                   ret
270   4237
271   4237              ; send: B bytes (256 for 0) from HL to the VDP, the address set; HL after
272   4237              ; them. The display is off
273   4237 7E           send:   ld a, (hl)
274   4238 D3 98                out (VDP_DATA), a
275   423A 23                   inc hl
276   423B 10 FA                djnz send
277   423D C9                   ret
