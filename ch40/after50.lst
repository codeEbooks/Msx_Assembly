187   41D3              ; putbcd: A = a BCD byte, the VRAM address set -> its two digits sent: in the
188   41D3              ; status third a digit is its own name. Uses A, C
189   41D3 4F           putbcd: ld c, a                 ;  5  kept for the second digit
190   41D4 0F                   rrca                    ;  5
191   41D5 0F                   rrca                    ;  5
192   41D6 0F                   rrca                    ;  5
193   41D7 0F                   rrca                    ;  5  the first digit to bits 3 to 0
194   41D8 E6 0F                and $0F                 ;  8  and nothing else: its own name
195   41DA D3 98                out (VDP_DATA), a       ; 12
196   41DC 79                   ld a, c                 ;  5
197   41DD E6 0F                and $0F                 ;  8  the second digit
198   41DF 00                   nop                     ;  5  30 T-states after the first OUT
199   41E0 D3 98                out (VDP_DATA), a       ; 12
200   41E2 C9                   ret                     ; 11
201   41E3
202   41E3              ; best: score against hi, the first digits first -> hi is score when score
203   41E3              ; is higher. Uses A, BC, DE, HL
204   41E3 21 00 C4     best:   ld hl, score            ; 11
205   41E6 11 03 C4             ld de, hi               ; 11
206   41E9 06 03                ld b, 3                 ;  8  three bytes
207   41EB 1A           .byte:  ld a, (de)              ;  8  a byte of hi
208   41EC BE                   cp (hl)                 ;  8  less the same byte of score
209   41ED 38 06                jr c, .new              ; 13, or 8  score's is higher: a new best
210   41EF C0                   ret nz                  ; 12, or 6  hi's is higher
211   41F0 2C                   inc l                   ;  5
212   41F1 1C                   inc e                   ;  5  the same: the next byte decides
213   41F2 10 F7                djnz .byte              ; 14, or 9
214   41F4 C9                   ret                     ; 11  the same number
215   41F5 48           .new:   ld c, b                 ;  5  the bytes from here on, this one too;
216   41F6 06 00                ld b, 0                 ;  8  the ones before are the same
217   41F8 ED B0                ldir                    ; 23, and 18 the last time
218   41FA C9                   ret                     ; 11
219   41FB
220   41FB              ; addsc: A = points, two BCD digits -> added to score, the carry taken into
221   41FB              ; the digits before with ADC and DAA (chapter 9). Uses A, HL
222   41FB 21 02 C4     addsc:  ld hl, score + 2        ; 11  the last two digits
223   41FE 86                   add a, (hl)             ;  8
224   41FF 27                   daa                     ;  5
225   4200 77                   ld (hl), a              ;  8
226   4201 2D                   dec l                   ;  5  DEC L leaves the carry alone
227   4202 7E                   ld a, (hl)              ;  8
228   4203 CE 00                adc a, 0                ;  8
229   4205 27                   daa                     ;  5
230   4206 77                   ld (hl), a              ;  8
231   4207 2D                   dec l                   ;  5
232   4208 7E                   ld a, (hl)              ;  8
233   4209 CE 00                adc a, 0                ;  8
234   420B 27                   daa                     ;  5
235   420C 77                   ld (hl), a              ;  8
236   420D C9                   ret                     ; 11
237   420E
238   420E              ; say: HL = a text ending in a 0 byte, DE = the VRAM address of its first
239   420E              ; character, bit 6 set -> the text sent, HL on its 0. Uses A, HL
240   420E 7B           say:    ld a, e                 ;  5
241   420F D3 99                out (VDP_CTRL), a       ; 12
242   4211 7A                   ld a, d                 ;  5
243   4212 D3 99                out (VDP_CTRL), a       ; 12  the address of the first character
244   4214 7E           .char:  ld a, (hl)              ;  8  the next character
245   4215 B7                   or a                    ;  5
246   4216 C8                   ret z                   ; 12, or 6  the 0: the end
247   4217 D3 98                out (VDP_DATA), a       ; 12
248   4219 23                   inc hl                  ;  7
249   421A 18 F8                jr .char                ; 13
250   421C
251   421C              ; isr: every frame. The status read, which lets the signal down; the frame
252   421C              ; counted. Keeps AF, HL
253   421C F5           isr:    push af
254   421D DB 99                in a, (VDP_CTRL)        ; the status: the signal down
255   421F E5                   push hl
256   4220 2A 00 C1             ld hl, (ticks)
257   4223 23                   inc hl
258   4224 22 00 C1             ld (ticks), hl
259   4227 E1                   pop hl
260   4228 F1                   pop af
261   4229 FB                   ei
262   422A C9                   ret
263   422B
264   422B              ; send: B bytes (256 for 0) from HL to the VDP, the address set; HL after
265   422B              ; them. The display is off
266   422B 7E           send:   ld a, (hl)
267   422C D3 98                out (VDP_DATA), a
268   422E 23                   inc hl
269   422F 10 FA                djnz send
270   4231 C9                   ret
271   4232
272   4232              ; fill: BC bytes of A to the VDP, the address set. The display is off
273   4232 5F           fill:   ld e, a
274   4233 7B           .byte:  ld a, e
275   4234 D3 98                out (VDP_DATA), a
276   4236 0B                   dec bc
277   4237 78                   ld a, b
278   4238 B1                   or c
279   4239 20 F8                jr nz, .byte
280   423B C9                   ret
