  3+  0000
  4+  0000              VDP_DATA    EQU $98         ; VRAM data, read and write
  5+  0000              VDP_CTRL    EQU $99         ; write: register / address set-up; read: status
  6+  0000              PSG_ADDR    EQU $A0         ; PSG register select
  7+  0000              PSG_WRITE   EQU $A1         ; PSG data write
  8+  0000              PSG_READ    EQU $A2         ; PSG data read
  9+  0000              PPI_A       EQU $A8         ; primary slot register
 10+  0000              PPI_B       EQU $A9         ; keyboard columns (read)
 11+  0000              PPI_C       EQU $AA         ; keyboard row (bits 0-3), cassette, CAPS LED, click
 12+  0000              PPI_MODE    EQU $AB         ; PPI control
 13+  0000
 14+  0000              RAM_START   EQU $C000       ; the book's 16 KB floor: $C000-$FFFF
 15+  0000              SYS_AREA    EQU $F380       ; BIOS work area starts here: programs stay below
 16+  0000              CGTABL      EQU $0004       ; BIOS: the address of the character set (2 bytes)
 17+  0000
 18+  0000              ; the sixteen colour codes of the VDP (chapter 1 photographed them)
 19+  0000              TRANSPARENT  EQU 0
 20+  0000              BLACK        EQU 1
 21+  0000              MEDIUM_GREEN EQU 2
 22+  0000              LIGHT_GREEN  EQU 3
 23+  0000              DARK_BLUE    EQU 4
 24+  0000              LIGHT_BLUE   EQU 5
 25+  0000              DARK_RED     EQU 6
 26+  0000              CYAN         EQU 7
 27+  0000              MEDIUM_RED   EQU 8
 28+  0000              LIGHT_RED    EQU 9
 29+  0000              DARK_YELLOW  EQU 10
 30+  0000              LIGHT_YELLOW EQU 11
 31+  0000              DARK_GREEN   EQU 12
 32+  0000              MAGENTA      EQU 13
 33+  0000              GREY         EQU 14
 34+  0000              WHITE        EQU 15
 35+  0000
 36+  0000              ; cartridge header: "AB", INIT, STATEMENT, DEVICE, TEXT, 6 reserved bytes
 37+  0000                  MACRO CART_HEADER init_addr
 38+  0000 ~                    db "AB"
 39+  0000 ~                    dw init_addr
 40+  0000 ~                    dw 0, 0, 0
 41+  0000 ~                    ds 6, 0
 42+  0000                  ENDM
 43+  0000
 44+  0000              ; write value to VDP register reg (2 OUTs; interrupts must be off)
 45+  0000                  MACRO VDP_REG reg, value
 46+  0000 ~                    ld a, value
 47+  0000 ~                    out (VDP_CTRL), a
 48+  0000 ~                    ld a, $80 | (reg)
 49+  0000 ~                    out (VDP_CTRL), a
 50+  0000                  ENDM
 51+  0000
 52+  0000              ; set the VRAM write address (2 OUTs; interrupts must be off)
 53+  0000                  MACRO VRAM_WRITE addr
 54+  0000 ~                    ld a, low (addr)
 55+  0000 ~                    out (VDP_CTRL), a
 56+  0000 ~                    ld a, high (addr) | $40
 57+  0000 ~                    out (VDP_CTRL), a
 58+  0000                  ENDM
 59+  0000
