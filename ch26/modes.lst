 59+  4010              PUTPNT   EQU $F3F8      ; where the next key goes into the key buffer
 60+  4010              GETPNT   EQU $F3FA      ; where CHGET takes the next one from
 61+  4010              JIFFY    EQU $FC9E      ; one more every frame interrupt
 62+  4010              SCRMOD   EQU $FCAF      ; the screen mode
 63+  4010              EXPTBL   EQU $FCC1      ; which slots are expanded
