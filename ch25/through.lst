292   41E9 6F                   ld l, a                 ;  5
293   41EA 79                   ld a, c                 ;  5
294   41EB E6 07                and 7                   ;  8: the line in the cell
295   41ED B5                   or l                    ;  5
296   41EE 6F                   ld l, a                 ;  5
297   41EF C9                   ret                     ; 11
