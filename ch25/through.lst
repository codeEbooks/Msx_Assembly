237   41A2 2C                   inc l                   ;  5  a line down (chapter 22's down)
238   41A3 7D                   ld a, l                 ;  5
239   41A4 E6 07                and 7                   ;  8
240   41A6 20 05                jr nz, tslsm            ; 13, or 8
