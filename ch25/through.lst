273   41D1              ; clear: the 6,144 bytes of the buffer set to 0
274   41D1 21 00 C8     clear:  ld hl, BUF              ; 11
275   41D4 11 01 C8             ld de, BUF + 1          ; 11
276   41D7 01 FF 17             ld bc, 6143             ; 11
277   41DA 36 00                ld (hl), 0              ; 11
278   41DC ED B0                ldir                    ; 23 a byte, 18 the last
279   41DE C9                   ret                     ; 11
280   41DF
281   41DF              ; vaddr: B = x, C = y -> HL = the address of the byte that holds pixel (x, y),
282   41DF              ; in the patterns of a Graphic II screen whose names run 0 to 255 in each
283   41DF              ; third (chapter 22). Uses A.
284   41DF 79           vaddr:  ld a, c                 ;  5
