247   41B0 08                   ex af, af'              ;  5
248   41B1 10 DE                djnz tslpx              ; 14, or 9
249   41B3 C9                   ret                     ; 11
250   41B4 83           tsldn:  add a, e                ;  5  below zero: dy back,
251   41B5 08                   ex af, af'              ;  5
252   41B6 CB 01                rlc c                   ; 10  and a pixel left:
253   41B8 30 04                jr nc, tslnx            ; 13, or 8  in the same byte, or
