260   41C1              ; tfirst: B = x, C = y -> HL: the byte of pixel (x, y), C: its mask
261   41C1 CD DF 41     tfirst: call vaddr              ; 18
262   41C4 7C                   ld a, h                 ;  5  in the buffer
263   41C5 C6 C8                add a, BUF_H            ;  8
264   41C7 67                   ld h, a                 ;  5
265   41C8 78                   ld a, b                 ;  5
266   41C9 E6 07                and 7                   ;  8
267   41CB 4F                   ld c, a                 ;  5
268   41CC 06 43                ld b, high masks        ;  8
