222   4188 10 E9                djnz rslpx              ; 14, or 9
223   418A C9                   ret                     ; 11
224   418B 83           rsldn:  add a, e                ;  5  below zero: dy back,
225   418C 08                   ex af, af'              ;  5
226   418D CB 01                rlc c                   ; 10  and a pixel left:
227   418F 30 04                jr nc, rslnx            ; 13, or 8  in the same byte, or
228   4191 7D                   ld a, l                 ;  5  in the next, 8 back
229   4192 D6 08                sub 8                   ;  8
230   4194 6F                   ld l, a                 ;  5
231   4195 10 DC        rslnx:  djnz rslpx              ; 14, or 9
232   4197 C9                   ret                     ; 11
233   4198
234   4198              ; rfirst: B = x, C = y -> HL: the byte of pixel (x, y), C: its mask
235   4198 CD D0 41     rfirst: call vaddr              ; 18
236   419B 7C                   ld a, h                 ;  5  in the buffer
237   419C C6 C8                add a, BUF_H            ;  8
238   419E 67                   ld h, a                 ;  5
239   419F 78                   ld a, b                 ;  5
240   41A0 E6 07                and 7                   ;  8
241   41A2 4F                   ld c, a                 ;  5
242   41A3 06 43                ld b, high masks        ;  8
243   41A5 0A                   ld a, (bc)              ;  8
244   41A6 4F                   ld c, a                 ;  5
245   41A7 C9                   ret                     ; 11
246   41A8
247   41A8              ; clear: the 6,144 bytes of the buffer set to 0
248   41A8 21 00 C8     clear:  ld hl, BUF              ; 11
249   41AB 11 01 C8             ld de, BUF + 1          ; 11
250   41AE 01 FF 17             ld bc, 6143             ; 11
251   41B1 36 00                ld (hl), 0              ; 11
252   41B3 ED B0                ldir                    ; 23 a byte, 18 the last
253   41B5 C9                   ret                     ; 11
254   41B6
255   41B6              ; send: the buffer to the patterns, 29 T-states a byte (chapter 20)
256   41B6              send:   VRAM_WRITE $0000        ; 34  the patterns
256   41B6 3E 00       >        ld a, low ($0000)
256   41B8 D3 99       >        out (VDP_CTRL), a
256   41BA 3E 40       >        ld a, high ($0000) | $40
256   41BC D3 99       >        out (VDP_CTRL), a
257   41BE 21 00 C8             ld hl, BUF              ; 11
258   41C1 0E 98                ld c, VDP_DATA          ;  8
259   41C3 16 18                ld d, 24                ;  8  24 x 256 bytes
260   41C5 06 00        sendp:  ld b, 0                 ;  8
261   41C7 ED A3        sendb:  outi                    ; 18
262   41C9 C2 C7 41             jp nz, sendb            ; 11
263   41CC 15                   dec d                   ;  5
264   41CD 20 F6                jr nz, sendp            ; 13, or 8
265   41CF C9                   ret                     ; 11
266   41D0
267   41D0              ; vaddr: B = x, C = y -> HL = the address of the byte that holds pixel (x, y),
268   41D0              ; in the patterns of a Graphic II screen whose names run 0 to 255 in each
269   41D0              ; third (chapter 22). Uses A.
270   41D0 79           vaddr:  ld a, c                 ;  5
271   41D1 0F                   rrca                    ;  5
272   41D2 0F                   rrca                    ;  5
273   41D3 0F                   rrca                    ;  5
274   41D4 E6 1F                and $1F                 ;  8: y / 8, the row of characters
275   41D6 67                   ld h, a                 ;  5
276   41D7 78                   ld a, b                 ;  5
277   41D8 E6 F8                and $F8                 ;  8: the column of characters, x 8
278   41DA 6F                   ld l, a                 ;  5
279   41DB 79                   ld a, c                 ;  5
280   41DC E6 07                and 7                   ;  8: the line in the cell
281   41DE B5                   or l                    ;  5
282   41DF 6F                   ld l, a                 ;  5
283   41E0 C9                   ret                     ; 11
284   41E1              ends:
