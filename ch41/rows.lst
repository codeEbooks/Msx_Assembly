  9   4010              ; rows.asm: a row from 0 to 23 three ways, over random's period: by
 10   4010              ; rejection, by multiplication and by remainder; the rows counted.
 11   4010              seed    EQU VARS                ; random's state, two bytes
 12   4010              seed8   EQU VARS + 2            ; lcg's
 13   4010              num     EQU VARS + 3            ; strips: the number, and the bits left
 14   4010              left    EQU VARS + 4
 15   4010              counts  EQU $C400               ; rows.asm: 3 x 24 counts of two bytes
 16   4010 F3           init:   di
 17   4011 31 80 F3             ld sp, SYS_AREA
 18   4014 21 00 C4             ld hl, counts           ; the counts: 3 x 24 rows, two bytes each
 19   4017 11 01 C4             ld de, counts + 1
 20   401A 01 8F 00             ld bc, 3 * 48 - 1
 21   401D 36 00                ld (hl), 0
 22   401F ED B0                ldir
 23   4021 21 01 00             ld hl, 1
