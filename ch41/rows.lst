 25   4027 21 FF FF             ld hl, 65535
 26   402A E5           rj1:    push hl
 27   402B CD 96 40             call rowrej
 28   402E 21 00 C4             ld hl, counts
 29   4031 CD 74 40             call count
 30   4034 E1                   pop hl
 31   4035 2B                   dec hl
 32   4036 7C                   ld a, h
 33   4037 B5                   or l
 34   4038 20 F0                jr nz, rj1
 35   403A              rejected:
 36   403A 21 01 00             ld hl, 1
 37   403D 22 00 C1             ld (seed), hl
 38   4040 21 FF FF             ld hl, 65535
 39   4043 E5           mu1:    push hl
 40   4044 CD 7C 40             call random
 41   4047 CD A0 40             call rowmul
 42   404A 21 30 C4             ld hl, counts + 48
 43   404D CD 74 40             call count
 44   4050 E1                   pop hl
 45   4051 2B                   dec hl
 46   4052 7C                   ld a, h
 47   4053 B5                   or l
 48   4054 20 ED                jr nz, mu1
 49   4056              multiplied:
 50   4056 21 01 00             ld hl, 1
 51   4059 22 00 C1             ld (seed), hl
 52   405C 21 FF FF             ld hl, 65535
 53   405F E5           mo1:    push hl
 54   4060 CD 7C 40             call random
 55   4063 CD AC 40             call rowmod
 56   4066 21 60 C4             ld hl, counts + 96
 57   4069 CD 74 40             call count
 58   406C E1                   pop hl
 59   406D 2B                   dec hl
 60   406E 7C                   ld a, h
 61   406F B5                   or l
 62   4070 20 ED                jr nz, mo1
 63   4072 18 FE        done:   jr done
 64   4074
 65   4074              ; count: A = a row, HL = its table -> the row's count, two bytes, one more
 66   4074 87           count:  add a, a
 67   4075 85                   add a, l
 68   4076 6F                   ld l, a                 ; the table does not cross a page
 69   4077 34                   inc (hl)
 70   4078 C0                   ret nz
 71   4079 2C                   inc l
 72   407A 34                   inc (hl)
 73   407B C9                   ret
 74   407C
 75   407C              ; random: the next of the 65,535 states of a 16-bit xorshift, x XOR x << 7,
 76   407C              ; XOR x >> 9, XOR x << 8 -> seed, A = its high byte. Uses A, HL
 77   407C 2A 00 C1     random: ld hl, (seed)           ; 17
 78   407F 7C                   ld a, h                 ;  5
 79   4080 1F                   rra                     ;  5  bit 0 of H into the carry
 80   4081 7D                   ld a, l                 ;  5
 81   4082 1F                   rra                     ;  5  x << 7's high byte: that bit and L >> 1
 82   4083 AC                   xor h                   ;  5
 83   4084 67                   ld h, a                 ;  5  H XOR it
 84   4085 7D                   ld a, l                 ;  5
 85   4086 0F                   rrca                    ;  5
 86   4087 E6 80                and $80                 ;  8  x << 7's low byte: L's bit 0 at bit 7
 87   4089 AD                   xor l                   ;  5
 88   408A 6F                   ld l, a                 ;  5  x XOR x << 7
 89   408B 7C                   ld a, h                 ;  5
 90   408C CB 3F                srl a                   ; 10  x >> 9, which is H >> 1
 91   408E AD                   xor l                   ;  5
 92   408F 6F                   ld l, a                 ;  5  x XOR x >> 9, which changes L alone
 93   4090 AC                   xor h                   ;  5
 94   4091 67                   ld h, a                 ;  5  x XOR x << 8: H XOR L
 95   4092 22 00 C1             ld (seed), hl           ; 17
