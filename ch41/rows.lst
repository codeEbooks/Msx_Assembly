101   4099 E6 1F                and 31                  ;  8
102   409B FE 18                cp 24                   ;  8
103   409D 30 F7                jr nc, rowrej           ; 13, or 8  24 to 31: another
104   409F C9                   ret                     ; 11
105   40A0
106   40A0              ; rowmul: A = a number -> A = A x 24 / 256, a row from 0 to 23. Uses A, DE, HL
107   40A0 6F           rowmul: ld l, a                 ;  5
108   40A1 26 00                ld h, 0                 ;  8
109   40A3 5D                   ld e, l                 ;  5
110   40A4 54                   ld d, h                 ;  5
111   40A5 29                   add hl, hl              ; 12
112   40A6 19                   add hl, de              ; 12  3 x
113   40A7 29                   add hl, hl              ; 12
114   40A8 29                   add hl, hl              ; 12
115   40A9 29                   add hl, hl              ; 12  24 x
116   40AA 7C                   ld a, h                 ;  5  / 256
