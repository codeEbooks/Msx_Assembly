227   41A7 CB 3F                srl a                   ; 10  x >> 9, which is H >> 1
228   41A9 AD                   xor l                   ;  5
229   41AA 6F                   ld l, a                 ;  5  x XOR x >> 9, which changes L alone
230   41AB AC                   xor h                   ;  5
231   41AC 67                   ld h, a                 ;  5  x XOR x << 8: H XOR L
232   41AD 22 02 C1             ld (seed), hl           ; 17
233   41B0 C9                   ret                     ; 11
234   41B1
235   41B1              ; rowrej: A = a row from 0 to 23, from random's numbers AND 31, until one is
236   41B1              ; below 24. Uses A, HL
237   41B1 CD 97 41     rowrej: call random             ; 18
238   41B4 E6 1F                and 31                  ;  8
239   41B6 FE 18                cp 24                   ;  8
240   41B8 30 F7                jr nc, rowrej           ; 13, or 8  24 to 31: another
241   41BA C9                   ret                     ; 11
242   41BB
243   41BB              ; rowmul: A = a number -> A = A x 24 / 256, a row from 0 to 23. Uses A, DE, HL
244   41BB 6F           rowmul: ld l, a                 ;  5
245   41BC 26 00                ld h, 0                 ;  8
246   41BE 5D                   ld e, l                 ;  5
247   41BF 54                   ld d, h                 ;  5
248   41C0 29                   add hl, hl              ; 12
249   41C1 19                   add hl, de              ; 12  3 x
250   41C2 29                   add hl, hl              ; 12
251   41C3 29                   add hl, hl              ; 12
252   41C4 29                   add hl, hl              ; 12  24 x
253   41C5 7C                   ld a, h                 ;  5  / 256
254   41C6 C9                   ret                     ; 11
255   41C7
256   41C7              ; rowmod: A = a number -> A = A MOD 24, a row from 0 to 23. Uses A
257   41C7 D6 18        rowmod: sub 24                  ;  8
258   41C9 30 FC                jr nc, rowmod           ; 13, or 8
259   41CB C6 18                add a, 24               ;  8  one 24 too many
260   41CD C9                   ret                     ; 11
