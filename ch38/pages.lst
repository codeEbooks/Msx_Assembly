247   41C4              ; an empty one for a 1, from the address set. Uses A, B, L
248   41C4 6F           cells:  ld l, a
249   41C5 06 08                ld b, 8
250   41C7 3E 02        .cell:  ld a, 2
251   41C9 CB 05                rlc l                   ; the next bit, into the carry
252   41CB 30 02                jr nc, .put             ; 0: held
253   41CD 3E 01                ld a, 1
254   41CF D3 98        .put:   out (VDP_DATA), a
255   41D1 10 F4                djnz .cell
256   41D3 C9                   ret
257   41D4
258   41D4              ; hex: A as two hexadecimal digits, from the address set. Uses A, C
259   41D4 4F           hex:    ld c, a
260   41D5 0F                   rrca
261   41D6 0F                   rrca
262   41D7 0F                   rrca
263   41D8 0F                   rrca
264   41D9 CD DD 41             call .digit
265   41DC 79                   ld a, c
266   41DD E6 0F        .digit: and $0F
267   41DF C6 30                add a, '0'
268   41E1 FE 3A                cp '9' + 1
269   41E3 38 02                jr c, .out
270   41E5 C6 07                add a, 'A' - '9' - 1
271   41E7 D3 98        .out:   out (VDP_DATA), a
272   41E9 C9                   ret
273   41EA
274   41EA              ; send: E blocks of 256 bytes from HL to the VDP
