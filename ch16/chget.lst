 9    4010              RESULTS EQU RAM_START          ; what the program found: the debugger reads it here
10    4010              ; CHGET waits for a key in the buffer that the BIOS's interrupt routine
11    4010              ; fills. The program calls it as INIT leaves the machine: interrupts off.
12    4010 F3           init:   di
13    4011 31 80 F3             ld sp, SYS_AREA
14    4014 CD 9F 00     c1:     call CHGET              ; wait for a key
15    4017 32 00 C0     c2:     ld (RESULTS), a         ; its code
16    401A                      VDP_REG 7, LIGHT_GREEN  ; the border light green: a key came
16    401A 3E 03       >        ld a, LIGHT_GREEN
16    401C D3 99       >        out (VDP_CTRL), a
16    401E 3E 87       >        ld a, $80 | (7)
16    4020 D3 99       >        out (VDP_CTRL), a
17    4022 18 FE        stop:   jr stop
