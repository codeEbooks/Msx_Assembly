144   4510                      EDUP
145   4510
146   4510              ; at: B = row (0-23), C = column (0-31) -> the VDP's write address is that
147   4510              ;     cell of the name table. Keeps BC, DE. Uses A, HL.
148   4510 D5           at:     push de
149   4511 68                   ld l, b
150   4512 26 00                ld h, 0
151   4514 29                   add hl, hl
152   4515 29                   add hl, hl
153   4516 29                   add hl, hl
154   4517 29                   add hl, hl
155   4518 29                   add hl, hl              ; row x 32
156   4519 59                   ld e, c
157   451A 16 18                ld d, $18
158   451C 19                   add hl, de              ; + $1800 + column
159   451D 7D                   ld a, l
160   451E D3 99                out (VDP_CTRL), a
161   4520 7C                   ld a, h
162   4521 F6 40                or $40
163   4523 D3 99                out (VDP_CTRL), a
164   4525 D1                   pop de
165   4526 C9                   ret
166   4527
167   4527              ; putc: A = character, B = row, C = column. Keeps BC, DE, HL.
168   4527 E5           putc:   push hl
169   4528 F5                   push af
170   4529 CD 10 45             call at
171   452C F1                   pop af
172   452D D3 98                out (VDP_DATA), a
173   452F E1                   pop hl
174   4530 C9                   ret
175   4531
176   4531              ; puts: HL = text ending in 0, B = row, C = column; C moves on.
177   4531 7E           puts:   ld a, (hl)
178   4532 B7                   or a
179   4533 C8                   ret z
180   4534 CD 27 45             call putc
181   4537 23                   inc hl
182   4538 0C                   inc c
183   4539 18 F6                jr puts
184   453B
185   453B              ; puthex: A = a byte, as two hexadecimal digits; C moves on by 2.
186   453B F5           puthex: push af
187   453C 0F                   rrca
188   453D 0F                   rrca
189   453E 0F                   rrca
190   453F 0F                   rrca                    ; the high four bits first
191   4540 CD 44 45             call hexdig
192   4543 F1                   pop af
193   4544 E6 0F        hexdig: and %00001111
194   4546 C6 30                add a, '0'
195   4548 FE 3A                cp '9' + 1
196   454A 38 02                jr c, .digit
197   454C C6 07                add a, 'A' - '9' - 1    ; 10-15 become A-F
198   454E CD 27 45     .digit: call putc
199   4551 0C                   inc c
200   4552 C9                   ret
201   4553              boxes:                          ; characters 1 (empty box) and 2 (filled)
202   4553 FE 82 82 82          db %11111110, %10000010, %10000010, %10000010, %10000010, %10000010, %11111110, %00000000
202   4557 82 82 FE 00
203   455B FE FE FE FE          db %11111110, %11111110, %11111110, %11111110, %11111110, %11111110, %11111110, %00000000
203   455F FE FE FE 00
204   4563                      ASSERT $ <= $8000, the program is longer than the cartridge
205   4563 FF FF FF...          ds $8000 - $, $FF       ; pad the cartridge to 16 KB
