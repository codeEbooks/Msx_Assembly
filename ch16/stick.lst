# file opened: bios.inc
 1+   4010              ; bios.inc -- the BIOS entry points and system variables this book calls by
 2+   4010              ; name (chapter 16). The MSX standard fixes every address: behind each entry
 3+   4010              ; point every MSX BIOS, C-BIOS included, has a JP to a routine of its own.
 4+   4010              ; Call them with page 0 showing the BIOS, as it does when INIT is called.
 5+   4010
 6+   4010              ; entry points
 7+   4010              DISSCR   EQU $0041      ; the display off
 8+   4010              ENASCR   EQU $0044      ; the display on
 9+   4010              WRTVDP   EQU $0047      ; B to VDP register C
10+   4010              LDIRVM   EQU $005C      ; BC bytes from HL to the VRAM at DE
11+   4010              CHGMOD   EQU $005F      ; the screen mode in A
12+   4010              CHGET    EQU $009F      ; wait for a key; A = its code
13+   4010              CHPUT    EQU $00A2      ; print the character in A
14+   4010              BEEP     EQU $00C0      ; a beep (C-BIOS: none)
15+   4010              GTSTCK   EQU $00D5      ; A = 0: the cursor keys; A = their direction, 0-8
16+   4010
17+   4010              ; two bytes of data: the VDP's ports, for programs that ask
18+   4010              VDP_DR   EQU $0006      ; the port the VRAM is read from
19+   4010              VDP_DW   EQU $0007      ; the port it is written to
20+   4010
21+   4010              ; system variables
22+   4010              LINLEN   EQU $F3B0      ; the width of a line of text
23+   4010              CSRY     EQU $F3DC      ; the cursor's line, from 1
24+   4010              CSRX     EQU $F3DD      ; and its column, from 1
25+   4010              RG0SAV   EQU $F3DF      ; the copy of VDP register n is at RG0SAV + n
26+   4010              STATFL   EQU $F3E7      ; the last status the BIOS read
27+   4010              FORCLR   EQU $F3E9      ; ink, paper and border, for CHGMOD
28+   4010              BAKCLR   EQU $F3EA
29+   4010              BDRCLR   EQU $F3EB
30+   4010              PUTPNT   EQU $F3F8      ; where the next key goes into the key buffer
31+   4010              GETPNT   EQU $F3FA      ; where CHGET takes the next one from
32+   4010              JIFFY    EQU $FC9E      ; one more every frame interrupt
33+   4010              SCRMOD   EQU $FCAF      ; the screen mode
34+   4010              EXPTBL   EQU $FCC1      ; which slots are expanded
35+   4010
36+   4010              ; hooks: five bytes each, RET until a program puts a jump there
37+   4010              H_KEYI   EQU $FD9A      ; H.KEYI, every interrupt
38+   4010              H_TIMI   EQU $FD9F      ; H.TIMI, every frame interrupt
39+   4010              H_CHPU   EQU $FDA4      ; H.CHPU, every character CHPUT prints
40+   4010              H_CHGE   EQU $FDC2      ; H.CHGE, every call of CHGET
41+   4010
# file closed: bios.inc
 9    4010              RESULTS EQU RAM_START          ; what the program found: the debugger reads it here
10    4010              ; The cursor keys read twice, by GTSTCK and by stick, which asks the keyboard
11    4010              ; itself; the debugger holds keys down from INIT on and compares.
12    4010 F3           init:   di
13    4011 31 80 F3             ld sp, SYS_AREA
14    4014 AF           s1:     xor a
15    4015 CD D5 00             call GTSTCK             ; the BIOS's way
16    4018 32 00 C0     s2:     ld (RESULTS), a
17    401B CD 23 40     s3:     call stick              ; straight from the keyboard
18    401E 32 01 C0     s4:     ld (RESULTS+1), a
19    4021 18 FE        stop:   jr stop
20    4023
21    4023              ; stick: A = the direction of the cursor keys, 0 to 8, as GTSTCK gives it:
22    4023              ;        row 8 of the keyboard, read through the PPI (chapter 3), and its four
23    4023              ;        top bits, which are 0 for a key held down, looked up in a table.
24    4023              ;        Uses A, H, L.
25    4023 DB AA        stick:  in a, (PPI_C)
26    4025 E6 F0                and $F0                 ; keep the PPI's other outputs
27    4027 F6 08                or 8                    ; row 8: the cursor keys in bits 4 to 7
28    4029 D3 AA                out (PPI_C), a
29    402B DB A9                in a, (PPI_B)
30    402D 0F                   rrca
31    402E 0F                   rrca
32    402F 0F                   rrca
33    4030 0F                   rrca
34    4031 E6 0F                and $0F                 ; right, down, up, left: 0 when held
35    4033 6F                   ld l, a
36    4034 26 41                ld h, high sticks
37    4036 7E                   ld a, (hl)
38    4037 C9                   ret
39    4038
40    4038 00 00 00...          ALIGN 256               ; stick puts the four bits in L
41    4100 00 03 05 04  sticks: db 0, 3, 5, 4, 1, 2, 0, 3, 7, 0, 6, 5, 8, 1, 7, 0
41    4104 01 02 00 03
41    4108 07 00 06 05
41    410C 08 01 07 00
