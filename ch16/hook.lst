 9    4010              band    EQU RAM_START       ; the colour of the band the border is in
10    4010              ; A routine of the program's own in H.CHPU, the hook CHPUT calls before every
11    4010              ; character: it changes the colour of the border, so that every character
12    4010              ; CHPUT prints is one band of the border. The page is printed again every
13    4010              ; frame, from the same point of the frame.
14    4010 F3           init:   di
15    4011 31 80 F3             ld sp, SYS_AREA
16    4014 3E 01                ld a, BLACK
17    4016 32 E9 F3             ld (FORCLR), a          ; ink
18    4019 3E 0F                ld a, WHITE
19    401B 32 EA F3             ld (BAKCLR), a          ; paper
20    401E 3E 03                ld a, LIGHT_GREEN
21    4020 32 EB F3             ld (BDRCLR), a          ; border
22    4023 3E 01                ld a, 1
23    4025 CD 5F 00             call CHGMOD
24    4028 21 4A 40             ld hl, hook             ; H.CHPU: JP hook
25    402B 22 A5 FD             ld (H_CHPU + 1), hl
26    402E 3E C3                ld a, $C3               ; JP
27    4030 32 A4 FD             ld (H_CHPU), a
28    4033 3E 01        frame:  ld a, BLACK
29    4035 32 00 C0             ld (band), a            ; every frame the same bands
30    4038 FB                   ei
31    4039 76                   halt                    ; the frame interrupt, and the BIOS's routine
32    403A CD 5C 40     h1:     call wait               ; down to the top of the picture
33    403D 21 65 40             ld hl, text
34    4040 7E           h2:     ld a, (hl)
35    4041 B7                   or a
36    4042 28 EF                jr z, frame             ; the 0 at the end: the page again
37    4044 CD A2 00             call CHPUT              ; and CHPUT calls H.CHPU
38    4047 23                   inc hl
39    4048 18 F6                jr h2
40    404A
41    404A              ; hook: called by CHPUT through H.CHPU, before every character, with the
42    404A              ;       character in A. The border in the other colour. Keeps every register.
43    404A F5           hook:   push af
44    404B 3A 00 C0             ld a, (band)
45    404E EE 02                xor BLACK ^ LIGHT_GREEN ; the other colour
46    4050 32 00 C0             ld (band), a
47    4053 F3                   di                      ; the two bytes together (chapter 19)
48    4054 D3 99                out (VDP_CTRL), a
49    4056 3E 87                ld a, $87               ; register 7: the border
50    4058 D3 99        o1:     out (VDP_CTRL), a
51    405A F1                   pop af
52    405B C9                   ret
53    405C
54    405C              ; wait: 700 turns of chapter 14's loop. Uses A, DE.
55    405C 11 BC 02     wait:   ld de, 700
56    405F 1B           wt:     dec de
57    4060 7A                   ld a, d
58    4061 B3                   or e
59    4062 20 FB                jr nz, wt
60    4064 C9                   ret
