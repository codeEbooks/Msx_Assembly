 9    4010              RESULTS EQU RAM_START          ; what the program found: the debugger reads it here
10    4010              ; CHGMOD with the colours of FORCLR, BAKCLR and BDRCLR, then a page printed
11    4010              ; by CHPUT: 12 clears it, ESC Y and two bytes move the cursor, 13 and 10 end
12    4010              ; a line, 9 is a tab, 8 a step back, and 7 asks for a beep.
13    4010 F3           init:   di
