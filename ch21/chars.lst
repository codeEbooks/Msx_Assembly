 66+  4010              H_KEYI   EQU $FD9A      ; H.KEYI, every interrupt
 67+  4010              H_TIMI   EQU $FD9F      ; H.TIMI, every frame interrupt
 68+  4010              H_CHPU   EQU $FDA4      ; H.CHPU, every character CHPUT prints
