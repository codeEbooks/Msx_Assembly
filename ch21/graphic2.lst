# file opened: bios.inc
  1+  4010              ; bios.inc -- the BIOS entry points and system variables this book calls by
  2+  4010              ; name (chapter 16). The MSX standard fixes every address: behind each entry
  3+  4010              ; point every MSX BIOS, C-BIOS included, has a JP to a routine of its own.
  4+  4010              ; Call them with page 0 showing the BIOS, as it does when INIT is called.
  5+  4010
  6+  4010              ; entry points
  7+  4010              DISSCR   EQU $0041      ; the display off
  8+  4010              ENASCR   EQU $0044      ; the display on
  9+  4010              WRTVDP   EQU $0047      ; B to VDP register C
 10+  4010              RDVRM    EQU $004A      ; A = the byte of the VRAM at HL (chapter 19)
 11+  4010              WRTVRM   EQU $004D      ; A to the VRAM at HL
 12+  4010              SETRD    EQU $0050      ; the VDP's address set to HL, to read
 13+  4010              SETWRT   EQU $0053      ; the VDP's address set to HL, to write
 14+  4010              FILVRM   EQU $0056      ; BC bytes of A to the VRAM from HL
 15+  4010              LDIRVM   EQU $005C      ; BC bytes from HL to the VRAM at DE
 16+  4010              CHGMOD   EQU $005F      ; the screen mode in A
 17+  4010              INITXT   EQU $006C      ; text mode, 40 x 24, with the BIOS's tables (chapter 21)
 18+  4010              INIT32   EQU $006F      ; Graphic I, 32 x 24
 19+  4010              INIGRP   EQU $0072      ; Graphic II
 20+  4010              INIMLT   EQU $0075      ; multicolour
 21+  4010              CHGET    EQU $009F      ; wait for a key; A = its code
 22+  4010              CHPUT    EQU $00A2      ; print the character in A
 23+  4010              BEEP     EQU $00C0      ; a beep (C-BIOS: none)
 24+  4010              GTSTCK   EQU $00D5      ; A = 0: the cursor keys; A = their direction, 0-8
 25+  4010
 26+  4010              ; two bytes of data: the VDP's ports, for programs that ask
 27+  4010              VDP_DR   EQU $0006      ; the port the VRAM is read from
 28+  4010              VDP_DW   EQU $0007      ; the port it is written to
 29+  4010
 30+  4010              ; system variables
 31+  4010              LINLEN   EQU $F3B0      ; the width of a line of text
 32+  4010              TXTNAM   EQU $F3B3      ; where INITXT puts the tables: names, colours,
 33+  4010              TXTCOL   EQU $F3B5      ; patterns, sprite attributes, sprite patterns
 34+  4010              TXTCGP   EQU $F3B7      ; (chapter 21); two bytes each
 35+  4010              TXTATR   EQU $F3B9
 36+  4010              TXTPAT   EQU $F3BB
 37+  4010              T32NAM   EQU $F3BD      ; the same for INIT32
 38+  4010              T32COL   EQU $F3BF
 39+  4010              T32CGP   EQU $F3C1
 40+  4010              T32ATR   EQU $F3C3
 41+  4010              T32PAT   EQU $F3C5
 42+  4010              GRPNAM   EQU $F3C7      ; for INIGRP
 43+  4010              GRPCOL   EQU $F3C9
 44+  4010              GRPCGP   EQU $F3CB
 45+  4010              GRPATR   EQU $F3CD
 46+  4010              GRPPAT   EQU $F3CF
 47+  4010              MLTNAM   EQU $F3D1      ; for INIMLT
 48+  4010              MLTCOL   EQU $F3D3
 49+  4010              MLTCGP   EQU $F3D5
 50+  4010              MLTATR   EQU $F3D7
 51+  4010              MLTPAT   EQU $F3D9
 52+  4010              CSRY     EQU $F3DC      ; the cursor's line, from 1
 53+  4010              CSRX     EQU $F3DD      ; and its column, from 1
 54+  4010              RG0SAV   EQU $F3DF      ; the copy of VDP register n is at RG0SAV + n
 55+  4010              STATFL   EQU $F3E7      ; the last status the BIOS read
 56+  4010              FORCLR   EQU $F3E9      ; ink, paper and border, for CHGMOD
 57+  4010              BAKCLR   EQU $F3EA
 58+  4010              BDRCLR   EQU $F3EB
 59+  4010              PUTPNT   EQU $F3F8      ; where the next key goes into the key buffer
 60+  4010              GETPNT   EQU $F3FA      ; where CHGET takes the next one from
 61+  4010              JIFFY    EQU $FC9E      ; one more every frame interrupt
 62+  4010              SCRMOD   EQU $FCAF      ; the screen mode
 63+  4010              EXPTBL   EQU $FCC1      ; which slots are expanded
 64+  4010
 65+  4010              ; hooks: five bytes each, RET until a program puts a jump there
 66+  4010              H_KEYI   EQU $FD9A      ; H.KEYI, every interrupt
 67+  4010              H_TIMI   EQU $FD9F      ; H.TIMI, every frame interrupt
 68+  4010              H_CHPU   EQU $FDA4      ; H.CHPU, every character CHPUT prints
 69+  4010              H_CHGE   EQU $FDC2      ; H.CHGE, every call of CHGET
