 40+  4010              T32ATR   EQU $F3C3
 41+  4010              T32PAT   EQU $F3C5
 42+  4010              GRPNAM   EQU $F3C7      ; for INIGRP
 43+  4010              GRPCOL   EQU $F3C9
 44+  4010              GRPCGP   EQU $F3CB
 45+  4010              GRPATR   EQU $F3CD
 46+  4010              GRPPAT   EQU $F3CF
 47+  4010              MLTNAM   EQU $F3D1      ; for INIMLT
 48+  4010              MLTCOL   EQU $F3D3
 49+  4010              MLTCGP   EQU $F3D5
 50+  4010              MLTATR   EQU $F3D7
 51+  4010              MLTPAT   EQU $F3D9
 52+  4010              CSRY     EQU $F3DC      ; the cursor's line, from 1
 53+  4010              CSRX     EQU $F3DD      ; and its column, from 1
 54+  4010              RG0SAV   EQU $F3DF      ; the copy of VDP register n is at RG0SAV + n
 55+  4010              STATFL   EQU $F3E7      ; the last status the BIOS read
