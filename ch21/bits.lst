201   44DA
202   44DA              ; at: B = row (0-23), C = column (0-31) -> the VDP's write address is that
203   44DA              ;     cell of the name table. Keeps BC, DE. Uses A, HL.
204   44DA D5           at:     push de
205   44DB 68                   ld l, b
206   44DC 26 00                ld h, 0
207   44DE 29                   add hl, hl
208   44DF 29                   add hl, hl
209   44E0 29                   add hl, hl
210   44E1 29                   add hl, hl
211   44E2 29                   add hl, hl              ; row x 32
212   44E3 59                   ld e, c
213   44E4 16 18                ld d, $18
214   44E6 19                   add hl, de              ; + $1800 + column
215   44E7 7D                   ld a, l
216   44E8 D3 99                out (VDP_CTRL), a
217   44EA 7C                   ld a, h
218   44EB F6 40                or $40
219   44ED D3 99                out (VDP_CTRL), a
220   44EF D1                   pop de
221   44F0 C9                   ret
222   44F1
223   44F1              ; putc: A = character, B = row, C = column. Keeps BC, DE, HL.
224   44F1 E5           putc:   push hl
225   44F2 F5                   push af
226   44F3 CD DA 44             call at
227   44F6 F1                   pop af
228   44F7 D3 98                out (VDP_DATA), a
229   44F9 E1                   pop hl
230   44FA C9                   ret
231   44FB
232   44FB              ; puts: HL = text ending in 0, B = row, C = column; C moves on.
233   44FB 7E           puts:   ld a, (hl)
234   44FC B7                   or a
235   44FD C8                   ret z
236   44FE CD F1 44             call putc
237   4501 23                   inc hl
238   4502 0C                   inc c
239   4503 18 F6                jr puts
240   4505
241   4505              ; puthex: A = a byte, as two hexadecimal digits; C moves on by 2.
242   4505 F5           puthex: push af
243   4506 0F                   rrca
244   4507 0F                   rrca
245   4508 0F                   rrca
246   4509 0F                   rrca                    ; the high four bits first
247   450A CD 0E 45             call hexdig
248   450D F1                   pop af
249   450E E6 0F        hexdig: and %00001111
250   4510 C6 30                add a, '0'
251   4512 FE 3A                cp '9' + 1
252   4514 38 02                jr c, .digit
253   4516 C6 07                add a, 'A' - '9' - 1    ; 10-15 become A-F
254   4518 CD F1 44     .digit: call putc
255   451B 0C                   inc c
256   451C C9                   ret
257   451D              boxes:                          ; characters 1 (empty box) and 2 (filled)
258   451D FE 82 82 82          db %11111110, %10000010, %10000010, %10000010, %10000010, %10000010, %11111110, %00000000
258   4521 82 82 FE 00
259   4525 FE FE FE FE          db %11111110, %11111110, %11111110, %11111110, %11111110, %11111110, %11111110, %00000000
259   4529 FE FE FE 00
260   452D                      ASSERT $ <= $8000, the program is longer than the cartridge
261   452D FF FF FF...          ds $8000 - $, $FF       ; pad the cartridge to 16 KB
262   8000
