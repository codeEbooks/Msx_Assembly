 9    4010              ; INITXT, INIT32, INIGRP and INIMLT in turn. At r0 to r3 the debugger reads
10    4010              ; the VDP's registers and the BIOS's table addresses (TXTNAM to MLTPAT). Then
11    4010              ; CHGMOD with A = 0 to 3, read at m0 to m3.
12    4010 F3           init:   di
13    4011 31 80 F3             ld sp, SYS_AREA
14    4014 CD 6C 00     c0:     call INITXT
15    4017 F3                   di                      ; the BIOS leaves the interrupts on (chapter 16)
16    4018 00           r0:     nop                     ; the debugger reads the registers here
17    4019 CD 6F 00     c1:     call INIT32
18    401C F3                   di                      ; the BIOS leaves the interrupts on (chapter 16)
19    401D 00           r1:     nop                     ; the debugger reads the registers here
20    401E CD 72 00     c2:     call INIGRP
21    4021 F3                   di                      ; the BIOS leaves the interrupts on (chapter 16)
22    4022 00           r2:     nop                     ; the debugger reads the registers here
23    4023 CD 75 00     c3:     call INIMLT
24    4026 F3                   di                      ; the BIOS leaves the interrupts on (chapter 16)
25    4027 00           r3:     nop                     ; the debugger reads the registers here
26    4028 3E 00                ld a, 0
27    402A CD 5F 00     g0:     call CHGMOD             ; screen mode 0
28    402D F3                   di
29    402E 00           m0:     nop                     ; the registers again
30    402F 3E 01                ld a, 1
31    4031 CD 5F 00     g1:     call CHGMOD             ; screen mode 1
32    4034 F3                   di
33    4035 00           m1:     nop                     ; the registers again
34    4036 3E 02                ld a, 2
35    4038 CD 5F 00     g2:     call CHGMOD             ; screen mode 2
36    403B F3                   di
37    403C 00           m2:     nop                     ; the registers again
38    403D 3E 03                ld a, 3
39    403F CD 5F 00     g3:     call CHGMOD             ; screen mode 3
40    4042 F3                   di
41    4043 00           m3:     nop                     ; the registers again
42    4044 18 FE        done:   jr done
43    4046                      ASSERT $ <= $8000, the program is longer than the cartridge
44    4046 FF FF FF...          ds $8000 - $, $FF       ; pad the cartridge to 16 KB
45    8000
