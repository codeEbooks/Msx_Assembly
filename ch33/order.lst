214   421A A7 30 00 01          db $A7, $30, $00, $01
215   421E              works:                          ; turns of 30 T-states
216   421E 64 00                dw 100
217   4220 E8 03                dw 1000
218   4222 64 00                dw 100
219   4224 DC 05                dw 1500
220   4226 64 00                dw 100
221   4228 6C 07                dw 1900
