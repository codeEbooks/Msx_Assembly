217   4228 6C 07                dw 1900
218   422A 64 00                dw 100
219   422C 28 0A                dw 2600
220   422E                      ASSERT $ <= $8000, the program is longer than the cartridge
221   422E FF FF FF...          ds $8000 - $, $FF       ; pad the cartridge to 16 KB
222   8000
# file closed: first.asm
