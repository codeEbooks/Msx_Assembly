   24 4010              FVN     equ 8                   ; how many Fs
   25 4010              BUF     equ 16                  ; room for base and the longest block
   26 4010              AFTER   equ $C810               ; where after is, in the RAM
   27 4010              go      equ VARS                ; JP, and where the block begins
