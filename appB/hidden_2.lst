    9 4010              ; Every instruction but HALT and the RSTs, run from a table as Appendix
   10 4010              ; A's flags.asm runs them: each with the eight Fs of fvals, from every state
   11 4010              ; of its group. Each is first copied to buf, in the RAM, to end just where
   12 4010              ; after begins, with base before it; a jump goes to away. measB.py stops at
   13 4010              ; after and at away, with nothing run between the instruction and the
   14 4010              ; stop, and reads every register; and again after the BIT 0,(HL) that
   15 4010              ; follows, for bits 5 and 3 of MEMPTR's high byte, which BIT puts in F.
   16 4010              ; This cartridge runs part 2 of 2 of the table.
   17 4010              WIN     equ $E1FC               ; the bytes read and written: (HL) is WIN+4
