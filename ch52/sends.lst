 302  441F              ; putbcd: A = a BCD byte, the VRAM address set -> its two digits sent, as
 303  441F              ; the patterns from DIGIT0 (chapter 40's, with an OR). Uses A, C
 304  441F 4F           putbcd: ld c, a                 ;  5
 305  4420 0F                   rrca                    ;  5
 306  4421 0F                   rrca                    ;  5
 307  4422 0F                   rrca                    ;  5
 308  4423 0F                   rrca                    ;  5  the first digit to bits 3 to 0
 309  4424 E6 0F                and $0F                 ;  8
