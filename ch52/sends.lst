 318  4432              ; update: HL = a number, three BCD bytes, with a copy of the three last sent
 319  4432              ; 256 bytes on; DE = the VRAM address of its first digit in the table at
 320  4432              ; $1800, bit 6 set -> each byte that differs from its copy sent to both
 321  4432              ; tables, and copied (chapter 40). Uses A, BC, DE, HL
 322  4432 06 03        update: ld b, 3                 ;  8  three bytes
 323  4434 7E           .byte:  ld a, (hl)              ;  8  a byte of the number
 324  4435 24                   inc h                   ;  5  the page of the bytes sent
 325  4436 BE                   cp (hl)                 ;  8
 326  4437 28 10                jr z, .same             ; 13, or 8  on the screen already
 327  4439 77                   ld (hl), a              ;  8  it will be
 328  443A CD 50 44             call putpair            ; 18  in the table at $1800
 329  443D 7A                   ld a, d                 ;  5
 330  443E EE 04                xor $04                 ;  8
 331  4440 57                   ld d, a                 ;  5  and in the one at $1C00
 332  4441 7E                   ld a, (hl)              ;  8
 333  4442 CD 50 44             call putpair            ; 18
 334  4445 7A                   ld a, d                 ;  5
 335  4446 EE 04                xor $04                 ;  8
 336  4448 57                   ld d, a                 ;  5
 337  4449 1C           .same:  inc e                   ;  5
 338  444A 1C                   inc e                   ;  5  past its two names
 339  444B 25                   dec h                   ;  5  back to the number
 340  444C 2C                   inc l                   ;  5  and its next byte
 341  444D 10 E5                djnz .byte              ; 14, or 9
 342  444F C9                   ret                     ; 11
