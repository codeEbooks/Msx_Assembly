 362  446D              ; input: row 8 of the keyboard and joystick 1, with the interrupts off
 363  446D              ; (chapters 34, 35 and 37): LEFT or the stick to the left sends the first
 364  446D              ; ball left, RIGHT or the stick to the right sends it right. Uses A, B, C, HL
 365  446D F3           input:  di                      ;  5
 366  446E DB AA                in a, (PPI_C)           ; 12
 367  4470 E6 F0                and $F0                 ;  8  the top four bits kept
 368  4472 F6 08                or 8                    ;  8
 369  4474 D3 AA                out (PPI_C), a          ; 12  row 8
 370  4476 DB A9                in a, (PPI_B)           ; 12  LEFT is bit 4, RIGHT bit 7
 371  4478 4F                   ld c, a                 ;  5
 372  4479 AF                   xor a                   ;  5  port 1
 373  447A CD 71 48             call joy                ; 18  left is bit 2, right bit 3
 374  447D FB                   ei                      ;  5
 375  447E 21 02 C6             ld hl, balls + 2        ; 11  the first ball's DX
 376  4481 CB 61                bit 4, c                ; 10
 377  4483 28 04                jr z, .left             ; 13, or 8  LEFT
 378  4485 CB 57                bit 2, a                ; 10
 379  4487 20 03                jr nz, .right           ; 13, or 8  nor the stick to the left
 380  4489 36 FF        .left:  ld (hl), -1             ; 11
 381  448B C9                   ret                     ; 11
 382  448C CB 79        .right: bit 7, c                ; 10
 383  448E 28 03                jr z, .go               ; 13, or 8  RIGHT
 384  4490 CB 5F                bit 3, a                ; 10
 385  4492 C0                   ret nz                  ; 12, or 6  nor the stick to the right
 386  4493 36 01        .go:    ld (hl), 1              ; 11
 387  4495 C9                   ret                     ; 11
