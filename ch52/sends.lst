 311  4428 D3 98                out (VDP_DATA), a       ; 12
 312  442A 79                   ld a, c                 ;  5
 313  442B E6 0F                and $0F                 ;  8  the second digit
 314  442D F6 F0                or DIGIT0               ;  8
 315  442F D3 98                out (VDP_DATA), a       ; 12
