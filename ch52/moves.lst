 317  442F              ; update: HL = a number, three BCD bytes, with a copy of the three last sent
 318  442F              ; 256 bytes on; DE = the VRAM address of its first digit in the table at
 319  442F              ; $1800, bit 6 set -> each byte that differs from its copy sent to both
 320  442F              ; tables, and copied (chapter 40). Uses A, BC, DE, HL
 321  442F 06 03        update: ld b, 3                 ;  8  three bytes
 322  4431 7E           .byte:  ld a, (hl)              ;  8  a byte of the number
 323  4432 24                   inc h                   ;  5  the page of the bytes sent
 324  4433 BE                   cp (hl)                 ;  8
 325  4434 28 10                jr z, .same             ; 13, or 8  on the screen already
 326  4436 77                   ld (hl), a              ;  8  it will be
 327  4437 CD 4D 44             call putpair            ; 18  in the table at $1800
 328  443A 7A                   ld a, d                 ;  5
 329  443B EE 04                xor $04                 ;  8
 330  443D 57                   ld d, a                 ;  5  and in the one at $1C00
 331  443E 7E                   ld a, (hl)              ;  8
 332  443F CD 4D 44             call putpair            ; 18
 333  4442 7A                   ld a, d                 ;  5
 334  4443 EE 04                xor $04                 ;  8
 335  4445 57                   ld d, a                 ;  5
 336  4446 1C           .same:  inc e                   ;  5
 337  4447 1C                   inc e                   ;  5  past its two names
 338  4448 25                   dec h                   ;  5  back to the number
 339  4449 2C                   inc l                   ;  5  and its next byte
 340  444A 10 E5                djnz .byte              ; 14, or 9
 341  444C C9                   ret                     ; 11
