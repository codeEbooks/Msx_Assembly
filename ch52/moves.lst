 361  446A              ; input: row 8 of the keyboard and joystick 1, with the interrupts off
 362  446A              ; (chapters 34, 35 and 37): LEFT or the stick to the left sends the first
 363  446A              ; ball left, RIGHT or the stick to the right sends it right. Uses A, B, C, HL
 364  446A F3           input:  di                      ;  5
 365  446B DB AA                in a, (PPI_C)           ; 12
 366  446D E6 F0                and $F0                 ;  8  the top four bits kept
 367  446F F6 08                or 8                    ;  8
 368  4471 D3 AA                out (PPI_C), a          ; 12  row 8
 369  4473 DB A9                in a, (PPI_B)           ; 12  LEFT is bit 4, RIGHT bit 7
 370  4475 4F                   ld c, a                 ;  5
 371  4476 AF                   xor a                   ;  5  port 1
 372  4477 CD 24 49             call joy                ; 18  left is bit 2, right bit 3
 373  447A FB                   ei                      ;  5
 374  447B 21 00 C6             ld hl, dirs             ; 11  the first ball's DX
 375  447E CB 61                bit 4, c                ; 10
 376  4480 28 04                jr z, .left             ; 13, or 8  LEFT
 377  4482 CB 57                bit 2, a                ; 10
 378  4484 20 03                jr nz, .right           ; 13, or 8  nor the stick to the left
 379  4486 36 FF        .left:  ld (hl), -1             ; 11
 380  4488 C9                   ret                     ; 11
 381  4489 CB 79        .right: bit 7, c                ; 10
 382  448B 28 03                jr z, .go               ; 13, or 8  RIGHT
 383  448D CB 5F                bit 3, a                ; 10
 384  448F C0                   ret nz                  ; 12, or 6  nor the stick to the right
 385  4490 36 01        .go:    ld (hl), 1              ; 11
 386  4492 C9                   ret                     ; 11
