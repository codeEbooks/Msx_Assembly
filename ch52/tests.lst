 237  4203              ; show: the pairs' patterns at the scroll's shift, NB bytes after the paper
 238  4203              ; (chapter 29); and when the scroll has reached a new column, the table that
 239  4203              ; holds it shown with R#2, and the next window to be written
 240  4203              show:   VRAM_WRITE $0000        ; 40
 240  4203 3E 00       >        ld a, low ($0000)
