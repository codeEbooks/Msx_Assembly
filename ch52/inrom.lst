 312  4424              ; update: HL = a number, three BCD bytes, with a copy of the three last sent
 313  4424              ; 256 bytes on; DE = the VRAM address of its first digit in the table at
 314  4424              ; $1800, bit 6 set -> each byte that differs from its copy sent to both
 315  4424              ; tables, and copied (chapter 40). Uses A, BC, DE, HL
 316  4424 06 03        update: ld b, 3                 ;  8  three bytes
 317  4426 7E           .byte:  ld a, (hl)              ;  8  a byte of the number
 318  4427 24                   inc h                   ;  5  the page of the bytes sent
