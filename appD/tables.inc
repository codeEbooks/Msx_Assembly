; tables.inc -- appendix D: the Graphic II addresses of every line of
; the paper, y = 0 to 191, at x = 0; add x AND $F8 for any other column.
; sjasmplus makes every entry with DUP, from one expression a table.
; generated by genD.py

; patrow: the pattern byte of (0, y), the BIOS's layout
patrow:
y = 0
        DUP 192
        dw ((y & $F8) << 5) | (y & 7)
y = y + 1
        EDUP

; colrow: its colour byte
colrow:
y = 0
        DUP 192
        dw $2000 | ((y & $F8) << 5) | (y & 7)
y = y + 1
        EDUP

; patrow3: the pattern byte of (0, y), one set for the three thirds
patrow3:
y = 0
        DUP 192
        dw ((y & $38) << 5) | (y & 7)
y = y + 1
        EDUP

; colrow3: its colour byte
colrow3:
y = 0
        DUP 192
        dw $2000 | ((y & $38) << 5) | (y & 7)
y = y + 1
        EDUP

; namerow: the name of column 0 of row y, 0 to 23
namerow:
y = 0
        DUP 24
        dw $1800 + (y << 5)
y = y + 1
        EDUP

; the same as single bytes, the high bytes on one page and the low bytes
; on the next: the routines go from one to the other with INC H

        ALIGN 256
pathi:
y = 0
        DUP 192
        db high (((y & $F8) << 5) | (y & 7))
y = y + 1
        EDUP

        ALIGN 256
patlo:
y = 0
        DUP 192
        db low (((y & $F8) << 5) | (y & 7))
y = y + 1
        EDUP

        ALIGN 256
namhi:
y = 0
        DUP 192
        db high ($1800 + ((y & $F8) << 2))
y = y + 1
        EDUP

        ALIGN 256
namlo:
y = 0
        DUP 192
        db low ($1800 + ((y & $F8) << 2))
y = y + 1
        EDUP

