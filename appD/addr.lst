  7   4010              VARS    EQU RAM_START + $100    ; the program's variables: the code is in ROM
  8   4010              IM2_TABLE EQU $C200             ; 257 bytes of $C3: every vector is $C3C3
  9   4010              IM2_JUMP  EQU $C3C3             ; and there, a JP to the routine
 10   4010              ; Six passes, each with the screen set up again with the display off. In
 11   4010              ; each frame one byte is written at the address one entry of a table gives,
 12   4010              ; and the one before is put back, so that the next frame's photograph shows
 13   4010              ; where that address is on the screen, and nothing else.
 14   4010 F3           init:   di
 15   4011 31 80 F3             ld sp, SYS_AREA
