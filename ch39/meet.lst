209   41F1 C9                   ret
210   41F2
211   41F2              ; boxed: B, C = X, Y of one ball and D, E of the other -> carry if their
212   41F2              ; boxes of 16 x 16 share a pixel: X and Y both less than 16 apart. Uses A
213   41F2 7A           boxed:  ld a, d                 ;  5
214   41F3 90                   sub b                   ;  5  the difference of the X
215   41F4 C6 0F                add a, 15               ;  8  -15 to 15 become 0 to 30
216   41F6 FE 1F                cp 31                   ;  8
217   41F8 D0                   ret nc                  ; 12, or 6  16 or more apart
218   41F9 7B                   ld a, e                 ;  5
219   41FA 91                   sub c                   ;  5  the difference of the Y
220   41FB C6 0F                add a, 15               ;  8
221   41FD FE 1F                cp 31                   ;  8
222   41FF C9                   ret                     ; 11  carry: the boxes meet
223   4200
224   4200              ; touched: B, C = X, Y of one ball and D, E of the other, whose boxes meet ->
225   4200              ; NZ if a pixel of one is a pixel of the other. The ball's rows are in
226   4200              ; shifted, four bytes each, moved 0 to 7 pixels right: copy s at 64 x s.
227   4200              ; Uses A, BC, DE, HL
228   4200 7A           touched: ld a, d                ;  5
229   4201 90                   sub b                   ;  5  dx: the second ball's X less the first's
230   4202 30 06                jr nc, .order           ; 13, or 8
231   4204 C5                   push bc                 ; 12  the second ball is on the left:
232   4205 D5                   push de                 ; 12  the two change places
233   4206 C1                   pop bc                  ; 11
234   4207 D1                   pop de                  ; 11
235   4208 ED 44                neg                     ; 10
236   420A 6F           .order: ld l, a                 ;  5  L: dx, 0 to 15. (B, C) is the left ball
237   420B 7B                   ld a, e                 ;  5
238   420C 91                   sub c                   ;  5  dy: the right ball's Y less the left's
239   420D 1E 00                ld e, 0                 ;  8  the right ball lower: its row 0 ...
240   420F 30 04                jr nc, .lower           ; 13, or 8
241   4211 ED 44                neg                     ; 10  higher: its row -dy ...
242   4213 5F                   ld e, a                 ;  5
243   4214 AF                   xor a                   ;  5  ... meets the left ball's row 0
244   4215 4F           .lower: ld c, a                 ;  5  C: the left ball's first row
245   4216 83                   add a, e                ;  5
246   4217 D6 10                sub 16                  ;  8
247   4219 ED 44                neg                     ; 10
248   421B 47                   ld b, a                 ;  5  B: the rows both cover, 16 - |dy|
249   421C 7D                   ld a, l                 ;  5
250   421D E6 03                and 3                   ;  8
251   421F 0F                   rrca                    ;  5
252   4220 0F                   rrca                    ;  5  (dx AND 3) x 64
253   4221 CB 23                sla e                   ; 10
254   4223 CB 23                sla e                   ; 10  + 4 x the right ball's first row
255   4225 83                   add a, e                ;  5
256   4226 5F                   ld e, a                 ;  5
257   4227 16 44                ld d, high shifted      ;  8  DE: that row of copy dx AND 7
258   4229 CB 55                bit 2, l                ; 10
259   422B 28 01                jr z, .page             ; 13, or 8
260   422D 14                   inc d                   ;  5  copies 4 to 7 are in the next page
261   422E CB 5D        .page:  bit 3, l                ; 10
262   4230 28 01                jr z, .near             ; 13, or 8
263   4232 1B                   dec de                  ;  7  dx of 8 or more: a byte to the left
264   4233 79           .near:  ld a, c                 ;  5
265   4234 87                   add a, a                ;  5
266   4235 87                   add a, a                ;  5
267   4236 6F                   ld l, a                 ;  5
268   4237 26 44                ld h, high shifted      ;  8  HL: the left ball's first row, copy 0
269   4239 1A           .row:   ld a, (de)              ;  8
270   423A A6                   and (hl)                ;  8  the first byte of the two
271   423B C0                   ret nz                  ; 12, or 6  a pixel of both: they touch
272   423C 13                   inc de                  ;  7
273   423D 2C                   inc l                   ;  5
274   423E 1A                   ld a, (de)              ;  8
275   423F A6                   and (hl)                ;  8  the second
276   4240 C0                   ret nz                  ; 12, or 6
277   4241 13                   inc de                  ;  7
278   4242 13                   inc de                  ;  7
279   4243 13                   inc de                  ;  7
280   4244 2C                   inc l                   ;  5
281   4245 2C                   inc l                   ;  5
282   4246 2C                   inc l                   ;  5  the next row of each
283   4247 10 F0                djnz .row               ; 14, or 9
284   4249 AF                   xor a                   ;  5
