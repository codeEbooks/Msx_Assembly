 28+  4010              BAKCLR   EQU $F3EA
 29+  4010              BDRCLR   EQU $F3EB
 30+  4010              PUTPNT   EQU $F3F8      ; where the next key goes into the key buffer
 31+  4010              GETPNT   EQU $F3FA      ; where CHGET takes the next one from
 32+  4010              JIFFY    EQU $FC9E      ; one more every frame interrupt
 33+  4010              SCRMOD   EQU $FCAF      ; the screen mode
