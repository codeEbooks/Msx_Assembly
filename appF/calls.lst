  3   0000                      INCLUDE "msx.inc"
# file opened: msx.inc
  1+  0000              ; msx.inc -- the canonical header of the MSX Assembly book.
  2+  0000              ; Ports and addresses of the MSX1 standard, and the cartridge header.
  3+  0000
  4+  0000              VDP_DATA    EQU $98         ; VRAM data, read and write
  5+  0000              VDP_CTRL    EQU $99         ; write: register / address set-up; read: status
  6+  0000              PSG_ADDR    EQU $A0         ; PSG register select
  7+  0000              PSG_WRITE   EQU $A1         ; PSG data write
  8+  0000              PSG_READ    EQU $A2         ; PSG data read
  9+  0000              PPI_A       EQU $A8         ; primary slot register
 10+  0000              PPI_B       EQU $A9         ; keyboard columns (read)
 11+  0000              PPI_C       EQU $AA         ; keyboard row (bits 0-3), cassette, CAPS LED, click
 12+  0000              PPI_MODE    EQU $AB         ; PPI control
 13+  0000
 14+  0000              RAM_START   EQU $C000       ; the book's 16 KB floor: $C000-$FFFF
 15+  0000              SYS_AREA    EQU $F380       ; BIOS work area starts here: programs stay below
 16+  0000              CGTABL      EQU $0004       ; BIOS: the address of the character set (2 bytes)
 17+  0000
 18+  0000              ; the sixteen colour codes of the VDP (chapter 1 photographed them)
 19+  0000              TRANSPARENT  EQU 0
 20+  0000              BLACK        EQU 1
 21+  0000              MEDIUM_GREEN EQU 2
 22+  0000              LIGHT_GREEN  EQU 3
 23+  0000              DARK_BLUE    EQU 4
 24+  0000              LIGHT_BLUE   EQU 5
 25+  0000              DARK_RED     EQU 6
 26+  0000              CYAN         EQU 7
 27+  0000              MEDIUM_RED   EQU 8
 28+  0000              LIGHT_RED    EQU 9
 29+  0000              DARK_YELLOW  EQU 10
 30+  0000              LIGHT_YELLOW EQU 11
 31+  0000              DARK_GREEN   EQU 12
 32+  0000              MAGENTA      EQU 13
 33+  0000              GREY         EQU 14
 34+  0000              WHITE        EQU 15
 35+  0000
 36+  0000              ; cartridge header: "AB", INIT, STATEMENT, DEVICE, TEXT, 6 reserved bytes
 37+  0000                  MACRO CART_HEADER init_addr
 38+  0000 ~                    db "AB"
 39+  0000 ~                    dw init_addr
 40+  0000 ~                    dw 0, 0, 0
 41+  0000 ~                    ds 6, 0
 42+  0000                  ENDM
 43+  0000
 44+  0000              ; write value to VDP register reg (2 OUTs; interrupts must be off)
 45+  0000                  MACRO VDP_REG reg, value
 46+  0000 ~                    ld a, value
 47+  0000 ~                    out (VDP_CTRL), a
 48+  0000 ~                    ld a, $80 | (reg)
 49+  0000 ~                    out (VDP_CTRL), a
 50+  0000                  ENDM
 51+  0000
 52+  0000              ; set the VRAM write address (2 OUTs; interrupts must be off)
 53+  0000                  MACRO VRAM_WRITE addr
 54+  0000 ~                    ld a, low (addr)
 55+  0000 ~                    out (VDP_CTRL), a
 56+  0000 ~                    ld a, high (addr) | $40
 57+  0000 ~                    out (VDP_CTRL), a
 58+  0000                  ENDM
 59+  0000
# file closed: msx.inc
  4   0000                      INCLUDE "bios.inc"
# file opened: bios.inc
  1+  0000              ; bios.inc -- the BIOS entry points and system variables this book calls by
  2+  0000              ; name (chapter 16). The MSX standard fixes every address: behind each entry
  3+  0000              ; point every MSX BIOS, C-BIOS included, has a JP to a routine of its own.
  4+  0000              ; Call them with page 0 showing the BIOS, as it does when INIT is called.
  5+  0000
  6+  0000              ; entry points
  7+  0000              RDSLT    EQU $000C      ; A = the byte at HL in slot A, a slot ID (chapter 38)
  8+  0000              WRSLT    EQU $0014      ; E to the address HL in slot A
  9+  0000              CALSLT   EQU $001C      ; call the address IX in the slot in IY's high byte
 10+  0000              ENASLT   EQU $0024      ; HL's page shows slot A; the interrupts left off
 11+  0000              DISSCR   EQU $0041      ; the display off
 12+  0000              ENASCR   EQU $0044      ; the display on
 13+  0000              WRTVDP   EQU $0047      ; B to VDP register C
 14+  0000              RDVRM    EQU $004A      ; A = the byte of the VRAM at HL (chapter 19)
 15+  0000              WRTVRM   EQU $004D      ; A to the VRAM at HL
 16+  0000              SETRD    EQU $0050      ; the VDP's address set to HL, to read
 17+  0000              SETWRT   EQU $0053      ; the VDP's address set to HL, to write
 18+  0000              FILVRM   EQU $0056      ; BC bytes of A to the VRAM from HL
 19+  0000              LDIRVM   EQU $005C      ; BC bytes from HL to the VRAM at DE
 20+  0000              CHGMOD   EQU $005F      ; the screen mode in A
 21+  0000              INITXT   EQU $006C      ; text mode, 40 x 24, with the BIOS's tables (chapter 21)
 22+  0000              INIT32   EQU $006F      ; Graphic I, 32 x 24
 23+  0000              INIGRP   EQU $0072      ; Graphic II
 24+  0000              INIMLT   EQU $0075      ; multicolour
 25+  0000              CHSNS    EQU $009C      ; Z if no key waits in the buffer (chapter 34)
 26+  0000              CHGET    EQU $009F      ; wait for a key; A = its code
 27+  0000              CHPUT    EQU $00A2      ; print the character in A
 28+  0000              BEEP     EQU $00C0      ; a beep (C-BIOS: none)
 29+  0000              GTSTCK   EQU $00D5      ; A = 0: the cursor keys; A = their direction, 0-8
 30+  0000              GTTRIG   EQU $00D8      ; A = 0 SPACE, 1-4 a joystick's button: A = $FF if held
 31+  0000              RSLREG   EQU $0138      ; A = port $A8, the primary slots (chapter 38)
 32+  0000              WSLREG   EQU $013B      ; port $A8 = A
 33+  0000              SNSMAT   EQU $0141      ; A = the keys of keyboard row A, 0 = held (chapter 34)
 34+  0000
 35+  0000              ; two bytes of data: the VDP's ports, for programs that ask
 36+  0000              VDP_DR   EQU $0006      ; the port the VRAM is read from
 37+  0000              VDP_DW   EQU $0007      ; the port it is written to
 38+  0000
 39+  0000              ; system variables
 40+  0000              LINLEN   EQU $F3B0      ; the width of a line of text
 41+  0000              TXTNAM   EQU $F3B3      ; where INITXT puts the tables: names, colours,
 42+  0000              TXTCOL   EQU $F3B5      ; patterns, sprite attributes, sprite patterns
 43+  0000              TXTCGP   EQU $F3B7      ; (chapter 21); two bytes each
 44+  0000              TXTATR   EQU $F3B9
 45+  0000              TXTPAT   EQU $F3BB
 46+  0000              T32NAM   EQU $F3BD      ; the same for INIT32
 47+  0000              T32COL   EQU $F3BF
 48+  0000              T32CGP   EQU $F3C1
 49+  0000              T32ATR   EQU $F3C3
 50+  0000              T32PAT   EQU $F3C5
 51+  0000              GRPNAM   EQU $F3C7      ; for INIGRP
 52+  0000              GRPCOL   EQU $F3C9
 53+  0000              GRPCGP   EQU $F3CB
 54+  0000              GRPATR   EQU $F3CD
 55+  0000              GRPPAT   EQU $F3CF
 56+  0000              MLTNAM   EQU $F3D1      ; for INIMLT
 57+  0000              MLTCOL   EQU $F3D3
 58+  0000              MLTCGP   EQU $F3D5
 59+  0000              MLTATR   EQU $F3D7
 60+  0000              MLTPAT   EQU $F3D9
 61+  0000              CSRY     EQU $F3DC      ; the cursor's line, from 1
 62+  0000              CSRX     EQU $F3DD      ; and its column, from 1
 63+  0000              RG0SAV   EQU $F3DF      ; the copy of VDP register n is at RG0SAV + n
 64+  0000              STATFL   EQU $F3E7      ; the last status the BIOS read
 65+  0000              FORCLR   EQU $F3E9      ; ink, paper and border, for CHGMOD
 66+  0000              BAKCLR   EQU $F3EA
 67+  0000              BDRCLR   EQU $F3EB
 68+  0000              SCNCNT   EQU $F3F6      ; interrupts left before the BIOS reads the keyboard
 69+  0000              PUTPNT   EQU $F3F8      ; where the next key goes into the key buffer
 70+  0000              GETPNT   EQU $F3FA      ; where CHGET takes the next one from
 71+  0000              NEWKEY   EQU $FBE5      ; the eleven rows, as the BIOS last read them
 72+  0000              JIFFY    EQU $FC9E      ; one more every frame interrupt
 73+  0000              SCRMOD   EQU $FCAF      ; the screen mode
 74+  0000              EXPTBL   EQU $FCC1      ; which slots are expanded: bit 7, one byte a slot
 75+  0000              SLTTBL   EQU $FCC5      ; the secondary registers, as the BIOS last wrote them
 76+  0000
 77+  0000              ; hooks: five bytes each, RET until a program puts a jump there
 78+  0000              H_KEYI   EQU $FD9A      ; H.KEYI, every interrupt
 79+  0000              H_TIMI   EQU $FD9F      ; H.TIMI, every frame interrupt
 80+  0000              H_CHPU   EQU $FDA4      ; H.CHPU, every character CHPUT prints
 81+  0000              H_CHGE   EQU $FDC2      ; H.CHGE, every call of CHGET
 82+  0000
