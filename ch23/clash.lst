171   41D7 3D                   dec a
172   41D8 C2 3B 41             jp nz, .col             ; JP: the loop is too long for JR
173   41DB C9                   ret
174   41DC
175   41DC              ; send: 16 bytes from HL down the screen, from the VRAM address in DE (the
176   41DC              ; write bit and the table in D); C: the line of the first. Inside a cell the
177   41DC              ; next line is the next byte (chapter 22): the bytes go in runs, one for each
178   41DC              ; cell, and between runs the address moves to line 0 of the cell below.
179   41DC C5           send:   push bc
180   41DD 79                   ld a, c
181   41DE F6 F8                or $F8
182   41E0 ED 44                neg                     ; the first run: 8 - (y AND 7), 1 to 8
183   41E2 47                   ld b, a
184   41E3 3E 10                ld a, 16
185   41E5 90                   sub b                   ; the bytes after it
186   41E6 0E 98                ld c, VDP_DATA
187   41E8 F5           .run:   push af
188   41E9 7B                   ld a, e
189   41EA D3 99                out (VDP_CTRL), a
190   41EC 7A                   ld a, d
191   41ED D3 99                out (VDP_CTRL), a       ; the run's address
192   41EF ED B3                otir                    ; its bytes, off the paper (chapter 20)
193   41F1 14                   inc d                   ; the cell below: 256 bytes on,
194   41F2 7B                   ld a, e
195   41F3 E6 F8                and $F8
196   41F5 5F                   ld e, a                 ; at its line 0
197   41F6 F1                   pop af
198   41F7 B7                   or a
199   41F8 28 09                jr z, .done             ; no bytes left
200   41FA 06 08                ld b, 8
201   41FC B8                   cp b
202   41FD 30 01                jr nc, .full
203   41FF 47                   ld b, a                 ; the last run: what is left
204   4200 90           .full:  sub b
205   4201 18 E5                jr .run
206   4203 C1           .done:  pop bc
207   4204 C9                   ret
208   4205
209   4205              ; vaddr: B = x, C = y -> HL = the address of the byte that holds pixel (x, y),
210   4205              ; in the patterns of a Graphic II screen whose names run 0 to 255 in each
211   4205              ; third; add $2000 for its colours. Uses A. (Chapter 22.)
212   4205 79           vaddr:  ld a, c
213   4206 0F                   rrca
214   4207 0F                   rrca
215   4208 0F                   rrca
216   4209 E6 1F                and $1F                 ; y / 8, the row of characters
217   420B 67                   ld h, a
218   420C 78                   ld a, b
219   420D E6 F8                and $F8                 ; the column of characters, x 8
220   420F 6F                   ld l, a
221   4210 79                   ld a, c
222   4211 E6 07                and 7                   ; the line in the cell
223   4213 B5                   or l
224   4214 6F                   ld l, a
225   4215 C9                   ret
226   4216
227   4216              ; fill: the 192 bytes of a scene table, one a line, into all 32 columns of the
228   4216              ; table at the VRAM address in DE (write bit included); the display is off
229   4216 7B           fill:   ld a, e
230   4217 D3 99                out (VDP_CTRL), a
231   4219 7A                   ld a, d
232   421A D3 99                out (VDP_CTRL), a
233   421C 0E 98                ld c, VDP_DATA
234   421E 16 18                ld d, 24                ; 24 rows of cells
235   4220 1E 20        .row:   ld e, 32                ; of 32 cells
236   4222 E5           .cell:  push hl
237   4223 06 08                ld b, 8
238   4225 ED B3                otir                    ; a cell's eight lines
239   4227 E1                   pop hl
240   4228 1D                   dec e
241   4229 20 F7                jr nz, .cell
242   422B 7D                   ld a, l
243   422C C6 08                add a, 8
244   422E 6F                   ld l, a                 ; the next row's lines (L = y)
245   422F 15                   dec d
246   4230 20 EE                jr nz, .row
247   4232 C9                   ret
