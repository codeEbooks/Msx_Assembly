168   41CF              ; send: 16 bytes from HL down the screen, from the VRAM address in DE (the
169   41CF              ; write bit and the table in D); C: the line of the first. Inside a cell the
170   41CF              ; next line is the next byte (chapter 22): the bytes go in runs, one for each
171   41CF              ; cell, and between runs the address moves to line 0 of the cell below.
172   41CF C5           send:   push bc
173   41D0 79                   ld a, c
174   41D1 F6 F8                or $F8
175   41D3 ED 44                neg                     ; the first run: 8 - (y AND 7), 1 to 8
176   41D5 47                   ld b, a
177   41D6 3E 10                ld a, 16
178   41D8 90                   sub b                   ; the bytes after it
179   41D9 0E 98                ld c, VDP_DATA
180   41DB F5           .run:   push af
181   41DC 7B                   ld a, e
182   41DD D3 99                out (VDP_CTRL), a
183   41DF 7A                   ld a, d
184   41E0 D3 99                out (VDP_CTRL), a       ; the run's address
185   41E2 ED B3                otir                    ; its bytes, off the paper (chapter 20)
186   41E4 14                   inc d                   ; the cell below: 256 bytes on,
187   41E5 7B                   ld a, e
188   41E6 E6 F8                and $F8
189   41E8 5F                   ld e, a                 ; at its line 0
190   41E9 F1                   pop af
191   41EA B7                   or a
192   41EB 28 09                jr z, .done             ; no bytes left
193   41ED 06 08                ld b, 8
194   41EF B8                   cp b
195   41F0 30 01                jr nc, .full
196   41F2 47                   ld b, a                 ; the last run: what is left
197   41F3 90           .full:  sub b
198   41F4 18 E5                jr .run
199   41F6 C1           .done:  pop bc
200   41F7 C9                   ret
201   41F8
202   41F8              ; vaddr: B = x, C = y -> HL = the address of the byte that holds pixel (x, y),
203   41F8              ; in the patterns of a Graphic II screen whose names run 0 to 255 in each
204   41F8              ; third; add $2000 for its colours. Uses A. (Chapter 22.)
205   41F8 79           vaddr:  ld a, c
206   41F9 0F                   rrca
207   41FA 0F                   rrca
208   41FB 0F                   rrca
209   41FC E6 1F                and $1F                 ; y / 8, the row of characters
210   41FE 67                   ld h, a
211   41FF 78                   ld a, b
212   4200 E6 F8                and $F8                 ; the column of characters, x 8
213   4202 6F                   ld l, a
214   4203 79                   ld a, c
215   4204 E6 07                and 7                   ; the line in the cell
216   4206 B5                   or l
217   4207 6F                   ld l, a
218   4208 C9                   ret
219   4209
220   4209              ; fill: the 192 bytes of a scene table, one a line, into all 32 columns of the
221   4209              ; table at the VRAM address in DE (write bit included); the display is off
222   4209 7B           fill:   ld a, e
223   420A D3 99                out (VDP_CTRL), a
224   420C 7A                   ld a, d
225   420D D3 99                out (VDP_CTRL), a
226   420F 0E 98                ld c, VDP_DATA
227   4211 16 18                ld d, 24                ; 24 rows of cells
228   4213 1E 20        .row:   ld e, 32                ; of 32 cells
229   4215 E5           .cell:  push hl
230   4216 06 08                ld b, 8
231   4218 ED B3                otir                    ; a cell's eight lines
232   421A E1                   pop hl
233   421B 1D                   dec e
234   421C 20 F7                jr nz, .cell
235   421E 7D                   ld a, l
236   421F C6 08                add a, 8
237   4221 6F                   ld l, a                 ; the next row's lines (L = y)
238   4222 15                   dec d
239   4223 20 EE                jr nz, .row
240   4225 C9                   ret
241   4226
