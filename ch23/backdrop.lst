169   41CD              ; send: 16 bytes from HL down the screen, from the VRAM address in DE (the
170   41CD              ; write bit and the table in D); C: the line of the first. Inside a cell the
171   41CD              ; next line is the next byte (chapter 22): the bytes go in runs, one for each
172   41CD              ; cell, and between runs the address moves to line 0 of the cell below.
173   41CD C5           send:   push bc
174   41CE 79                   ld a, c
175   41CF F6 F8                or $F8
176   41D1 ED 44                neg                     ; the first run: 8 - (y AND 7), 1 to 8
177   41D3 47                   ld b, a
178   41D4 3E 10                ld a, 16
179   41D6 90                   sub b                   ; the bytes after it
180   41D7 0E 98                ld c, VDP_DATA
181   41D9 F5           .run:   push af
182   41DA 7B                   ld a, e
183   41DB D3 99                out (VDP_CTRL), a
184   41DD 7A                   ld a, d
185   41DE D3 99                out (VDP_CTRL), a       ; the run's address
186   41E0 ED B3                otir                    ; its bytes, off the paper (chapter 20)
187   41E2 14                   inc d                   ; the cell below: 256 bytes on,
188   41E3 7B                   ld a, e
189   41E4 E6 F8                and $F8
190   41E6 5F                   ld e, a                 ; at its line 0
191   41E7 F1                   pop af
192   41E8 B7                   or a
193   41E9 28 09                jr z, .done             ; no bytes left
194   41EB 06 08                ld b, 8
195   41ED B8                   cp b
196   41EE 30 01                jr nc, .full
197   41F0 47                   ld b, a                 ; the last run: what is left
198   41F1 90           .full:  sub b
199   41F2 18 E5                jr .run
200   41F4 C1           .done:  pop bc
201   41F5 C9                   ret
202   41F6
203   41F6              ; vaddr: B = x, C = y -> HL = the address of the byte that holds pixel (x, y),
204   41F6              ; in the patterns of a Graphic II screen whose names run 0 to 255 in each
205   41F6              ; third; add $2000 for its colours. Uses A. (Chapter 22.)
206   41F6 79           vaddr:  ld a, c
207   41F7 0F                   rrca
208   41F8 0F                   rrca
209   41F9 0F                   rrca
210   41FA E6 1F                and $1F                 ; y / 8, the row of characters
211   41FC 67                   ld h, a
212   41FD 78                   ld a, b
213   41FE E6 F8                and $F8                 ; the column of characters, x 8
214   4200 6F                   ld l, a
215   4201 79                   ld a, c
216   4202 E6 07                and 7                   ; the line in the cell
217   4204 B5                   or l
218   4205 6F                   ld l, a
219   4206 C9                   ret
220   4207
221   4207              ; fill: the 192 bytes of a scene table, one a line, into all 32 columns of the
222   4207              ; table at the VRAM address in DE (write bit included); the display is off
223   4207 7B           fill:   ld a, e
224   4208 D3 99                out (VDP_CTRL), a
225   420A 7A                   ld a, d
226   420B D3 99                out (VDP_CTRL), a
227   420D 0E 98                ld c, VDP_DATA
228   420F 16 18                ld d, 24                ; 24 rows of cells
229   4211 1E 20        .row:   ld e, 32                ; of 32 cells
230   4213 E5           .cell:  push hl
231   4214 06 08                ld b, 8
232   4216 ED B3                otir                    ; a cell's eight lines
233   4218 E1                   pop hl
234   4219 1D                   dec e
235   421A 20 F7                jr nz, .cell
236   421C 7D                   ld a, l
237   421D C6 08                add a, 8
238   421F 6F                   ld l, a                 ; the next row's lines (L = y)
239   4220 15                   dec d
240   4221 20 EE                jr nz, .row
241   4223 C9                   ret
242   4224
243   4224              ; the scene: for every line of the screen a byte of shape and a byte of colour,
244   4224              ; the same in every column; each table a page of its own, so that L = y
