169   41CF              ; send: 16 bytes from HL down the screen, from the VRAM address in DE (the
170   41CF              ; write bit and the table in D); C: the line of the first. Inside a cell the
171   41CF              ; next line is the next byte (chapter 22): the bytes go in runs, one for each
172   41CF              ; cell, and between runs the address moves to line 0 of the cell below.
173   41CF C5           send:   push bc
174   41D0 79                   ld a, c
175   41D1 F6 F8                or $F8
176   41D3 ED 44                neg                     ; the first run: 8 - (y AND 7), 1 to 8
177   41D5 47                   ld b, a
178   41D6 3E 10                ld a, 16
179   41D8 90                   sub b                   ; the bytes after it
180   41D9 0E 98                ld c, VDP_DATA
181   41DB F5           .run:   push af
182   41DC 7B                   ld a, e
183   41DD D3 99                out (VDP_CTRL), a
184   41DF 7A                   ld a, d
185   41E0 D3 99                out (VDP_CTRL), a       ; the run's address
186   41E2 ED B3                otir                    ; its bytes, off the paper (chapter 20)
187   41E4 14                   inc d                   ; the cell below: 256 bytes on,
188   41E5 7B                   ld a, e
189   41E6 E6 F8                and $F8
190   41E8 5F                   ld e, a                 ; at its line 0
191   41E9 F1                   pop af
192   41EA B7                   or a
193   41EB 28 09                jr z, .done             ; no bytes left
194   41ED 06 08                ld b, 8
195   41EF B8                   cp b
196   41F0 30 01                jr nc, .full
197   41F2 47                   ld b, a                 ; the last run: what is left
198   41F3 90           .full:  sub b
199   41F4 18 E5                jr .run
200   41F6 C1           .done:  pop bc
201   41F7 C9                   ret
202   41F8
203   41F8              ; vaddr: B = x, C = y -> HL = the address of the byte that holds pixel (x, y),
204   41F8              ; in the patterns of a Graphic II screen whose names run 0 to 255 in each
205   41F8              ; third; add $2000 for its colours. Uses A. (Chapter 22.)
206   41F8 79           vaddr:  ld a, c
207   41F9 0F                   rrca
208   41FA 0F                   rrca
209   41FB 0F                   rrca
210   41FC E6 1F                and $1F                 ; y / 8, the row of characters
211   41FE 67                   ld h, a
212   41FF 78                   ld a, b
213   4200 E6 F8                and $F8                 ; the column of characters, x 8
214   4202 6F                   ld l, a
215   4203 79                   ld a, c
216   4204 E6 07                and 7                   ; the line in the cell
217   4206 B5                   or l
218   4207 6F                   ld l, a
219   4208 C9                   ret
220   4209
221   4209              ; fill: the 192 bytes of a scene table, one a line, into all 32 columns of the
222   4209              ; table at the VRAM address in DE (write bit included); the display is off
223   4209 7B           fill:   ld a, e
224   420A D3 99                out (VDP_CTRL), a
225   420C 7A                   ld a, d
226   420D D3 99                out (VDP_CTRL), a
227   420F 0E 98                ld c, VDP_DATA
228   4211 16 18                ld d, 24                ; 24 rows of cells
229   4213 1E 20        .row:   ld e, 32                ; of 32 cells
230   4215 E5           .cell:  push hl
231   4216 06 08                ld b, 8
232   4218 ED B3                otir                    ; a cell's eight lines
233   421A E1                   pop hl
234   421B 1D                   dec e
235   421C 20 F7                jr nz, .cell
236   421E 7D                   ld a, l
237   421F C6 08                add a, 8
238   4221 6F                   ld l, a                 ; the next row's lines (L = y)
239   4222 15                   dec d
240   4223 20 EE                jr nz, .row
241   4225 C9                   ret
242   4226
