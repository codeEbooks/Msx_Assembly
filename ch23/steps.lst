169   41D6 CD E6 41             call send
170   41D9 21 06 C1     .next:  ld hl, vptr
171   41DC 7E                   ld a, (hl)
172   41DD C6 08                add a, 8
173   41DF 77                   ld (hl), a
174   41E0 F1                   pop af
175   41E1 3D                   dec a
176   41E2 C2 45 41             jp nz, .col             ; JP: the loop is too long for JR
177   41E5 C9                   ret
178   41E6
179   41E6              ; send: 16 bytes from HL down the screen, from the VRAM address in DE (the
180   41E6              ; write bit and the table in D); C: the line of the first. Inside a cell the
181   41E6              ; next line is the next byte (chapter 22): the bytes go in runs, one for each
182   41E6              ; cell, and between runs the address moves to line 0 of the cell below.
183   41E6 C5           send:   push bc
184   41E7 79                   ld a, c
185   41E8 F6 F8                or $F8
186   41EA ED 44                neg                     ; the first run: 8 - (y AND 7), 1 to 8
187   41EC 47                   ld b, a
188   41ED 3E 10                ld a, 16
189   41EF 90                   sub b                   ; the bytes after it
190   41F0 0E 98                ld c, VDP_DATA
191   41F2 F5           .run:   push af
192   41F3 7B                   ld a, e
193   41F4 D3 99                out (VDP_CTRL), a
194   41F6 7A                   ld a, d
195   41F7 D3 99                out (VDP_CTRL), a       ; the run's address
196   41F9 ED B3                otir                    ; its bytes, off the paper (chapter 20)
197   41FB 14                   inc d                   ; the cell below: 256 bytes on,
198   41FC 7B                   ld a, e
199   41FD E6 F8                and $F8
200   41FF 5F                   ld e, a                 ; at its line 0
201   4200 F1                   pop af
202   4201 B7                   or a
203   4202 28 09                jr z, .done             ; no bytes left
204   4204 06 08                ld b, 8
205   4206 B8                   cp b
206   4207 30 01                jr nc, .full
207   4209 47                   ld b, a                 ; the last run: what is left
208   420A 90           .full:  sub b
209   420B 18 E5                jr .run
210   420D C1           .done:  pop bc
211   420E C9                   ret
212   420F
213   420F              ; vaddr: B = x, C = y -> HL = the address of the byte that holds pixel (x, y),
214   420F              ; in the patterns of a Graphic II screen whose names run 0 to 255 in each
215   420F              ; third; add $2000 for its colours. Uses A. (Chapter 22.)
216   420F 79           vaddr:  ld a, c
217   4210 0F                   rrca
218   4211 0F                   rrca
219   4212 0F                   rrca
220   4213 E6 1F                and $1F                 ; y / 8, the row of characters
221   4215 67                   ld h, a
222   4216 78                   ld a, b
223   4217 E6 F8                and $F8                 ; the column of characters, x 8
224   4219 6F                   ld l, a
225   421A 79                   ld a, c
226   421B E6 07                and 7                   ; the line in the cell
227   421D B5                   or l
228   421E 6F                   ld l, a
229   421F C9                   ret
230   4220
231   4220              ; fill: the 192 bytes of a scene table, one a line, into all 32 columns of the
232   4220              ; table at the VRAM address in DE (write bit included); the display is off
233   4220 7B           fill:   ld a, e
234   4221 D3 99                out (VDP_CTRL), a
235   4223 7A                   ld a, d
236   4224 D3 99                out (VDP_CTRL), a
237   4226 0E 98                ld c, VDP_DATA
238   4228 16 18                ld d, 24                ; 24 rows of cells
