 4    0000                      OUTPUT "cart.rom"
 5    0000                      ORG $4000
 6    4000                      CART_HEADER init
 6    4000 41 42       >        db "AB"
 6    4002 10 40       >        dw init
 6    4004 00 00 00 00 >        dw 0, 0, 0
 6    4008 00 00       >
 6    400A 00 00 00... >        ds 6, 0
 7    4010 F3           init:   di
 8    4011                      VDP_REG 7, LIGHT_GREEN  ; the border
 8    4011 3E 03       >        ld a, LIGHT_GREEN
 8    4013 D3 99       >        out (VDP_CTRL), a
 8    4015 3E 87       >        ld a, $80 | (7)
