   8+ 0000              PSG_READ    EQU $A2         ; PSG data read
   9+ 0000              PPI_A       EQU $A8         ; primary slot register
  10+ 0000              PPI_B       EQU $A9         ; keyboard columns (read)
  11+ 0000              PPI_C       EQU $AA         ; keyboard row (bits 0-3), cassette, CAPS LED, click
  12+ 0000              PPI_MODE    EQU $AB         ; PPI control
  13+ 0000
  14+ 0000              RAM_START   EQU $C000       ; the book's 16 KB floor: $C000-$FFFF
  15+ 0000              SYS_AREA    EQU $F380       ; BIOS work area starts here: programs stay below
  16+ 0000              CGTABL      EQU $0004       ; BIOS: the address of the character set (2 bytes)
  17+ 0000
  18+ 0000              ; the sixteen colour codes of the VDP (chapter 1 photographed them)
  19+ 0000              TRANSPARENT  EQU 0
  20+ 0000              BLACK        EQU 1
  21+ 0000              MEDIUM_GREEN EQU 2
  22+ 0000              LIGHT_GREEN  EQU 3
  23+ 0000              DARK_BLUE    EQU 4
  24+ 0000              LIGHT_BLUE   EQU 5
