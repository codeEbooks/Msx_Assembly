 47+  4010              GRPATR   EQU $F3CD
 48+  4010              GRPPAT   EQU $F3CF
 49+  4010              MLTNAM   EQU $F3D1      ; for INIMLT
 50+  4010              MLTCOL   EQU $F3D3
 51+  4010              MLTCGP   EQU $F3D5
 52+  4010              MLTATR   EQU $F3D7
 53+  4010              MLTPAT   EQU $F3D9
 54+  4010              CSRY     EQU $F3DC      ; the cursor's line, from 1
 55+  4010              CSRX     EQU $F3DD      ; and its column, from 1
 56+  4010              RG0SAV   EQU $F3DF      ; the copy of VDP register n is at RG0SAV + n
 57+  4010              STATFL   EQU $F3E7      ; the last status the BIOS read
