239   41FA              ; scan: B rows of the keyboard, from row 0, into the bytes from HL; a bit at 0
240   41FA              ; is a key held down. Port C's top four bits drive the cassette motor and its
241   41FA              ; output, the CAPS lamp and the click (chapter 3): they go back as they were.
242   41FA              ; The interrupts must be off. Uses A, B, C, HL
243   41FA DB AA        scan:   in a, (PPI_C)           ; 12
244   41FC E6 F0                and $F0                 ;  8  the top four bits
245   41FE 4F                   ld c, a                 ;  5  and row 0
246   41FF 79           .row:   ld a, c                 ;  5
247   4200 D3 AA                out (PPI_C), a          ; 12  the row
248   4202 DB A9                in a, (PPI_B)           ; 12  its eight keys
249   4204 77                   ld (hl), a              ;  8
250   4205 23                   inc hl                  ;  7
251   4206 0C                   inc c                   ;  5  the next row
252   4207 10 F6                djnz .row               ; 14 / 9
253   4209 C9                   ret                     ; 11
254   420A
255   420A              ; isr: every frame, a frame counted. Keeps AF
256   420A F5           isr:    push af
257   420B DB 99                in a, (VDP_CTRL)        ; the status: the signal down
258   420D 3A 00 C1             ld a, (ticks)
259   4210 3C                   inc a
260   4211 32 00 C1             ld (ticks), a
261   4214 F1                   pop af
262   4215 FB                   ei
263   4216 C9                   ret
264   4217
265   4217              ; at: the next characters go to row D, column E (chapter 30)
266   4217 7A           at:     ld a, d
267   4218 0F                   rrca
268   4219 0F                   rrca
269   421A 0F                   rrca
270   421B 4F                   ld c, a
271   421C E6 E0                and $E0
272   421E B3                   or e
273   421F D3 99                out (VDP_CTRL), a
274   4221 79                   ld a, c
275   4222 E6 03                and $03
276   4224 F6 58                or $18 | $40
277   4226 D3 99                out (VDP_CTRL), a
278   4228 C9                   ret
279   4229
280   4229              ; cells: A as eight boxes from bit 7, a filled box for a 0 (a key held) and
281   4229              ; an empty one for a 1, from the address set. Uses A, B, L
282   4229 6F           cells:  ld l, a
283   422A 06 08                ld b, 8
284   422C 3E 02        .cell:  ld a, 2
285   422E CB 05                rlc l                   ; the next bit, into the carry
286   4230 30 02                jr nc, .put             ; 0: held
287   4232 3E 01                ld a, 1
288   4234 D3 98        .put:   out (VDP_DATA), a
289   4236 10 F4                djnz .cell
290   4238 C9                   ret
291   4239
292   4239              ; hex: A as two hexadecimal digits, from the address set. Uses A, C
293   4239 4F           hex:    ld c, a
294   423A 0F                   rrca
295   423B 0F                   rrca
296   423C 0F                   rrca
297   423D 0F                   rrca
298   423E CD 42 42             call .digit
299   4241 79                   ld a, c
300   4242 E6 0F        .digit: and $0F
301   4244 C6 30                add a, '0'
302   4246 FE 3A                cp '9' + 1
303   4248 38 02                jr c, .out
304   424A C6 07                add a, 'A' - '9' - 1
305   424C D3 98        .out:   out (VDP_DATA), a
306   424E C9                   ret
307   424F
308   424F              ; send: E blocks of 256 bytes from HL to the VDP
309   424F 0E 98        send:   ld c, VDP_DATA
310   4251 06 00                ld b, 0
311   4253 ED B3        .otir:  otir
312   4255 1D                   dec e
313   4256 20 FB                jr nz, .otir
314   4258 C9                   ret
