159   442F D3 99                out (VDP_CTRL), a
160   4431 7C                   ld a, h
161   4432 F6 40                or $40
162   4434 D3 99                out (VDP_CTRL), a
163   4436 D1                   pop de
164   4437 C9                   ret
165   4438
166   4438              ; putc: A = character, B = row, C = column. Keeps BC, DE, HL.
167   4438 E5           putc:   push hl
168   4439 F5                   push af
169   443A CD 21 44             call at
170   443D F1                   pop af
171   443E D3 98                out (VDP_DATA), a
172   4440 E1                   pop hl
173   4441 C9                   ret
174   4442
175   4442              ; puts: HL = text ending in 0, B = row, C = column; C moves on.
176   4442 7E           puts:   ld a, (hl)
177   4443 B7                   or a
178   4444 C8                   ret z
179   4445 CD 38 44             call putc
180   4448 23                   inc hl
181   4449 0C                   inc c
182   444A 18 F6                jr puts
183   444C
184   444C              ; puthex: A = a byte, as two hexadecimal digits; C moves on by 2.
185   444C F5           puthex: push af
186   444D 0F                   rrca
187   444E 0F                   rrca
188   444F 0F                   rrca
189   4450 0F                   rrca                    ; the high four bits first
190   4451 CD 55 44             call hexdig
191   4454 F1                   pop af
192   4455 E6 0F        hexdig: and %00001111
193   4457 C6 30                add a, '0'
194   4459 FE 3A                cp '9' + 1
195   445B 38 02                jr c, .digit
196   445D C6 07                add a, 'A' - '9' - 1    ; 10-15 become A-F
197   445F CD 38 44     .digit: call putc
198   4462 0C                   inc c
199   4463 C9                   ret
200   4464              boxes:                          ; characters 1 (empty box) and 2 (filled)
201   4464 FE 82 82 82          db %11111110, %10000010, %10000010, %10000010, %10000010, %10000010, %11111110, %00000000
201   4468 82 82 FE 00
202   446C FE FE FE FE          db %11111110, %11111110, %11111110, %11111110, %11111110, %11111110, %11111110, %00000000
202   4470 FE FE FE 00
203   4474                      ASSERT $ <= $8000, the program is longer than the cartridge
204   4474 FF FF FF...          ds $8000 - $, $FF       ; pad the cartridge to 16 KB
205   8000
# file closed: otir.asm
