379   4355              ; at: B = row (0-23), C = column (0-31) -> the VDP's write address is that
380   4355              ;     cell of the name table. Keeps BC, DE. Uses A, HL.
381   4355 D5           at:     push de
382   4356 68                   ld l, b
383   4357 26 00                ld h, 0
384   4359 29                   add hl, hl
385   435A 29                   add hl, hl
386   435B 29                   add hl, hl
387   435C 29                   add hl, hl
388   435D 29                   add hl, hl              ; row x 32
389   435E 59                   ld e, c
390   435F 16 18                ld d, $18
391   4361 19                   add hl, de              ; + $1800 + column
392   4362 7D                   ld a, l
393   4363 D3 99                out (VDP_CTRL), a
394   4365 7C                   ld a, h
395   4366 F6 40                or $40
396   4368 D3 99                out (VDP_CTRL), a
397   436A D1                   pop de
398   436B C9                   ret
399   436C
400   436C              ; putc: A = character, B = row, C = column. Keeps BC, DE, HL.
401   436C E5           putc:   push hl
402   436D F5                   push af
403   436E CD 55 43             call at
404   4371 F1                   pop af
405   4372 D3 98                out (VDP_DATA), a
406   4374 E1                   pop hl
407   4375 C9                   ret
408   4376
409   4376              ; puts: HL = text ending in 0, B = row, C = column; C moves on.
410   4376 7E           puts:   ld a, (hl)
411   4377 B7                   or a
412   4378 C8                   ret z
413   4379 CD 6C 43             call putc
414   437C 23                   inc hl
415   437D 0C                   inc c
416   437E 18 F6                jr puts
417   4380
418   4380              ; puthex: A = a byte, as two hexadecimal digits; C moves on by 2.
419   4380 F5           puthex: push af
420   4381 0F                   rrca
421   4382 0F                   rrca
422   4383 0F                   rrca
423   4384 0F                   rrca                    ; the high four bits first
424   4385 CD 89 43             call hexdig
425   4388 F1                   pop af
426   4389 E6 0F        hexdig: and %00001111
427   438B C6 30                add a, '0'
428   438D FE 3A                cp '9' + 1
429   438F 38 02                jr c, .digit
430   4391 C6 07                add a, 'A' - '9' - 1    ; 10-15 become A-F
431   4393 CD 6C 43     .digit: call putc
432   4396 0C                   inc c
433   4397 C9                   ret
434   4398              boxes:                          ; characters 1 (empty box) and 2 (filled)
435   4398 FE 82 82 82          db %11111110, %10000010, %10000010, %10000010, %10000010, %10000010, %11111110, %00000000
435   439C 82 82 FE 00
436   43A0 FE FE FE FE          db %11111110, %11111110, %11111110, %11111110, %11111110, %11111110, %11111110, %00000000
436   43A4 FE FE FE 00
437   43A8                      ASSERT $ <= $8000, the program is longer than the cartridge
438   43A8 FF FF FF...          ds $8000 - $, $FF       ; pad the cartridge to 16 KB
439   8000
