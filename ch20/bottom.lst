124   435C 32 33 34 35
124   4360 41 42 43 44
124   4364 45 46 47 48
124   4368 49 4A 4B 4C
124   436C 4D 4E 4F 50
124   4370 51 52 53 54
124   4374 55 56 57 58
124   4378 59 5A 30 31
124   437C 32 33 34 35
125   4380
126   4380              ; at: B = row (0-23), C = column (0-31) -> the VDP's write address is that
127   4380              ;     cell of the name table. Keeps BC, DE. Uses A, HL.
128   4380 D5           at:     push de
129   4381 68                   ld l, b
130   4382 26 00                ld h, 0
131   4384 29                   add hl, hl
132   4385 29                   add hl, hl
133   4386 29                   add hl, hl
134   4387 29                   add hl, hl
135   4388 29                   add hl, hl              ; row x 32
136   4389 59                   ld e, c
137   438A 16 18                ld d, $18
138   438C 19                   add hl, de              ; + $1800 + column
139   438D 7D                   ld a, l
140   438E D3 99                out (VDP_CTRL), a
141   4390 7C                   ld a, h
142   4391 F6 40                or $40
143   4393 D3 99                out (VDP_CTRL), a
144   4395 D1                   pop de
145   4396 C9                   ret
146   4397
147   4397              ; putc: A = character, B = row, C = column. Keeps BC, DE, HL.
148   4397 E5           putc:   push hl
149   4398 F5                   push af
150   4399 CD 80 43             call at
151   439C F1                   pop af
152   439D D3 98                out (VDP_DATA), a
153   439F E1                   pop hl
154   43A0 C9                   ret
155   43A1
156   43A1              ; puts: HL = text ending in 0, B = row, C = column; C moves on.
157   43A1 7E           puts:   ld a, (hl)
158   43A2 B7                   or a
159   43A3 C8                   ret z
160   43A4 CD 97 43             call putc
161   43A7 23                   inc hl
162   43A8 0C                   inc c
163   43A9 18 F6                jr puts
164   43AB
165   43AB              ; puthex: A = a byte, as two hexadecimal digits; C moves on by 2.
166   43AB F5           puthex: push af
167   43AC 0F                   rrca
168   43AD 0F                   rrca
169   43AE 0F                   rrca
170   43AF 0F                   rrca                    ; the high four bits first
171   43B0 CD B4 43             call hexdig
172   43B3 F1                   pop af
173   43B4 E6 0F        hexdig: and %00001111
174   43B6 C6 30                add a, '0'
175   43B8 FE 3A                cp '9' + 1
176   43BA 38 02                jr c, .digit
177   43BC C6 07                add a, 'A' - '9' - 1    ; 10-15 become A-F
178   43BE CD 97 43     .digit: call putc
179   43C1 0C                   inc c
180   43C2 C9                   ret
181   43C3              boxes:                          ; characters 1 (empty box) and 2 (filled)
182   43C3 FE 82 82 82          db %11111110, %10000010, %10000010, %10000010, %10000010, %10000010, %11111110, %00000000
182   43C7 82 82 FE 00
183   43CB FE FE FE FE          db %11111110, %11111110, %11111110, %11111110, %11111110, %11111110, %11111110, %00000000
183   43CF FE FE FE 00
184   43D3                      ASSERT $ <= $8000, the program is longer than the cartridge
185   43D3 FF FF FF...          ds $8000 - $, $FF       ; pad the cartridge to 16 KB
186   8000
