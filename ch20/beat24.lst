377   4353              ; at: B = row (0-23), C = column (0-31) -> the VDP's write address is that
378   4353              ;     cell of the name table. Keeps BC, DE. Uses A, HL.
379   4353 D5           at:     push de
380   4354 68                   ld l, b
381   4355 26 00                ld h, 0
382   4357 29                   add hl, hl
383   4358 29                   add hl, hl
384   4359 29                   add hl, hl
385   435A 29                   add hl, hl
386   435B 29                   add hl, hl              ; row x 32
387   435C 59                   ld e, c
388   435D 16 18                ld d, $18
389   435F 19                   add hl, de              ; + $1800 + column
390   4360 7D                   ld a, l
391   4361 D3 99                out (VDP_CTRL), a
392   4363 7C                   ld a, h
393   4364 F6 40                or $40
394   4366 D3 99                out (VDP_CTRL), a
395   4368 D1                   pop de
396   4369 C9                   ret
397   436A
398   436A              ; putc: A = character, B = row, C = column. Keeps BC, DE, HL.
399   436A E5           putc:   push hl
400   436B F5                   push af
401   436C CD 53 43             call at
402   436F F1                   pop af
403   4370 D3 98                out (VDP_DATA), a
404   4372 E1                   pop hl
405   4373 C9                   ret
406   4374
407   4374              ; puts: HL = text ending in 0, B = row, C = column; C moves on.
408   4374 7E           puts:   ld a, (hl)
409   4375 B7                   or a
410   4376 C8                   ret z
411   4377 CD 6A 43             call putc
412   437A 23                   inc hl
413   437B 0C                   inc c
414   437C 18 F6                jr puts
415   437E
416   437E              ; puthex: A = a byte, as two hexadecimal digits; C moves on by 2.
417   437E F5           puthex: push af
418   437F 0F                   rrca
419   4380 0F                   rrca
420   4381 0F                   rrca
421   4382 0F                   rrca                    ; the high four bits first
422   4383 CD 87 43             call hexdig
423   4386 F1                   pop af
424   4387 E6 0F        hexdig: and %00001111
425   4389 C6 30                add a, '0'
426   438B FE 3A                cp '9' + 1
427   438D 38 02                jr c, .digit
428   438F C6 07                add a, 'A' - '9' - 1    ; 10-15 become A-F
429   4391 CD 6A 43     .digit: call putc
430   4394 0C                   inc c
431   4395 C9                   ret
432   4396              boxes:                          ; characters 1 (empty box) and 2 (filled)
433   4396 FE 82 82 82          db %11111110, %10000010, %10000010, %10000010, %10000010, %10000010, %11111110, %00000000
433   439A 82 82 FE 00
434   439E FE FE FE FE          db %11111110, %11111110, %11111110, %11111110, %11111110, %11111110, %11111110, %00000000
434   43A2 FE FE FE 00
435   43A6                      ASSERT $ <= $8000, the program is longer than the cartridge
436   43A6 FF FF FF...          ds $8000 - $, $FF       ; pad the cartridge to 16 KB
437   8000
