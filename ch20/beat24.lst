  9   4010              IM2_TABLE EQU $C200             ; 257 bytes of $C3: every vector is $C3C3
 10   4010              IM2_JUMP  EQU $C3C3             ; and there, a JP to the routine
 11   4010              BOX_EMPTY EQU 1             ; the library's two boxes, characters 1 and 2
 12   4010              BOX_FULL  EQU 2
 13   4010              ; 228 pairs of bytes, the filled box and then the empty one 24 T-states after,
 14   4010              ; 119 T-states apart: the first pair's first byte at T-state 0 of the paper's
 15   4010              ; line 3, the others at every other T-state of a line once. Each pair goes to
 16   4010              ; two cells of the name table: the pair made at T-state p, to cells 2p and 2p + 1.
