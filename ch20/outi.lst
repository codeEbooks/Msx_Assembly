159   4431 7D                   ld a, l
160   4432 D3 99                out (VDP_CTRL), a
161   4434 7C                   ld a, h
162   4435 F6 40                or $40
163   4437 D3 99                out (VDP_CTRL), a
164   4439 D1                   pop de
165   443A C9                   ret
166   443B
167   443B              ; putc: A = character, B = row, C = column. Keeps BC, DE, HL.
168   443B E5           putc:   push hl
169   443C F5                   push af
170   443D CD 24 44             call at
171   4440 F1                   pop af
172   4441 D3 98                out (VDP_DATA), a
173   4443 E1                   pop hl
174   4444 C9                   ret
175   4445
176   4445              ; puts: HL = text ending in 0, B = row, C = column; C moves on.
177   4445 7E           puts:   ld a, (hl)
178   4446 B7                   or a
179   4447 C8                   ret z
180   4448 CD 3B 44             call putc
181   444B 23                   inc hl
182   444C 0C                   inc c
183   444D 18 F6                jr puts
184   444F
185   444F              ; puthex: A = a byte, as two hexadecimal digits; C moves on by 2.
186   444F F5           puthex: push af
187   4450 0F                   rrca
188   4451 0F                   rrca
189   4452 0F                   rrca
190   4453 0F                   rrca                    ; the high four bits first
191   4454 CD 58 44             call hexdig
192   4457 F1                   pop af
193   4458 E6 0F        hexdig: and %00001111
194   445A C6 30                add a, '0'
195   445C FE 3A                cp '9' + 1
196   445E 38 02                jr c, .digit
197   4460 C6 07                add a, 'A' - '9' - 1    ; 10-15 become A-F
198   4462 CD 3B 44     .digit: call putc
199   4465 0C                   inc c
200   4466 C9                   ret
201   4467              boxes:                          ; characters 1 (empty box) and 2 (filled)
202   4467 FE 82 82 82          db %11111110, %10000010, %10000010, %10000010, %10000010, %10000010, %11111110, %00000000
202   446B 82 82 FE 00
203   446F FE FE FE FE          db %11111110, %11111110, %11111110, %11111110, %11111110, %11111110, %11111110, %00000000
203   4473 FE FE FE 00
204   4477                      ASSERT $ <= $8000, the program is longer than the cartridge
205   4477 FF FF FF...          ds $8000 - $, $FF       ; pad the cartridge to 16 KB
206   8000
# file closed: outi.asm
