227   42A2 B7                   or a
228   42A3 C8                   ret z
229   42A4 CD 97 42             call putc
230   42A7 23                   inc hl
231   42A8 0C                   inc c
232   42A9 18 F6                jr puts
233   42AB
234   42AB              ; puthex: A = a byte, as two hexadecimal digits; C moves on by 2.
235   42AB F5           puthex: push af
236   42AC 0F                   rrca
237   42AD 0F                   rrca
238   42AE 0F                   rrca
239   42AF 0F                   rrca                    ; the high four bits first
240   42B0 CD B4 42             call hexdig
241   42B3 F1                   pop af
242   42B4 E6 0F        hexdig: and %00001111
243   42B6 C6 30                add a, '0'
244   42B8 FE 3A                cp '9' + 1
245   42BA 38 02                jr c, .digit
246   42BC C6 07                add a, 'A' - '9' - 1    ; 10-15 become A-F
247   42BE CD 97 42     .digit: call putc
248   42C1 0C                   inc c
249   42C2 C9                   ret
250   42C3              boxes:                          ; characters 1 (empty box) and 2 (filled)
251   42C3 FE 82 82 82          db %11111110, %10000010, %10000010, %10000010, %10000010, %10000010, %11111110, %00000000
251   42C7 82 82 FE 00
252   42CB FE FE FE FE          db %11111110, %11111110, %11111110, %11111110, %11111110, %11111110, %11111110, %00000000
252   42CF FE FE FE 00
253   42D3                      ASSERT $ <= $8000, the program is longer than the cartridge
254   42D3 FF FF FF...          ds $8000 - $, $FF       ; pad the cartridge to 16 KB
255   8000
# file closed: reads.asm
