118   437C 32 33 34 35
119   4380
120   4380              ; at: B = row (0-23), C = column (0-31) -> the VDP's write address is that
121   4380              ;     cell of the name table. Keeps BC, DE. Uses A, HL.
122   4380 D5           at:     push de
123   4381 68                   ld l, b
124   4382 26 00                ld h, 0
125   4384 29                   add hl, hl
126   4385 29                   add hl, hl
127   4386 29                   add hl, hl
128   4387 29                   add hl, hl
129   4388 29                   add hl, hl              ; row x 32
130   4389 59                   ld e, c
131   438A 16 18                ld d, $18
132   438C 19                   add hl, de              ; + $1800 + column
133   438D 7D                   ld a, l
134   438E D3 99                out (VDP_CTRL), a
135   4390 7C                   ld a, h
136   4391 F6 40                or $40
137   4393 D3 99                out (VDP_CTRL), a
138   4395 D1                   pop de
139   4396 C9                   ret
140   4397
141   4397              ; putc: A = character, B = row, C = column. Keeps BC, DE, HL.
142   4397 E5           putc:   push hl
143   4398 F5                   push af
144   4399 CD 80 43             call at
145   439C F1                   pop af
146   439D D3 98                out (VDP_DATA), a
147   439F E1                   pop hl
148   43A0 C9                   ret
149   43A1
150   43A1              ; puts: HL = text ending in 0, B = row, C = column; C moves on.
151   43A1 7E           puts:   ld a, (hl)
152   43A2 B7                   or a
153   43A3 C8                   ret z
154   43A4 CD 97 43             call putc
155   43A7 23                   inc hl
156   43A8 0C                   inc c
157   43A9 18 F6                jr puts
158   43AB
159   43AB              ; puthex: A = a byte, as two hexadecimal digits; C moves on by 2.
160   43AB F5           puthex: push af
161   43AC 0F                   rrca
162   43AD 0F                   rrca
163   43AE 0F                   rrca
164   43AF 0F                   rrca                    ; the high four bits first
165   43B0 CD B4 43             call hexdig
166   43B3 F1                   pop af
167   43B4 E6 0F        hexdig: and %00001111
168   43B6 C6 30                add a, '0'
169   43B8 FE 3A                cp '9' + 1
170   43BA 38 02                jr c, .digit
171   43BC C6 07                add a, 'A' - '9' - 1    ; 10-15 become A-F
172   43BE CD 97 43     .digit: call putc
173   43C1 0C                   inc c
174   43C2 C9                   ret
175   43C3              boxes:                          ; characters 1 (empty box) and 2 (filled)
176   43C3 FE 82 82 82          db %11111110, %10000010, %10000010, %10000010, %10000010, %10000010, %11111110, %00000000
176   43C7 82 82 FE 00
177   43CB FE FE FE FE          db %11111110, %11111110, %11111110, %11111110, %11111110, %11111110, %11111110, %00000000
177   43CF FE FE FE 00
178   43D3                      ASSERT $ <= $8000, the program is longer than the cartridge
179   43D3 FF FF FF...          ds $8000 - $, $FF       ; pad the cartridge to 16 KB
180   8000
