219   53D7
220   53D7              ; at: B = row (0-23), C = column (0-31) -> the VDP's write address is that
221   53D7              ;     cell of the name table. Keeps BC, DE. Uses A, HL.
222   53D7 D5           at:     push de
223   53D8 68                   ld l, b
224   53D9 26 00                ld h, 0
225   53DB 29                   add hl, hl
226   53DC 29                   add hl, hl
227   53DD 29                   add hl, hl
228   53DE 29                   add hl, hl
229   53DF 29                   add hl, hl              ; row x 32
230   53E0 59                   ld e, c
231   53E1 16 18                ld d, $18
232   53E3 19                   add hl, de              ; + $1800 + column
233   53E4 7D                   ld a, l
234   53E5 D3 99                out (VDP_CTRL), a
235   53E7 7C                   ld a, h
236   53E8 F6 40                or $40
237   53EA D3 99                out (VDP_CTRL), a
238   53EC D1                   pop de
239   53ED C9                   ret
240   53EE
241   53EE              ; putc: A = character, B = row, C = column. Keeps BC, DE, HL.
242   53EE E5           putc:   push hl
243   53EF F5                   push af
244   53F0 CD D7 53             call at
245   53F3 F1                   pop af
246   53F4 D3 98                out (VDP_DATA), a
247   53F6 E1                   pop hl
248   53F7 C9                   ret
249   53F8
250   53F8              ; puts: HL = text ending in 0, B = row, C = column; C moves on.
251   53F8 7E           puts:   ld a, (hl)
252   53F9 B7                   or a
253   53FA C8                   ret z
254   53FB CD EE 53             call putc
255   53FE 23                   inc hl
256   53FF 0C                   inc c
257   5400 18 F6                jr puts
258   5402
259   5402              ; puthex: A = a byte, as two hexadecimal digits; C moves on by 2.
260   5402 F5           puthex: push af
261   5403 0F                   rrca
262   5404 0F                   rrca
263   5405 0F                   rrca
264   5406 0F                   rrca                    ; the high four bits first
265   5407 CD 0B 54             call hexdig
266   540A F1                   pop af
267   540B E6 0F        hexdig: and %00001111
268   540D C6 30                add a, '0'
269   540F FE 3A                cp '9' + 1
270   5411 38 02                jr c, .digit
271   5413 C6 07                add a, 'A' - '9' - 1    ; 10-15 become A-F
272   5415 CD EE 53     .digit: call putc
273   5418 0C                   inc c
274   5419 C9                   ret
275   541A              boxes:                          ; characters 1 (empty box) and 2 (filled)
276   541A FE 82 82 82          db %11111110, %10000010, %10000010, %10000010, %10000010, %10000010, %11111110, %00000000
276   541E 82 82 FE 00
277   5422 FE FE FE FE          db %11111110, %11111110, %11111110, %11111110, %11111110, %11111110, %11111110, %00000000
277   5426 FE FE FE 00
278   542A                      ASSERT $ <= $8000, the program is longer than the cartridge
279   542A FF FF FF...          ds $8000 - $, $FF       ; pad the cartridge to 16 KB
280   8000
