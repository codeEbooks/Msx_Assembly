378   4353              ; at: B = row (0-23), C = column (0-31) -> the VDP's write address is that
379   4353              ;     cell of the name table. Keeps BC, DE. Uses A, HL.
380   4353 D5           at:     push de
381   4354 68                   ld l, b
382   4355 26 00                ld h, 0
383   4357 29                   add hl, hl
384   4358 29                   add hl, hl
385   4359 29                   add hl, hl
386   435A 29                   add hl, hl
387   435B 29                   add hl, hl              ; row x 32
388   435C 59                   ld e, c
389   435D 16 18                ld d, $18
390   435F 19                   add hl, de              ; + $1800 + column
391   4360 7D                   ld a, l
392   4361 D3 99                out (VDP_CTRL), a
393   4363 7C                   ld a, h
394   4364 F6 40                or $40
395   4366 D3 99                out (VDP_CTRL), a
396   4368 D1                   pop de
397   4369 C9                   ret
398   436A
399   436A              ; putc: A = character, B = row, C = column. Keeps BC, DE, HL.
400   436A E5           putc:   push hl
401   436B F5                   push af
402   436C CD 53 43             call at
403   436F F1                   pop af
404   4370 D3 98                out (VDP_DATA), a
405   4372 E1                   pop hl
406   4373 C9                   ret
407   4374
408   4374              ; puts: HL = text ending in 0, B = row, C = column; C moves on.
409   4374 7E           puts:   ld a, (hl)
410   4375 B7                   or a
411   4376 C8                   ret z
412   4377 CD 6A 43             call putc
413   437A 23                   inc hl
414   437B 0C                   inc c
415   437C 18 F6                jr puts
416   437E
417   437E              ; puthex: A = a byte, as two hexadecimal digits; C moves on by 2.
418   437E F5           puthex: push af
419   437F 0F                   rrca
420   4380 0F                   rrca
421   4381 0F                   rrca
422   4382 0F                   rrca                    ; the high four bits first
423   4383 CD 87 43             call hexdig
424   4386 F1                   pop af
425   4387 E6 0F        hexdig: and %00001111
426   4389 C6 30                add a, '0'
427   438B FE 3A                cp '9' + 1
428   438D 38 02                jr c, .digit
429   438F C6 07                add a, 'A' - '9' - 1    ; 10-15 become A-F
430   4391 CD 6A 43     .digit: call putc
431   4394 0C                   inc c
432   4395 C9                   ret
433   4396              boxes:                          ; characters 1 (empty box) and 2 (filled)
434   4396 FE 82 82 82          db %11111110, %10000010, %10000010, %10000010, %10000010, %10000010, %11111110, %00000000
434   439A 82 82 FE 00
435   439E FE FE FE FE          db %11111110, %11111110, %11111110, %11111110, %11111110, %11111110, %11111110, %00000000
435   43A2 FE FE FE 00
436   43A6                      ASSERT $ <= $8000, the program is longer than the cartridge
437   43A6 FF FF FF...          ds $8000 - $, $FF       ; pad the cartridge to 16 KB
438   8000
