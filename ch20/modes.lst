338   4A0E D3 99                out (VDP_CTRL), a
339   4A10 7C                   ld a, h
340   4A11 F6 40                or $40
341   4A13 D3 99                out (VDP_CTRL), a
342   4A15 D1                   pop de
343   4A16 C9                   ret
344   4A17
345   4A17              ; putc: A = character, B = row, C = column. Keeps BC, DE, HL.
346   4A17 E5           putc:   push hl
347   4A18 F5                   push af
348   4A19 CD 00 4A             call at
349   4A1C F1                   pop af
350   4A1D D3 98                out (VDP_DATA), a
351   4A1F E1                   pop hl
352   4A20 C9                   ret
353   4A21
354   4A21              ; puts: HL = text ending in 0, B = row, C = column; C moves on.
355   4A21 7E           puts:   ld a, (hl)
356   4A22 B7                   or a
357   4A23 C8                   ret z
358   4A24 CD 17 4A             call putc
359   4A27 23                   inc hl
360   4A28 0C                   inc c
361   4A29 18 F6                jr puts
362   4A2B
363   4A2B              ; puthex: A = a byte, as two hexadecimal digits; C moves on by 2.
364   4A2B F5           puthex: push af
365   4A2C 0F                   rrca
366   4A2D 0F                   rrca
367   4A2E 0F                   rrca
368   4A2F 0F                   rrca                    ; the high four bits first
369   4A30 CD 34 4A             call hexdig
370   4A33 F1                   pop af
371   4A34 E6 0F        hexdig: and %00001111
372   4A36 C6 30                add a, '0'
373   4A38 FE 3A                cp '9' + 1
374   4A3A 38 02                jr c, .digit
375   4A3C C6 07                add a, 'A' - '9' - 1    ; 10-15 become A-F
376   4A3E CD 17 4A     .digit: call putc
377   4A41 0C                   inc c
378   4A42 C9                   ret
379   4A43              boxes:                          ; characters 1 (empty box) and 2 (filled)
380   4A43 FE 82 82 82          db %11111110, %10000010, %10000010, %10000010, %10000010, %10000010, %11111110, %00000000
380   4A47 82 82 FE 00
381   4A4B FE FE FE FE          db %11111110, %11111110, %11111110, %11111110, %11111110, %11111110, %11111110, %00000000
381   4A4F FE FE FE 00
382   4A53                      ASSERT $ <= $8000, the program is longer than the cartridge
383   4A53 FF FF FF...          ds $8000 - $, $FF       ; pad the cartridge to 16 KB
384   8000
