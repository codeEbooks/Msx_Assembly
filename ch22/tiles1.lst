  9   4010              ; A picture of 8 tiles, 8 x 8 each with a colour for every line, and a
 10   4010              ; map of 768 names. The tiles are written once, at $0000 and $2000: R#3 = $9F
 11   4010              ; and R#4 = $00 make the three thirds take their shapes and colours from there.
 12   4010 F3           init:   di
 13   4011 31 80 F3             ld sp, SYS_AREA
 14   4014                      VDP_REG 1, $80          ; display off
 14   4014 3E 80       >        ld a, $80
 14   4016 D3 99       >        out (VDP_CTRL), a
