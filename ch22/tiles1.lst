 16   4024 3E 06       >        ld a, $06
 16   4026 D3 99       >        out (VDP_CTRL), a
 16   4028 3E 82       >        ld a, $80 | (2)
 16   402A D3 99       >        out (VDP_CTRL), a
 17   402C                      VDP_REG 3, $9F          ; colours  $2000, one set for three thirds
 17   402C 3E 9F       >        ld a, $9F
 17   402E D3 99       >        out (VDP_CTRL), a
 17   4030 3E 83       >        ld a, $80 | (3)
 17   4032 D3 99       >        out (VDP_CTRL), a
 18   4034                      VDP_REG 4, $00          ; patterns $0000, one set for three thirds
 18   4034 3E 00       >        ld a, $00
 18   4036 D3 99       >        out (VDP_CTRL), a
 18   4038 3E 84       >        ld a, $80 | (4)
