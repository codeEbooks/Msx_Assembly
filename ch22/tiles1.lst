 14   401A D3 99       >        out (VDP_CTRL), a
 15   401C                      VDP_REG 0, $02          ; Graphic II
 15   401C 3E 02       >        ld a, $02
 15   401E D3 99       >        out (VDP_CTRL), a
 15   4020 3E 80       >        ld a, $80 | (0)
 15   4022 D3 99       >        out (VDP_CTRL), a
