 4    0000                      OUTPUT "cart8.rom"
 5    0000                      ORG $4000
 6    4000                      CART_HEADER init
 6    4000 41 42       >        db "AB"
 6    4002 10 40       >        dw init
 6    4004 00 00 00 00 >        dw 0, 0, 0
 6    4008 00 00       >
 6    400A 00 00 00... >        ds 6, 0
 7    4010              VARS    EQU RAM_START + $100    ; the program's variables: the code is in ROM
 8    4010              ; A cartridge of 8 KB, the size of many early MSX games: the same header,
 9    4010              ; and the padding stops at $6000.
10    4010 F3           init:   di
11    4011 31 80 F3             ld sp, SYS_AREA
12    4014                      VDP_REG 7, LIGHT_GREEN  ; the border light green: it runs
12    4014 3E 03       >        ld a, LIGHT_GREEN
12    4016 D3 99       >        out (VDP_CTRL), a
12    4018 3E 87       >        ld a, $80 | (7)
12    401A D3 99       >        out (VDP_CTRL), a
13    401C 18 FE        stop:   jr stop
14    401E                      ASSERT $ <= $6000, the program is longer than 8 KB
15    401E FF FF FF...          ds $6000 - $, $FF       ; pad the cartridge to 8 KB
