 4    0000                      OUTPUT "cart32.rom"
 5    0000                      ORG $4000
 6    4000                      CART_HEADER init
 6    4000 41 42       >        db "AB"
 6    4002 10 40       >        dw init
 6    4004 00 00 00 00 >        dw 0, 0, 0
 6    4008 00 00       >
 6    400A 00 00 00... >        ds 6, 0
 7    4010              VARS    EQU RAM_START + $100    ; the program's variables: the code is in ROM
 8    4010              RESULTS EQU RAM_START          ; what the program found: the debugger reads it here
 9    4010              ; A cartridge of 32 KB: the second 16 KB is for page 2, $8000-$BFFF. At
10    4010              ; INIT the BIOS has switched page 1 to the cartridge, and only page 1
11    4010              ; (chapter 3): the program reads the first byte of its second half.
12    4010 F3           init:   di
13    4011 31 80 F3             ld sp, SYS_AREA
14    4014 3A 00 80             ld a, (second)          ; the first byte of the second half ...
15    4017 32 00 C0             ld (RESULTS), a         ; ... as the processor finds it
16    401A                      VDP_REG 7, LIGHT_GREEN
16    401A 3E 03       >        ld a, LIGHT_GREEN
16    401C D3 99       >        out (VDP_CTRL), a
16    401E 3E 87       >        ld a, $80 | (7)
16    4020 D3 99       >        out (VDP_CTRL), a
17    4022 18 FE        stop:   jr stop
